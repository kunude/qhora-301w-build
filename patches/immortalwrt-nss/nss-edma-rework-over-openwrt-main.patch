+ 
+ 	ATH11K_SKB_CB(skb)->paddr = paddr;
+ 
++	if (ieee80211_is_qos_nullfunc(hdr->frame_control)) {
++		ret = ath11k_wmi_qos_null_send(ar, arvif->vdev_id, buf_id, skb);
++		if (ret) {
++			ath11k_warn(ar->ab, "failed to send qos null frame over wmi: %d\n", ret);
++			goto err_unmap_buf;
++		}
++
++		return 0;
++	}
++
+ 	peer_in_unassoc_pool = ath11k_cfr_peer_is_in_cfr_unassoc_pool(ar, hdr->addr1);
+ 
+ 	if (ar->cfr_enabled &&
+@@ -6532,8 +6542,8 @@ static void ath11k_mgmt_over_wmi_tx_work(struct work_struct *work)
+ 	}
+ }
+ 
+-static int ath11k_mac_mgmt_tx(struct ath11k *ar, struct sk_buff *skb,
+-			      bool is_prb_rsp)
++static int ath11k_mac_tx_over_wmi(struct ath11k *ar, struct sk_buff *skb,
++				  bool is_prb_rsp)
+ {
+ 	struct sk_buff_head *q = &ar->wmi_mgmt_tx_queue;
+ 
+@@ -6595,7 +6605,7 @@ static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
+ 	} else if (ieee80211_is_mgmt(hdr->frame_control)) {
+ 		frm_type = FIELD_GET(IEEE80211_FCTL_STYPE, hdr->frame_control);
+ 		is_prb_rsp = ieee80211_is_probe_resp(hdr->frame_control);
+-		ret = ath11k_mac_mgmt_tx(ar, skb, is_prb_rsp);
