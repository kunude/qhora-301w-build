++			}
++		} else if (ast_entry->action == ATH11K_WDS_WMI_UPDATE) {
++				if (!peer) {
++					continue;
++				}
++				spin_unlock_bh(&ab->base_lock);
++				ret = ath11k_wmi_send_add_update_wds_entry_cmd(ar, peer_addr,
++									       ast_entry->addr,
