+ 					HTT_T2H_PEER_MAP_INFO1_MAC_ADDR_H16
+-#define HTT_T2H_PEER_MAP_INFO1_NEXT_HOP_M HTT_T2H_PEER_MAP_INFO2_NEXT_HOP_M
