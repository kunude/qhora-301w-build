+ 	struct ath11k_ast_entry *ast_entry = NULL;
+@@ -623,19 +628,22 @@ static void ath11k_nss_wds_type_rx(struct ath11k *ar, u8* src_mac, u8 is_sa_vali
+ 		if (!is_sa_valid) {
