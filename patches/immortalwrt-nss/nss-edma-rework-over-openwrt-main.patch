+ 				irq_grp->irqs[num_irq++] = wbm2host_rx_release;
+ 
+ 			if (ab->hw_params.ring_mask->reo_status[i] & BIT(j))
+@@ -584,7 +590,7 @@ static int ath11k_ahb_config_ext_irq(struct ath11k_base *ab)
