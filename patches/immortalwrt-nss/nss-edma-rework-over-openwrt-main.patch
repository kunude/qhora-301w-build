++	case WLAN_CIPHER_SUITE_GCMP_256:
++		return PEER_SEC_TYPE_AES_GCMP_256;
++	default:
++		ath11k_warn(ab, "unknown cipher type %d\n", cipher);
++		return PEER_SEC_TYPE_NONE;
++	}
++}
