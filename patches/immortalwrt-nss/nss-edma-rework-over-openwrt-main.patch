+ 		if (rxcb->is_mcbc)
+ 			enctype = peer->sec_type_grp;
+ 		else
+@@ -2490,6 +2570,8 @@ static void ath11k_dp_rx_h_mpdu(struct ath11k *ar,
+ 	}
