+ 		   FIELD_GET(DP_TX_DESC_ID_MSDU_ID, ti.desc_id));
+@@ -349,6 +420,9 @@ ath11k_dp_tx_htt_tx_complete_buf(struct ath11k_base *ab,
+ 		return;
+ 	}
+ 
