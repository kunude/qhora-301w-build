++	LIST_HEAD(local_entry);
++	nss_wifi_meshmgr_status_t status;
++
++	if (!arvif->nss.mpp_aging) {
++		/* Clean up any stale entries from old events */
++		spin_lock_bh(&ar->nss.dump_lock);
