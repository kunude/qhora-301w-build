++int br_dev_is_vlan_filter_enabled(struct net_device *dev)
++{
++	struct net_bridge_port *p;
++	struct net_bridge_vlan_group *vg = NULL;
++	struct net_device *master = NULL;
++
++	if (!dev) {
++		return -ENODEV;
++	}
++
++	if (netif_is_bridge_master(dev)) {
++		/*
++		 * Its a bridge device
