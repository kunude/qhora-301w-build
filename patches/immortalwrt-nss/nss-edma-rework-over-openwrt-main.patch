+@@ -377,6 +382,20 @@ struct ath11k_mgmt_frame_stats {
+ 	u32 tx_compl_fail[ATH11K_STATS_MGMT_FRM_TYPE_MAX];
+ };
+ 
++/**
++ *struct ath11k_dyn_vlan_cfg - dynamic vlan config state info container.
++ *                             will be used during ieee80211_reconfig
++ *			       nss offload case
