+@@ -238,7 +239,7 @@ int ath11k_nss_add_wds_peer(struct ath11k *ar, struct ath11k_peer *peer,
+ int ath11k_nss_update_wds_peer(struct ath11k *ar, struct ath11k_peer *peer,
