++				if (ret)
++					ath11k_warn(ar->ab, "update wds_entry_cmd failed %d for %pM on peer %pM\n",
++						    ret, ast_entry->addr, peer_addr);
++		}
++		spin_lock_bh(&ab->base_lock);
+ 	}
