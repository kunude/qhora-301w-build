+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Runtime integration for Qualcomm NSS offloading on the qca_edma/qca_ppe
+# (EDMA-rework) driver stack.
+
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=nss-tools
+PKG_RELEASE:=1
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/nss-tools
+  SECTION:=net
+  CATEGORY:=Network
+  TITLE:=NSS offload runtime tools (nss-up, nss-status)
+  DEPENDS:=@(TARGET_qualcommax) +kmod-qca-ppe-nss +kmod-qca-nss-drv \
+	+kmod-qca-nss-ecm +kmod-qca-nss-drv-pppoe +kmod-qca-nss-drv-bridge-mgr \
+	+kmod-qca-nss-drv-qdisc +kmod-qca-nss-drv-igs \
+	+sqm-scripts-nss +ethtool +ip-bridge
+  PKGARCH:=all
+endef
+
+define Package/nss-tools/description
+ Brings the opt-in NSS data plane up in the required order at boot (the
+ 'nss' service running /usr/sbin/nss-up: firmware arm, bridge/multicast/
+ ECM/PPPoE managers, Wi-Fi offload flip, SQM), reports its health via
+ /usr/sbin/nss-status (-j for JSON) and captures EDMA/PPE registers with
+ edma-dump (needs a devmem-enabled busybox). nss-wedge-watch dumps the
+ firmware, fabric and MAC state behind a port that has stopped
+ transmitting - '-1' for a one-shot capture on a box that is wedged now,
+ or run it detached to catch the next one; nss-ppe-diff baselines the
+ PPE's configuration registers at bring-up and says which of them stopped
+ holding the value we wrote. Nothing autoloads: disable
+ with "uci set nss.general.enabled='0'" to stay on the plain host stack.
+ Pulls in the complete NSS runtime package set.
+endef
+
+define Package/nssqos
+  SECTION:=net
+  CATEGORY:=Network
+  TITLE:=DSCP marking and NSS fast-lane prioritization
+  DEPENDS:=@(TARGET_qualcommax) +nftables-json
+  PKGARCH:=all
+endef
+
+define Package/nssqos/description
+ Renders /etc/config/nssqos into a standalone nftables table that
+ DSCP-marks matching connections and steers them into the strict-priority
+ fast lane of the NSS SQM script (nss-edma.qos). Marking and steering
+ apply to NSS-accelerated flows in both directions.
+endef
+
+define Package/nssqos/conffiles
+/etc/config/nssqos
+endef
+
+define Package/luci-app-nss
+  SECTION:=luci
+  CATEGORY:=LuCI
+  SUBMENU:=3. Applications
+  TITLE:=LuCI status page for NSS offloading
+  DEPENDS:=+nss-tools +luci-base
+  PKGARCH:=all
+endef
+
+define Package/luci-app-nss/description
+ Status -> NSS Offload: renders 'nss-status -j' (firmware state, cores,
+ ports, ECM acceleration counts, SQM/fast-lane health) in LuCI.
+endef
+
+define Package/luci-app-nssqos
+  SECTION:=luci
+  CATEGORY:=LuCI
+  SUBMENU:=3. Applications
+  TITLE:=LuCI editor for NSS QoS marking rules
+  DEPENDS:=+nssqos +luci-base
+  PKGARCH:=all
+endef
+
+define Package/luci-app-nssqos/description
+ Network -> QoS Marking (NSS): edit the DSCP marking and fast-lane
+ prioritization rules of /etc/config/nssqos.
+endef
+
+define Build/Compile
+endef
+
+define Package/nss-tools/install
+	$(INSTALL_DIR) $(1)/usr/sbin
+	$(INSTALL_BIN) ./files/nss-up $(1)/usr/sbin/nss-up
+	$(INSTALL_BIN) ./files/nss-status $(1)/usr/sbin/nss-status
+	$(INSTALL_BIN) ./files/edma-dump $(1)/usr/sbin/edma-dump
+	$(INSTALL_BIN) ./files/nss-wedge-watch $(1)/usr/sbin/nss-wedge-watch
+	$(INSTALL_BIN) ./files/nss-ppe-diff $(1)/usr/sbin/nss-ppe-diff
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./files/nss.init $(1)/etc/init.d/nss
+	$(INSTALL_DIR) $(1)/lib/nss
+	$(INSTALL_DATA) ./files/functions.sh $(1)/lib/nss/functions.sh
+	$(INSTALL_DIR) $(1)/etc/sysctl.d
+	$(INSTALL_DATA) ./files/nss.sysctl $(1)/etc/sysctl.d/12-nss-networking.conf
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_DATA) ./files/nss-offload.defaults $(1)/etc/uci-defaults/98-nss-offload
+	$(INSTALL_DIR) $(1)/lib/upgrade/keep.d
+	$(INSTALL_DATA) ./files/nss-tools.keep $(1)/lib/upgrade/keep.d/nss-tools
+endef
+
+define Package/nssqos/install
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./files/nssqos.init $(1)/etc/init.d/nssqos
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_CONF) ./files/nssqos.config $(1)/etc/config/nssqos
+	$(INSTALL_DIR) $(1)/usr/sbin
+	$(INSTALL_BIN) ./files/nssqos-conns $(1)/usr/sbin/nssqos-conns
+	$(INSTALL_BIN) ./files/nssqos-resolve $(1)/usr/sbin/nssqos-resolve
+endef
+
+define Package/luci-app-nss/install
+	$(INSTALL_DIR) $(1)/www/luci-static/resources/view/nss
+	$(INSTALL_DATA) ./files/luci-nss-status.js $(1)/www/luci-static/resources/view/nss/status.js
+	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
+	$(INSTALL_DATA) ./files/luci-app-nss.menu.json $(1)/usr/share/luci/menu.d/luci-app-nss.json
+	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
+	$(INSTALL_DATA) ./files/luci-app-nss.acl.json $(1)/usr/share/rpcd/acl.d/luci-app-nss.json
+endef
+
+define Package/luci-app-nssqos/install
+	$(INSTALL_DIR) $(1)/www/luci-static/resources/view/nss
+	$(INSTALL_DATA) ./files/luci-nss-qos.js $(1)/www/luci-static/resources/view/nss/qos.js
+	$(INSTALL_DATA) ./files/luci-nss-connections.js $(1)/www/luci-static/resources/view/nss/connections.js
+	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
+	$(INSTALL_DATA) ./files/luci-app-nssqos.menu.json $(1)/usr/share/luci/menu.d/luci-app-nssqos.json
+	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
+	$(INSTALL_DATA) ./files/luci-app-nssqos.acl.json $(1)/usr/share/rpcd/acl.d/luci-app-nssqos.json
+endef
+
+$(eval $(call BuildPackage,nss-tools))
+$(eval $(call BuildPackage,nssqos))
+$(eval $(call BuildPackage,luci-app-nss))
+$(eval $(call BuildPackage,luci-app-nssqos))
diff --git a/package/nss/nss-tools/files/edma-dump b/package/nss/nss-tools/files/edma-dump
new file mode 100755
index 0000000000000000000000000000000000000000..1ba73cdbffdcb8ac896e4f3a9a76ff76e3eb9425
--- /dev/null
+++ b/package/nss/nss-tools/files/edma-dump
@@ -0,0 +1,157 @@
+#!/bin/sh
+# edma-dump: register-level dump of the IPQ807x EDMA engine (base 0x3ab00000).
+# Shows the global configuration (port/DMA control, interrupt mask/status, the
+# QID2RID queue-to-ring table, the ring cross-maps) and per-ring control +
+# producer/consumer indices for all four ring types. Useful for inspecting how
+# the host driver and the NSS firmware have partitioned the shared EDMA block.
+#
+# Based on the QSDK edma_dump utility, reworked for the IPQ807x register
+# layout of the upstream qca_edma driver. Requires busybox devmem.
+#
+# Usage: edma-dump [general|txdesc|txcmpl|rxdesc|rxfill|full] [ring_num]
+
+BASE=0x3ab00000
+
+# IPQ807x ring geometry (qca_edma ipq807x_data): the host driver owns the
+# highest ring of each type (txdesc 23, txcmpl 7, rxfill 7, rxdesc 15); the
+# NSS firmware uses the lower rings once it is booted.
+TXDESC_NUM=24
+TXCMPL_NUM=8
+RXFILL_NUM=8
+RXDESC_NUM=16
+TXCMPL_BASE=0x19000
+TX_INT_BASE=0x21000
+RXFILL_BASE=0x29000
+RXFILL_INT_BASE=0x31000
+RXDESC_BASE=0x39000
+RXDESC_INT_BASE=0x49000
+QID2RID_BASE=0x5a000
+
+command -v devmem >/dev/null 2>&1 || {
+	echo "edma-dump: busybox devmem not available" >&2
+	exit 1
+}
+
+# Every offset above is the IPQ807x EDMA layout. On another SoC in the family
+# the ring counts and block bases differ, so the same reads land on unrelated
+# registers and print plausible-looking rubbish - worse than refusing, because
+# the output is what someone diagnoses a wedge from. Check the SoC and stop.
+if ! tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | grep -q '^qcom,ipq807'; then
+	echo "edma-dump: this register map is IPQ807x-only; refusing to dump on $(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null)" >&2
+	exit 1
+fi
+
+# reg NAME OFFSET - print one register as "NAME 0xADDR : VALUE"
+reg() {
+	addr=$((BASE + $2))
+	printf '%-28s 0x%08x : %s\n' "$1" "$addr" "$(devmem "$addr")"
+}
+
+# host-ring marker for the labels
+host() {
+	[ "$1" = "$2" ] && echo " (host)" || echo ""
+}
+
+general_dump() {
+	echo "---- EDMA general registers ----"
+	reg MAS_CTRL 0x0
+	reg PORT_CTRL 0x4
+	reg TXDESC2CMPL_MAP_0 0x0c
+	reg TXDESC2CMPL_MAP_1 0x10
+	reg TXDESC2CMPL_MAP_2 0x14
+	reg RXDESC2FILL_MAP_0 0x18
+	reg RXDESC2FILL_MAP_1 0x1c
+	reg DMAR_CTRL 0x48
+	reg AXIW_CTRL 0x50
+	reg MISC_INT_STAT 0x5c
+	reg MISC_INT_MASK 0x60
+	echo "---- QID2RID table (queue -> RX ring) ----"
+	q=0
+	while [ $q -lt 64 ]; do
+		reg "QID2RID[$q]" $((QID2RID_BASE + 4 * q))
+		q=$((q + 1))
+	done
+}
+
+txdesc_dump() {
+	n=$1
+	echo "---- TXDESC ring $n$(host "$n" 23) ----"
+	reg "TXDESC_BA[$n]" $((0x1000 + 0x1000 * n))
+	reg "TXDESC_PROD_IDX[$n]" $((0x1004 + 0x1000 * n))
+	reg "TXDESC_CONS_IDX[$n]" $((0x1008 + 0x1000 * n))
+	reg "TXDESC_RING_SIZE[$n]" $((0x100c + 0x1000 * n))
+	reg "TXDESC_CTRL[$n]" $((0x1010 + 0x1000 * n))
+}
+
+txcmpl_dump() {
+	n=$1
+	echo "---- TXCMPL ring $n$(host "$n" 7) ----"
+	reg "TXCMPL_BA[$n]" $((TXCMPL_BASE + 0x1000 * n))
+	reg "TXCMPL_PROD_IDX[$n]" $((TXCMPL_BASE + 0x004 + 0x1000 * n))
+	reg "TXCMPL_CONS_IDX[$n]" $((TXCMPL_BASE + 0x008 + 0x1000 * n))
+	reg "TXCMPL_RING_SIZE[$n]" $((TXCMPL_BASE + 0x00c + 0x1000 * n))
+	reg "TXCMPL_CTRL[$n]" $((TXCMPL_BASE + 0x014 + 0x1000 * n))
+	reg "TX_INT_STAT[$n]" $((TX_INT_BASE + 0x1000 * n))
+	reg "TX_INT_MASK[$n]" $((TX_INT_BASE + 0x004 + 0x1000 * n))
+}
+
+rxfill_dump() {
+	n=$1
+	echo "---- RXFILL ring $n$(host "$n" 7) ----"
+	reg "RXFILL_BA[$n]" $((RXFILL_BASE + 0x1000 * n))
+	reg "RXFILL_PROD_IDX[$n]" $((RXFILL_BASE + 0x004 + 0x1000 * n))
+	reg "RXFILL_CONS_IDX[$n]" $((RXFILL_BASE + 0x008 + 0x1000 * n))
+	reg "RXFILL_RING_SIZE[$n]" $((RXFILL_BASE + 0x00c + 0x1000 * n))
+	reg "RXFILL_RING_EN[$n]" $((RXFILL_BASE + 0x01c + 0x1000 * n))
+	reg "RXFILL_INT_STAT[$n]" $((RXFILL_INT_BASE + 0x1000 * n))
+	reg "RXFILL_INT_MASK[$n]" $((RXFILL_INT_BASE + 0x004 + 0x1000 * n))
+}
+
+rxdesc_dump() {
+	n=$1
+	echo "---- RXDESC ring $n$(host "$n" 15) ----"
+	reg "RXDESC_BA[$n]" $((RXDESC_BASE + 0x1000 * n))
+	reg "RXDESC_PROD_IDX[$n]" $((RXDESC_BASE + 0x004 + 0x1000 * n))
+	reg "RXDESC_CONS_IDX[$n]" $((RXDESC_BASE + 0x008 + 0x1000 * n))
+	reg "RXDESC_RING_SIZE[$n]" $((RXDESC_BASE + 0x00c + 0x1000 * n))
+	reg "RXDESC_CTRL[$n]" $((RXDESC_BASE + 0x018 + 0x1000 * n))
+	reg "RXDESC_INT_STAT[$n]" $((RXDESC_INT_BASE + 0x1000 * n))
+	reg "RXDESC_INT_MASK[$n]" $((RXDESC_INT_BASE + 0x004 + 0x1000 * n))
+}
+
+# ring_loop DUMP_FN NUM_RINGS [ring_num]
+ring_loop() {
+	if [ -n "$3" ]; then
+		[ "$3" -ge 0 ] 2>/dev/null && [ "$3" -lt "$2" ] || {
+			echo "edma-dump: ring number out of range (0..$(($2 - 1)))" >&2
+			exit 1
+		}
+		"$1" "$3"
+		return
+	fi
+	i=0
+	while [ $i -lt "$2" ]; do
+		"$1" $i
+		i=$((i + 1))
+	done
+}
+
+cmd=${1:-full}
+case "$cmd" in
+	general) general_dump ;;
+	txdesc)  ring_loop txdesc_dump $TXDESC_NUM "$2" ;;
+	txcmpl)  ring_loop txcmpl_dump $TXCMPL_NUM "$2" ;;
+	rxfill)  ring_loop rxfill_dump $RXFILL_NUM "$2" ;;
+	rxdesc)  ring_loop rxdesc_dump $RXDESC_NUM "$2" ;;
+	full)
+		general_dump
+		ring_loop txdesc_dump $TXDESC_NUM
+		ring_loop txcmpl_dump $TXCMPL_NUM
+		ring_loop rxfill_dump $RXFILL_NUM
+		ring_loop rxdesc_dump $RXDESC_NUM
+		;;
+	*)
+		echo "Usage: edma-dump [general|txdesc|txcmpl|rxdesc|rxfill|full] [ring_num]" >&2
+		exit 1
+		;;
+esac
diff --git a/package/nss/nss-tools/files/functions.sh b/package/nss/nss-tools/files/functions.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fa601c153b077217bfc0354fb409fb6458208348
--- /dev/null
+++ b/package/nss/nss-tools/files/functions.sh
@@ -0,0 +1,58 @@
+# Shared helpers for the NSS runtime scripts (nss-up, nss-status).
+#
+# The nss_* helpers return their results by setting NSS_* variables the
+# caller reads, so they are never used in this file.
+# shellcheck disable=SC2034
+
+# Firmware blob and version string. qca-nss0.bin is a symlink the firmware
+# hotplug creates on the first arm; on a freshly flashed image it does not
+# exist yet - fall back to the packaged retail blob name. Matches both
+# version-string shapes: NSS.FW.12.5-210-HK.R (12.x line) and
+# NSS.HK.11.4.0.5-6-R (11.4 line, the mesh-capable firmware).
+nss_fw_version() {
+	local blob=/lib/firmware/qca-nss0.bin
+	[ -e "$blob" ] || blob=/lib/firmware/qca-nss0-retail.bin
+	grep -aom1 'NSS\.[A-Z][A-Z]*\.[0-9][0-9A-Za-z.-]*' "$blob" 2>/dev/null
+}
+
+# 802.11s mesh state. Sets NSS_MESH_CFG=1 when any wireless vif is
+# configured in mesh mode, and NSS_MESH_CAPABLE=1 when the firmware line
+# supports mesh interfaces (11.4 only - every newer firmware rejects the
+# mesh dynamic-interface allocation) AND the image was built with the mesh
+# offload (the Wi-Fi mesh manager module is present).
+nss_mesh_state() {
+	NSS_MESH_CFG=0
+	uci -q show wireless | grep -q "\.mode='mesh'" && NSS_MESH_CFG=1
+	NSS_MESH_CAPABLE=0
+	case "$(nss_fw_version)" in
+	*.11.4.*) [ -e "/lib/modules/$(uname -r)/qca-nss-wifi-meshmgr.ko" ] && NSS_MESH_CAPABLE=1 ;;
+	esac
+}
+
+# poll_until <seconds> <command...>: run the command once per second until
+# it succeeds or the timeout elapses; returns the last status.
+poll_until() {
+	local _n=$1 _i=0
+	shift
+	while ! "$@"; do
+		_i=$((_i + 1))
+		[ "$_i" -lt "$_n" ] || return 1
+		sleep 1
+	done
+	return 0
+}
+
+# The SQM queue section the NSS shaper serves. Resolved by TYPE, not by
+# name (the section name is user-chosen): first enabled queue section,
+# else the first one. Sets NSS_SQM_SEC (section) and NSS_SQM_DEV (the
+# shaped netdev, from the section's 'interface' option).
+nss_sqm_section() {
+	local s
+	NSS_SQM_SEC=""
+	NSS_SQM_DEV=""
+	for s in $(uci -q show sqm | sed -n "s/^sqm\.\([^.=]*\)=queue$/\1/p"); do
+		[ -n "$NSS_SQM_SEC" ] || NSS_SQM_SEC=$s
+		[ "$(uci -q get "sqm.$s.enabled")" = "1" ] && { NSS_SQM_SEC=$s; break; }
+	done
+	[ -n "$NSS_SQM_SEC" ] && NSS_SQM_DEV=$(uci -q get "sqm.${NSS_SQM_SEC}.interface")
+}
