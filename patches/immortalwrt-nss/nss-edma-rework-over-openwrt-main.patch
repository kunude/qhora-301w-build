+		rcu_read_lock();
+		rd = rcu_dereference(priv->dp_owner[tag_info->port]);
+		if (rd) {
+			if (unlikely(!READ_ONCE(priv->dp_injectable[tag_info->port]))) {
+				rcu_read_unlock();
