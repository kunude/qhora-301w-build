++	u32 rx_intra_bss_fail;
++	u32 rx_mic_err;
++	u32 rx_decrypt_err;
+ };
+ 
+ enum ath11k_nss_peer_sec_type {
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-926-ath11k-skip-mon-status-reap-until-ring-initialized.patch b/package/kernel/mac80211/patches/nss/ath11k/999-926-ath11k-skip-mon-status-reap-until-ring-initialized.patch
new file mode 100644
index 0000000000000000000000000000000000000000..29e0bf58d38d95f7db581d23ad27e2a9f47ce46a
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-926-ath11k-skip-mon-status-reap-until-ring-initialized.patch
@@ -0,0 +1,55 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: skip monitor status reap until the ring is initialized
+
+During firmware recovery the extended interrupt groups are re-enabled
+before the monitor status refill ring has been set up again. Servicing
+the ring in that window passes an uninitialized srng to
+ath11k_hal_srng_access_begin() and panics in interrupt context -
+observed deterministically on IPQ8074 with NSS offload: every firmware
+fatal (hif_ce.c assertion -> Q6 SSR) turned into a host kernel panic
+about one second into the recovery, from the napi thread:
+
+  ath11k_hal_srng_access_begin+0xc
+  ath11k_dp_rx_process_mon_status+0x15c
+  ath11k_dp_service_srng+0xb8
+  ath11k_ahb_ext_grp_napi_poll+0x34
+
+Because the panic fires in the recovery path, it converts every
+recoverable firmware crash into a reboot.
+
+The monitor status refill ring is a source ring - the reap walks it with
+ath11k_hal_srng_src_peek() - so ath11k_hal_srng_access_begin() reads
+srng->u.src_ring.tp_addr, and that is the pointer that is NULL here.
+Test it directly rather than srng->initialized: ath11k_hal_srng_setup()
+sets ->initialized before ->tp_addr and without a barrier, so an
+->initialized check can still be true while tp_addr is NULL and would
+race the very ring rebuild it is meant to exclude. Same reasoning, and
+the same predicate, as the CE guard in 999-929.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/dp_rx.c b/drivers/net/wireless/ath/ath11k/dp_rx.c
+index 9e05860..ab1e5a0 100644
+--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
+@@ -3811,6 +3811,20 @@ static int ath11k_dp_rx_reap_mon_status_ring(struct ath11k_base *ab, int mac_id,
+ 
+ 	srng = &ab->hal.srng_list[rx_ring->refill_buf_ring.ring_id];
+ 
++	/*
++	 * During firmware recovery the extended interrupt groups are
++	 * re-enabled before the monitor status ring is set up again;
++	 * servicing it in that window dereferences an uninitialized srng
++	 * and panics in interrupt context. This is a source ring, so
++	 * ath11k_hal_srng_access_begin() reads u.src_ring.tp_addr - test
++	 * that pointer rather than ->initialized, because
++	 * ath11k_hal_srng_setup() sets ->initialized before ->tp_addr
++	 * without a barrier, leaving an ->initialized check racing the
++	 * ring rebuild it is meant to exclude.
++	 */
++	if (!srng->u.src_ring.tp_addr)
++		return 0;
++
+ 	spin_lock_bh(&srng->lock);
+ 
+ 	ath11k_hal_srng_access_begin(ab, srng);
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-927-ath11k-keep-ce-access-off-the-q6-while-it-is-down.patch b/package/kernel/mac80211/patches/nss/ath11k/999-927-ath11k-keep-ce-access-off-the-q6-while-it-is-down.patch
new file mode 100644
index 0000000000000000000000000000000000000000..f3dd3a062bbcaebc4fde3c341ee8eaa3ca3c423d
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-927-ath11k-keep-ce-access-off-the-q6-while-it-is-down.patch
@@ -0,0 +1,64 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: keep copy engine access off the Q6 while it is down
+
+On the AHB bus (IPQ8074) the WLAN copy engine register space is only
+accessible while the Q6 subsystem is powered; a read while TrustZone is
+tearing the subsystem down or bringing it back up raises a synchronous
+external abort in interrupt context and takes the whole SoC down.
+Observed on IPQ8074 during firmware recovery:
+
+  ath11k_ahb_ce_interrupt_handler
+    ath11k_ahb_ce_irq_disable        <- CE register read
+  (__scm_smc_call for the wcss stop concurrent on another CPU)
+
+When the firmware crashes, the remoteproc core stops the Q6 on its own
+schedule, tens of milliseconds after the fatal-error IRQ and while the
+just-crashed firmware's final burst of CE interrupts is still being
+serviced - the driver gets no say in that ordering. Gate the CE
+interrupt handler and tasklet on the remoteproc state: it is moved off
+RPROC_RUNNING before the TrustZone teardown starts and moved back only
+after the subsystem is powered up again. The CE interrupts are edge
+triggered, so a skipped event cannot storm, and the recovery path
+reprograms the rings from scratch anyway.
+
+The other path into that window, ath11k_core_reset() calling
+ath11k_hif_ce_irq_disable() on AHB hif ops that never implemented the
+pair, is fixed by the stock 950-wifi-ath11k-implement-CE-interrupt-
+enable-disable-for-AHB.patch.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+Link: https://lore.kernel.org/ath11k/20260725141757.1316877-1-julius@bairaktaris.de/
+
+diff --git a/drivers/net/wireless/ath/ath11k/ahb.c b/drivers/net/wireless/ath/ath11k/ahb.c
+index 2738f66..9972ed8 100644
+--- a/drivers/net/wireless/ath/ath11k/ahb.c
++++ b/drivers/net/wireless/ath/ath11k/ahb.c
+@@ -483,6 +483,10 @@ static void ath11k_ahb_free_irq(struct ath11k_base *ab)
+ static void ath11k_ahb_ce_tasklet(struct tasklet_struct *t)
+ {
+ 	struct ath11k_ce_pipe *ce_pipe = from_tasklet(ce_pipe, t, intr_tq);
++	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ce_pipe->ab);
++
++	if (ab_ahb->tgt_rproc->state != RPROC_RUNNING)
++		return;
+ 
+ 	ath11k_ce_per_engine_service(ce_pipe->ab, ce_pipe->pipe_num);
+ 
+@@ -492,6 +496,16 @@ static void ath11k_ahb_ce_tasklet(struct tasklet_struct *t)
+ static irqreturn_t ath11k_ahb_ce_interrupt_handler(int irq, void *arg)
+ {
+ 	struct ath11k_ce_pipe *ce_pipe = arg;
++	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ce_pipe->ab);
++
++	/*
++	 * While the Q6 is stopped or booting, the WLAN CE register space
++	 * is not accessible; a read raises a synchronous external abort.
++	 * The remoteproc core marks the state before it starts the
++	 * TrustZone teardown, so skip the (edge triggered) interrupt.
++	 */
++	if (ab_ahb->tgt_rproc->state != RPROC_RUNNING)
++		return IRQ_HANDLED;
+ 
+ 	/* last interrupt received for this CE */
+ 	ce_pipe->timestamp = jiffies;
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-929-ath11k-guard-ce-send-and-reap-against-cleared-srng.patch b/package/kernel/mac80211/patches/nss/ath11k/999-929-ath11k-guard-ce-send-and-reap-against-cleared-srng.patch
new file mode 100644
index 0000000000000000000000000000000000000000..04d8e3102ef56982892c3395745cdd16ba92bf69
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-929-ath11k-guard-ce-send-and-reap-against-cleared-srng.patch
@@ -0,0 +1,80 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] wifi: ath11k: guard CE send and reap against a cleared srng
+
+During firmware-crash recovery ath11k_core_reconfigure_on_crash() calls
+ath11k_hal_srng_clear() (memsetting srng_list, so src_ring.tp_addr becomes
+NULL) and then clears ATH11K_FLAG_CRASH_FLUSH before
+ath11k_core_qmi_firmware_ready() rebuilds the copy-engine srng in
+ath11k_ce_init_pipes(). For the whole firmware boot the CRASH_FLUSH gate in
+ath11k_ce_send() is already open while the CE srng is still zeroed.
+
+A hostapd beacon update (nl80211_set_beacon -> ath11k_wmi_bcn_tmpl ->
+ath11k_wmi_cmd_send -> ath11k_htc_send -> ath11k_ce_send) racing into that
+window passes the CRASH_FLUSH check and dereferences the NULL
+srng->u.src_ring.tp_addr in ath11k_hal_srng_access_begin(), a "Fatal
+exception in interrupt".
+
+Reject the send while that pointer is NULL. Testing tp_addr directly (rather
+than srng->initialized) also closes the rebuild ordering window:
+ath11k_hal_srng_setup() sets ->initialized before ->tp_addr without a
+barrier, so an ->initialized check could still race the CE ring rebuild.
+
+The send-completion reap has the same exposure: when a firmware assert
+storms the target and recovery fails to rebuild the copy-engine rings,
+ath11k_ce_cleanup_pipes() -> ath11k_ce_poll_send_completed() ->
+ath11k_ce_completed_send_next() runs on a CE source srng that
+hal_srng_clear() zeroed, and ath11k_hal_srng_access_begin() dereferences the
+NULL tp_addr:
+
+  Unable to handle kernel read from unreadable memory at virtual address 0
+  pc : ath11k_hal_srng_access_begin+0xc [ath11k]
+   ath11k_ce_cleanup_pipes
+
+Bail out of the reap when the srng has not been rebuilt, mirroring the
+existing empty-ring handling.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/ce.c b/drivers/net/wireless/ath/ath11k/ce.c
+index c56dd8a..cd9c1ca 100644
+--- a/drivers/net/wireless/ath/ath11k/ce.c
++++ b/drivers/net/wireless/ath/ath11k/ce.c
+@@ -472,6 +472,17 @@ static struct sk_buff *ath11k_ce_completed_send_next(struct ath11k_ce_pipe *pipe
+ 
+ 	spin_lock_bh(&srng->lock);
+ 
++	/*
++	 * During a firmware crash storm ath11k_ce_cleanup_pipes() can call
++	 * this on a CE srng that hal_srng_clear() zeroed and that recovery
++	 * has not rebuilt; ath11k_hal_srng_access_begin() would deref a NULL
++	 * tp_addr. Bail as for an empty ring.
++	 */
++	if (unlikely(!srng->u.src_ring.tp_addr)) {
++		skb = ERR_PTR(-EIO);
++		goto err_unlock;
++	}
++
+ 	ath11k_hal_srng_access_begin(ab, srng);
+ 
+ 	desc = ath11k_hal_srng_src_reap_next(ab, srng);
+@@ -750,6 +761,20 @@ int ath11k_ce_send(struct ath11k_base *ab, struct sk_buff *skb, u8 pipe_id,
+ 
+ 	srng = &ab->hal.srng_list[pipe->src_ring->hal_ring_id];
+ 
++	/*
++	 * During firmware-crash recovery ath11k_hal_srng_clear() memsets the
++	 * srng_list and ATH11K_FLAG_CRASH_FLUSH is cleared before the copy-engine
++	 * srng is rebuilt in ath11k_core_qmi_firmware_ready().  A send racing into
++	 * that window would dereference the NULL src_ring.tp_addr in
++	 * ath11k_hal_srng_access_begin().  Test that exact field: ath11k_hal_srng_setup()
++	 * sets ->initialized before ->tp_addr (unbarriered), so an ->initialized check
++	 * would still race the rebuild.  Bail until the ring pointer is valid.
++	 */
++	if (unlikely(!srng->u.src_ring.tp_addr)) {
++		spin_unlock_bh(&ab->ce.ce_lock);
++		return -ESHUTDOWN;
++	}
++
+ 	spin_lock_bh(&srng->lock);
+ 
+ 	ath11k_hal_srng_access_begin(ab, srng);
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-930-ath11k-drop-data-tx-during-crash-recovery.patch b/package/kernel/mac80211/patches/nss/ath11k/999-930-ath11k-drop-data-tx-during-crash-recovery.patch
new file mode 100644
index 0000000000000000000000000000000000000000..1a40b7dcad8d5b4cb8d5f0df2e81a5fd40d642e6
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-930-ath11k-drop-data-tx-during-crash-recovery.patch
@@ -0,0 +1,42 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] wifi: ath11k: drop data TX during firmware crash recovery
+
+ath11k_core_reconfigure_on_crash() calls ath11k_dp_free() to release the DP
+(tx_ring/idr_pool and the TCL srng) while ATH11K_FLAG_CRASH_FLUSH is set.
+ieee80211_stop_queues() does not fully quiesce data TX, so a frame can still
+reach ath11k_dp_tx() in that window and dereferences the freed
+tx_ring->idr_pool, crashing with a NULL write:
+
+  Unable to handle kernel write to read-only memory at virtual address 0
+  pc : ath11k_dp_tx+0x1c8/0xb0c [ath11k]
+   ath11k_dp_tx
+   ath11k_mac_op_tx
+   __sys_sendto
+
+Guard the TX path against the crash-flush window, mirroring the guard
+ath11k_ce_send() already has for the WMI path.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/dp_tx.c b/drivers/net/wireless/ath/ath11k/dp_tx.c
+index cdc4853..03ce89b 100644
+--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
+@@ -142,6 +142,17 @@ int ath11k_dp_tx(struct ath11k *ar, struct ath11k_vif *arvif,
+ 		     !ieee80211_is_data(hdr->frame_control)))
+ 		return -EOPNOTSUPP;
+ 
++	/*
++	 * During firmware crash recovery ath11k_core_reconfigure_on_crash() calls
++	 * ath11k_dp_free(), releasing the DP tx_ring/idr_pool and the TCL srng, while
++	 * ATH11K_FLAG_CRASH_FLUSH is still set. ieee80211_stop_queues() does not fully
++	 * quiesce data TX, so a frame can still reach ath11k_dp_tx() in that window and
++	 * NULL-deref the freed tx_ring->idr_pool (and, further in, the cleared TCL srng).
++	 * Drop it, as ath11k_ce_send() already does for the WMI path.
++	 */
++	if (unlikely(test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags)))
++		return -ESHUTDOWN;
++
+ 	max_tx_ring = num_tx_rings;
+ 
+ #ifdef CPTCFG_ATH11K_MEM_PROFILE_512M
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-931-ath11k-nss-quiesce-wifili-at-server-exit.patch b/package/kernel/mac80211/patches/nss/ath11k/999-931-ath11k-nss-quiesce-wifili-at-server-exit.patch
new file mode 100644
index 0000000000000000000000000000000000000000..05da74050cf6c390058529b8dc7cb7be7f5bccde
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-931-ath11k-nss-quiesce-wifili-at-server-exit.patch
@@ -0,0 +1,105 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: nss: quiesce wifili offload at SERVER_EXIT before WCSS reset
+
+A Wi-Fi firmware assert drives the ahb SSR path through
+ath11k_core_pre_reconfigure_recovery(), which stops the mac80211 queues and
+drains host TX but leaves the NSS wifili firmware armed and still driving the
+WCSS HAL SRNG pointer registers. Those registers are held in reset while the Q6
+reboots, so the NSS core takes an external abort and coredumps - and because
+wifili and the wired data path share NSS core0, the coredump brings the whole
+box down and the recovery re-arm re-trips it into a reboot loop.
+
+Send the wifili STOP message at SERVER_EXIT, before the WCSS reset lands, so the
+NSS firmware ceases touching the reset register space. The full teardown in
+ath11k_core_reconfigure_on_crash() still runs its stop/deinit/reset and ignores
+this stop's return, so no dynamic-interface node leaks and the offload re-arms
+cleanly once the Q6 is back.
+
+Guard the stop on wifili actually being registered. Cold-boot calibration
+restarts the Q6 through ath11k_core_pre_reconfigure_recovery() on every
+normal boot, before ath11k_nss_init_soc() runs, when ab->nss.if_num is
+still 0; nss_wifili_tx_msg() then rejects the message as a non-wifili
+interface and the stop fails with NSS_TX_FAILURE. ab->nss.ctx is set only
+by init_soc and never cleared, so it distinguishes "never started" from
+"started" without affecting the assert path this patch exists for.
+
+The guard sits in ath11k_nss_stop() rather than in the new caller, so all
+three stop paths share it. The other two cannot currently reach it with a
+null ctx - ath11k_nss_teardown() is only called after a successful setup
+or from behind ATH11K_FLAG_REGISTERED, and the setup error path runs after
+init_soc - but the precondition belongs with the message that requires it.
+Guarding ath11k_nss_teardown() as a whole would instead skip its pdev
+deinit, reset and tx descriptor free.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
+index a1d76bc..48f14dd 100644
+--- a/drivers/net/wireless/ath/ath11k/core.c
++++ b/drivers/net/wireless/ath/ath11k/core.c
+@@ -2570,6 +2570,8 @@ void ath11k_core_pre_reconfigure_recovery(struct ath11k_base *ab)
+ 
+ 	wake_up(&ab->wmi_ab.tx_credits_wq);
+ 
++	ath11k_nss_pre_reconfigure(ab);
++
+ 	reinit_completion(&ab->driver_recovery);
+ }
+ 
+diff --git a/drivers/net/wireless/ath/ath11k/nss.c b/drivers/net/wireless/ath/ath11k/nss.c
+index 66a49d3..5ef4f59 100644
+--- a/drivers/net/wireless/ath/ath11k/nss.c
++++ b/drivers/net/wireless/ath/ath11k/nss.c
+@@ -3417,6 +3417,13 @@ static int ath11k_nss_stop(struct ath11k_base *ab)
+ 	nss_tx_status_t status;
+ 	int ret;
+ 
++	/* Cold-boot calibration restarts the Q6 through pre_reconfigure before
++	 * ath11k_nss_init_soc() has registered wifili, when if_num is still 0
++	 * and the message is rejected as a non-wifili interface.
++	 */
++	if (!ab->nss.ctx)
++		return 0;
++
+ 	ath11k_dbg(ab, ATH11K_DBG_NSS, "NSS stop\n");
+ 	wlmsg = kzalloc(sizeof(struct nss_wifili_msg), GFP_ATOMIC);
+ 	if (!wlmsg)
+@@ -3554,6 +3561,14 @@ int ath11k_nss_teardown(struct ath11k_base *ab)
+ 	return 0;
+ }
+ 
++int ath11k_nss_pre_reconfigure(struct ath11k_base *ab)
++{
++	if (!ab->nss.enabled)
++		return 0;
++
++	return ath11k_nss_stop(ab);
++}
++
+ int ath11k_nss_setup(struct ath11k_base *ab)
+ {
+ 	int i;
+diff --git a/drivers/net/wireless/ath/ath11k/nss.h b/drivers/net/wireless/ath/ath11k/nss.h
+index 41284d7..5f4b48d 100644
+--- a/drivers/net/wireless/ath/ath11k/nss.h
++++ b/drivers/net/wireless/ath/ath11k/nss.h
+@@ -280,6 +280,7 @@ void ath11k_nss_update_sta_rxrate(struct hal_rx_mon_ppdu_info *ppdu_info,
+ 				  struct hal_rx_user_status *user_stats);
+ int ath11k_nss_setup(struct ath11k_base *ab);
+ int ath11k_nss_teardown(struct ath11k_base *ab);
++int ath11k_nss_pre_reconfigure(struct ath11k_base *ab);
+ void ath11k_nss_ext_rx_stats(struct ath11k_base *ab, struct htt_rx_ring_tlv_filter *tlv_filter);
+ #else
+ static inline int ath11k_nss_tx(struct ath11k_vif *arvif, struct sk_buff *skb)
+@@ -447,6 +448,11 @@ static inline int ath11k_nss_teardown(struct ath11k_base *ab)
+ 	return 0;
+ }
+ 
++static inline int ath11k_nss_pre_reconfigure(struct ath11k_base *ab)
++{
++	return 0;
++}
++
+ static inline void ath11k_nss_ext_rx_stats(struct ath11k_base *ab,
+ 					   struct htt_rx_ring_tlv_filter *tlv_filter)
+ {
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-933-ath11k-count-only-the-radios-a-recovery-restarts.patch b/package/kernel/mac80211/patches/nss/ath11k/999-933-ath11k-count-only-the-radios-a-recovery-restarts.patch
new file mode 100644
index 0000000000000000000000000000000000000000..8b32c79ad644730ec370114efbaef058f08b73ec
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-933-ath11k-count-only-the-radios-a-recovery-restarts.patch
@@ -0,0 +1,166 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: count only the radios a recovery restarts
+
+ath11k_core_post_reconfigure_recovery() calls ieee80211_restart_hw()
+only for a radio in ATH11K_STATE_ON. A radio that is off, wedged or in
+FTM is skipped, so it never comes back through ath11k_mac_op_start() or
+ath11k_mac_op_reconfig_complete() and never increments either recovery
+counter.
+
+Both counters were then compared against ab->num_radios - every radio
+the SoC has. On a device where any radio is not ON at crash time the
+comparison can never become true, with two consequences:
+
+  - ath11k_mac_wait_reconfigure() never completes ab->recovery_start,
+    so every ath11k_core_reset() waits out the full
+    ATH11K_RECOVER_START_TIMEOUT_HZ.
+
+  - ath11k_mac_op_reconfig_complete() never clears ab->is_reset. That
+    one is sticky: from then on every ATH11K_QMI_EVENT_SERVER_EXIT takes
+    the "if (!ab->is_reset)" guard as false and skips
+    ath11k_core_pre_reconfigure_recovery() for the lifetime of the
+    device. That function is what resets ar->state_11d to
+    ATH11K_11D_IDLE and completes completed_11d_scan, among a dozen
+    other completions, so the regulatory worker in
+    ath11k_regd_update_chan_list_work() blocks on an 11D scan that will
+    never report, and the channel list is never pushed to firmware.
+
+Count the radios that are actually restarted and compare against that.
+The count is published before the loop that restarts them, because
+ieee80211_restart_hw() is asynchronous and the first radio's
+ath11k_mac_op_start() can run while the loop is still walking.
+
+The no-radio case ends the reset directly rather than latching is_reset
+with nobody left to clear it, so the tail of reconfig_complete moves
+into ath11k_core_reset_finish(), made idempotent for that reason.
+
+NOT VALIDATED ON HARDWARE. The wedge it addresses was reproduced, the
+fix has not been: exercising it needs a firmware assert on a device with
+one radio deliberately down, and the recovery path is the one place
+CLAUDE.md forbids shipping on inspection alone. Do not ship this to
+testers before a device pass.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
+index 48f14dd..e978200 100644
+--- a/drivers/net/wireless/ath/ath11k/core.c
++++ b/drivers/net/wireless/ath/ath11k/core.c
+@@ -2575,11 +2575,43 @@ void ath11k_core_pre_reconfigure_recovery(struct ath11k_base *ab)
+ 	reinit_completion(&ab->driver_recovery);
+ }
+ 
++/* Every radio the recovery restarted has reported back: the reset is over.
++ * Idempotent, because the no-radio case below ends the reset without any
++ * reporter and a radio left over from a previous recovery can still arrive.
++ */
++void ath11k_core_reset_finish(struct ath11k_base *ab)
++{
++	if (!ab->is_reset)
++		return;
++
++	atomic_dec(&ab->reset_count);
++	complete(&ab->reset_complete);
++	ab->is_reset = false;
++	atomic_set(&ab->fail_cont_count, 0);
++}
++
+ static void ath11k_core_post_reconfigure_recovery(struct ath11k_base *ab)
+ {
+ 	struct ath11k *ar;
+ 	struct ath11k_pdev *pdev;
+-	int i;
++	int i, expected = 0;
++
++	/* Only a radio in ATH11K_STATE_ON is restarted below, and only a
++	 * restarted radio comes back through ath11k_mac_wait_reconfigure() and
++	 * ath11k_mac_op_reconfig_complete(). Publish how many that is before
++	 * the first ieee80211_restart_hw() can be acted on, because both of
++	 * those compared against ab->num_radios: with one radio off, wedged or
++	 * in FTM the count never got there, so ab->is_reset was never cleared
++	 * and every later ATH11K_QMI_EVENT_SERVER_EXIT skipped
++	 * ath11k_core_pre_reconfigure_recovery() for the lifetime of the
++	 * device.
++	 */
++	for (i = 0; i < ab->num_radios; i++) {
++		ar = ab->pdevs[i].ar;
++		if (ar && ar->state == ATH11K_STATE_ON)
++			expected++;
++	}
++	atomic_set(&ab->recovery_expected, expected);
+ 
+ 	for (i = 0; i < ab->num_radios; i++) {
+ 		pdev = &ab->pdevs[i];
+@@ -2617,6 +2649,16 @@ static void ath11k_core_post_reconfigure_recovery(struct ath11k_base *ab)
+ 
+ 		mutex_unlock(&ar->conf_mutex);
+ 	}
++
++	/* With no radio to restart nothing will ever report back, so end the
++	 * reset here instead of latching is_reset and burning the full
++	 * ATH11K_RECOVER_START_TIMEOUT_HZ on the way.
++	 */
++	if (!expected && ab->is_reset) {
++		complete(&ab->recovery_start);
++		ath11k_core_reset_finish(ab);
++	}
++
+ 	complete(&ab->driver_recovery);
+ }
+ 
+diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
+index 6713889..d1e5a54 100644
+--- a/drivers/net/wireless/ath/ath11k/core.h
++++ b/drivers/net/wireless/ath/ath11k/core.h
+@@ -1120,6 +1120,10 @@ struct ath11k_base {
+ 	atomic_t reset_count;
+ 	atomic_t recovery_count;
+ 	atomic_t recovery_start_count;
++	/* number of radios this recovery actually restarted, and so the
++	 * number that will report back through the two counters above
++	 */
++	atomic_t recovery_expected;
+ 	bool is_reset;
+ 	struct completion reset_complete;
+ 	struct completion reconfigure_complete;
+@@ -1393,6 +1397,7 @@ int ath11k_core_resume(struct ath11k_base *ab);
+ int ath11k_core_suspend(struct ath11k_base *ab);
+ int ath11k_core_suspend_late(struct ath11k_base *ab);
+ void ath11k_core_pre_reconfigure_recovery(struct ath11k_base *ab);
++void ath11k_core_reset_finish(struct ath11k_base *ab);
+ bool ath11k_core_coldboot_cal_support(struct ath11k_base *ab);
+ 
+ const struct firmware *ath11k_core_firmware_request(struct ath11k_base *ab,
+diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
+index b81876b..64bc08a 100644
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -7004,7 +7004,7 @@ static void ath11k_mac_wait_reconfigure(struct ath11k_base *ab)
+ 	recovery_start_count = atomic_inc_return(&ab->recovery_start_count);
+ 	ath11k_dbg(ab, ATH11K_DBG_MAC, "recovery start count %d\n", recovery_start_count);
+ 
+-	if (recovery_start_count == ab->num_radios) {
++	if (recovery_start_count == atomic_read(&ab->recovery_expected)) {
+ 		complete(&ab->recovery_start);
+ 		ath11k_dbg(ab, ATH11K_DBG_MAC, "recovery started success\n");
+ 	}
+@@ -9818,13 +9818,13 @@ ath11k_mac_op_reconfig_complete(struct ieee80211_hw *hw,
+ 			ath11k_dbg(ab, ATH11K_DBG_BOOT,
+ 				   "recovery count %d\n", recovery_count);
+ 			/* When there are multiple radios in an SOC,
+-			 * the recovery has to be done for each radio
++			 * the recovery has to be done for each radio that
++			 * was restarted - not for every radio the SOC has,
++			 * since a radio that was off, wedged or in FTM never
++			 * gets here.
+ 			 */
+-			if (recovery_count == ab->num_radios) {
+-				atomic_dec(&ab->reset_count);
+-				complete(&ab->reset_complete);
+-				ab->is_reset = false;
+-				atomic_set(&ab->fail_cont_count, 0);
++			if (recovery_count == atomic_read(&ab->recovery_expected)) {
++				ath11k_core_reset_finish(ab);
+ 				ath11k_dbg(ab, ATH11K_DBG_BOOT, "reset success\n");
+ 			}
+ 		}
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-934-ath11k-nss-fix-two-lock-leaks-in-the-wifili-path.patch b/package/kernel/mac80211/patches/nss/ath11k/999-934-ath11k-nss-fix-two-lock-leaks-in-the-wifili-path.patch
new file mode 100644
index 0000000000000000000000000000000000000000..337dcbe4f578e02c40f6599fc642146deeb93d7d
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-934-ath11k-nss-fix-two-lock-leaks-in-the-wifili-path.patch
@@ -0,0 +1,52 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: fix two lock leaks in the wifili path
+
+Two spinlocks in nss.c are released wrongly or not at all. Both leave
+softirqs disabled on the CPU that took them, so the next acquisition of
+the same lock deadlocks the box rather than failing anywhere near the
+bug.
+
+ath11k_nss_wifili_link_desc_return() takes spin_lock_bh(&srng->lock) and
+releases it with spin_unlock(). Its upstream twin,
+ath11k_dp_rx_link_desc_return() in dp_rx.c, is the same function with
+the correct spin_unlock_bh(), which is what the pairing should have
+been.
+
+ath11k_nss_wds_type_rx() takes spin_lock_bh(&ab->base_lock) and then
+returns without releasing it on two early exits, when the netdev has no
+wireless_dev or the wireless_dev has no vif. Every other exit in the
+same function unlocks; these two were missed. base_lock is the driver's
+global peer/AST lock, so leaking it wedges the data path.
+
+Both are pairings rather than behaviour changes: the lock taken decides
+the release, and there is only one release that matches.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/nss.c b/drivers/net/wireless/ath/ath11k/nss.c
+index 5ef4f59..f101919 100644
+--- a/drivers/net/wireless/ath/ath11k/nss.c
++++ b/drivers/net/wireless/ath/ath11k/nss.c
+@@ -129,7 +129,7 @@ static void ath11k_nss_wifili_link_desc_return(struct ath11k_base *ab,
+ 
+ exit:
+ 	ath11k_hal_srng_access_end(ab, srng);
+-	spin_unlock(&srng->lock);
++	spin_unlock_bh(&srng->lock);
+ }
+ 
+ static void ath11k_nss_get_peer_stats(struct ath11k_base *ab, struct nss_wifili_peer_stats *stats)
+@@ -745,11 +745,13 @@ static void ath11k_nss_wds_type_rx(struct ath11k_vif *arvif, struct net_device *
+ 
+ 	wdev = dev->ieee80211_ptr;
+ 	if (!wdev) {
++		spin_unlock_bh(&ab->base_lock);
+ 		return;
+ 	}
+ 
+ 	vif = wdev_to_ieee80211_vif(wdev);
+ 	if (!vif) {
++		spin_unlock_bh(&ab->base_lock);
+ 		return;
+ 	}
+ 
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-935-ath11k-fix-the-reo-descriptor-lifetime-on-tid-delete.patch b/package/kernel/mac80211/patches/nss/ath11k/999-935-ath11k-fix-the-reo-descriptor-lifetime-on-tid-delete.patch
new file mode 100644
index 0000000000000000000000000000000000000000..275732804a00bbc5ddfba40f257b5e8084deb51e
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-935-ath11k-fix-the-reo-descriptor-lifetime-on-tid-delete.patch
@@ -0,0 +1,72 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: fix the REO descriptor lifetime on tid delete
+
+Two places let a freed REO queue descriptor stay reachable.
+
+ath11k_dp_reo_cmd_list_cleanup() walks three lists. The second and third
+release the descriptor with dma_free_noncoherent() over
+rx_tid->unaligned_size and rx_tid->paddr_unaligned, which is how
+ath11k_dp_rx_tid_buf_alloc() produced it. The first, over
+reo_cmd_update_rx_queue_list, instead calls dma_unmap_single() on the
+aligned address and size and then kfree()s the result of
+dma_alloc_noncoherent(). Neither call matches the allocation, and the
+correct sequence is written twice in the same function ten lines below.
+
+ath11k_peer_rx_tid_delete() copies the peer's dp_rx_tid into the queue
+element and then rebinds its local rx_tid pointer to elem->data inside
+the walk. Everything it clears afterwards - vaddr_unaligned, paddr,
+size, pending_desc_size, unaligned_size - therefore lands on the
+element's copy, and the peer keeps active = true plus the address of a
+descriptor the element now owns and will free. ath11k_peer_rx_tid_cleanup()
+calls this and then ath11k_dp_rx_frags_cleanup() on the same peer entry,
+and a second delete for the tid passes the "if (!rx_tid->active)" gate
+and queues the same descriptor twice.
+
+Clear the peer's copy where ownership transfers, right after the memcpy.
+The frag fields are deliberately left alone: ath11k_dp_rx_frags_cleanup()
+is the next call and still needs dst_ring_desc and rx_frag_list.
+
+The first two hunks are API pairings with one correct answer. The third
+is the least mechanical of the set - it decides that the queue element
+owns the descriptor after the copy, which is what the rest of the
+function already assumes - and wants a device pass.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/dp_rx.c b/drivers/net/wireless/ath/ath11k/dp_rx.c
+index ab1e5a0..666903e 100644
+--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
+@@ -746,9 +746,9 @@ void ath11k_dp_reo_cmd_list_cleanup(struct ath11k_base *ab)
+ 		list_del(&cmd_queue->list);
+ 		rx_tid = &cmd_queue->data;
+ 		if (rx_tid->vaddr_unaligned) {
+-			dma_unmap_single(ab->dev, rx_tid->paddr,
+-					 rx_tid->size, DMA_BIDIRECTIONAL);
+-			kfree(rx_tid->vaddr_unaligned);
++			dma_free_noncoherent(ab->dev, rx_tid->unaligned_size,
++					     rx_tid->vaddr_unaligned,
++					     rx_tid->paddr_unaligned, DMA_BIDIRECTIONAL);
+ 			rx_tid->vaddr_unaligned = NULL;
+ 		}
+ 		kfree(cmd_queue);
+@@ -951,6 +951,19 @@ void ath11k_peer_rx_tid_delete(struct ath11k *ar,
+ 	elem->tid = tid;
+ 	memcpy(&elem->data, rx_tid, sizeof(*rx_tid));
+ 
++	/* The queue element owns the REO descriptor from here on, and the loop
++	 * below rebinds rx_tid to elem->data - so the clears it performs never
++	 * reach the peer. Drop the peer's second reference to the same
++	 * descriptor now, leaving the frag fields for
++	 * ath11k_dp_rx_frags_cleanup(), which its caller runs next.
++	 */
++	rx_tid->active = false;
++	rx_tid->vaddr_unaligned = NULL;
++	rx_tid->paddr = 0;
++	rx_tid->size = 0;
++	rx_tid->pending_desc_size = 0;
++	rx_tid->unaligned_size = 0;
++
+ 	spin_lock_bh(&dp->reo_cmd_update_queue_lock);
+ 	list_add_tail(&elem->list, &dp->reo_cmd_update_rx_queue_list);
+ 
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-936-ath11k-nss-free-wifili-exception-skbs-correctly.patch b/package/kernel/mac80211/patches/nss/ath11k/999-936-ath11k-nss-free-wifili-exception-skbs-correctly.patch
new file mode 100644
index 0000000000000000000000000000000000000000..bd9e5b198499178a487e1363007348d72beb7214
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-936-ath11k-nss-free-wifili-exception-skbs-correctly.patch
@@ -0,0 +1,35 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: free wifili exception skbs with dev_kfree_skb_any()
+
+The wifili SoC extended-data callback discards every exception it does not
+handle with kfree(), not with an skb free. kfree() returns the sk_buff struct
+to the allocator on its own, so skb_release_data() never runs: the linear data
+buffer is leaked outright, along with any page fragments and the destructor.
+One buffer per exception frame, unbounded over uptime.
+
+MIC errors are the only type handled, so the default arm takes every
+NSS_WIFILI_SOC_EXT_DATA_PKT_MSDU_LINK_DESC, _INVALID_PEER, _2K_JUMP_ERROR and
+_WIFI_PARSE_ERROR the firmware raises - 2K jumps and parse errors are routine
+on a loaded radio, and _INVALID_PEER fires whenever the firmware sees a frame
+for a peer the host has just torn down.
+
+The mesh offload patch already carries this fix, but package/kernel/mac80211
+applies nss/mesh only under CONFIG_ATH11K_NSS_MESH_SUPPORT, so the correct free
+reaches mesh builds alone and every other NSS build keeps the leak. Fix it in
+the wifili path itself, where the callback lives.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/nss.c b/drivers/net/wireless/ath/ath11k/nss.c
+index f101919..4235a84 100644
+--- a/drivers/net/wireless/ath/ath11k/nss.c
++++ b/drivers/net/wireless/ath/ath11k/nss.c
+@@ -535,7 +535,7 @@ ath11k_nss_wifili_ext_callback_fn(struct ath11k_base *ab, struct sk_buff *skb,
+ 		ath11k_nss_process_mic_error(ab, skb);
+ 		break;
+ 	default:
+-		kfree(skb);
++		dev_kfree_skb_any(skb);
+ 		break;
+ 	}
+ }
diff --git a/package/kernel/mac80211/patches/nss/ath11k/999-938-ath11k-nss-skip-pdev-deinit-for-a-destroyed-radio.patch b/package/kernel/mac80211/patches/nss/ath11k/999-938-ath11k-nss-skip-pdev-deinit-for-a-destroyed-radio.patch
new file mode 100644
index 0000000000000000000000000000000000000000..57e24437908fe1ec5007831066a2c0d468172cd8
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss/ath11k/999-938-ath11k-nss-skip-pdev-deinit-for-a-destroyed-radio.patch
@@ -0,0 +1,44 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: skip nss pdev deinit for an already destroyed radio
+
+ath11k_nss_pdev_deinit() takes its radio from ab->pdevs[radio_id].ar and
+dereferences it unchecked, first through ath11k_nss_peer_stats_disable() and
+then for the deinit message itself. ath11k_mac_destroy() NULLs that pointer for
+every radio, and it sits on the ath11k_core_start() error path - the one a
+crash recovery takes when the firmware never answers with the unified ready
+event.
+
+ath11k_core_reconfigure_on_crash() restores ab->nss.enabled from the module
+parameter before it calls ath11k_core_qmi_firmware_ready(), and the failure
+path back out does not clear it again. A recovery that dies there therefore
+leaves the driver with offload still enabled and no radios at all, so the
+teardown at the top of the next reconfigure walks straight into the NULL.
+
+The first dereference reached is ar->ab in ath11k_nss_stats_cfg(), which every
+offload build takes because ath11k_core_pre_init() sets nss.stats_enabled
+alongside nss.enabled. ab is the first member of struct ath11k, which is why
+the fault address is exactly 0.
+
+A radio that has already been freed has nothing left to deinit - its NSS
+interface number and context lived in the ath11k that ath11k_mac_destroy()
+released - so return early and let the teardown loop account for it.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+diff --git a/drivers/net/wireless/ath/ath11k/nss.c b/drivers/net/wireless/ath/ath11k/nss.c
+index 4235a84..3f4cc12 100644
+--- a/drivers/net/wireless/ath/ath11k/nss.c
++++ b/drivers/net/wireless/ath/ath11k/nss.c
+@@ -3484,6 +3484,12 @@ static int ath11k_nss_pdev_deinit(struct ath11k_base *ab, int radio_id)
+ 	int dyn_if_type;
+ 	int ret;
+ 
++	/* A recovery that fails after ath11k_mac_destroy() leaves the radios
++	 * freed but nss.enabled set, so the next teardown lands here with none.
++	 */
++	if (!ar)
++		return -ENODEV;
++
+ 	ath11k_dbg(ab, ATH11K_DBG_NSS, "NSS pdev %d deinit\n", radio_id);
+ 	dyn_if_type = ath11k_nss_get_dynamic_interface_type(ab);
+ 
diff --git a/package/kernel/mac80211/patches/nss/mesh/0001-subsys-300-ath11k-nss-mesh-offload-support.patch b/package/kernel/mac80211/patches/nss/mesh/0001-subsys-300-ath11k-nss-mesh-offload-support.patch
new file mode 100644
