diff --git a/package/nss/nss-tools/files/luci-nss-connections.js b/package/nss/nss-tools/files/luci-nss-connections.js
new file mode 100644
index 0000000000000000000000000000000000000000..c354c862d3e5b8bc5f51a952fd0da9c066729980
--- /dev/null
+++ b/package/nss/nss-tools/files/luci-nss-connections.js
@@ -0,0 +1,238 @@
+'use strict';
+'require view';
+'require fs';
+'require poll';
+
+/*
+ * Live connections viewer (qosmate-inspired). Renders /usr/sbin/nssqos-conns
+ * JSON; rates are client-side deltas between polls — valid for NSS
+ * accelerated flows too, since ECM syncs their counters into conntrack.
+ * The DSCP class of nssqos-marked connections rides in the ct mark
+ * (dscp | 0x80). The table can be frozen, and every column is sortable
+ * (click the header to toggle ascending/descending) and filterable.
+ */
+
+var DSCP_NAMES = {
+	0: 'CS0', 8: 'CS1', 16: 'CS2', 24: 'CS3', 32: 'CS4', 40: 'CS5',
+	48: 'CS6', 56: 'CS7', 10: 'AF11', 12: 'AF12', 14: 'AF13',
+	18: 'AF21', 20: 'AF22', 22: 'AF23', 26: 'AF31', 28: 'AF32',
+	30: 'AF33', 34: 'AF41', 36: 'AF42', 38: 'AF43', 46: 'EF',
+	44: 'VA', 1: 'LE'
+};
+
+function fmtRate(bps) {
+	if (bps >= 1e6) return (bps / 1e6).toFixed(1) + ' Mbit/s';
+	if (bps >= 1e3) return (bps / 1e3).toFixed(0) + ' kbit/s';
+	return bps.toFixed(0) + ' bit/s';
+}
+
+function fmtBytes(b) {
+	if (b >= 1073741824) return (b / 1073741824).toFixed(1) + ' GB';
+	if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
+	if (b >= 1024) return (b / 1024).toFixed(0) + ' KB';
+	return b + ' B';
+}
+
+function dscpLabel(mark) {
+	if (!(mark & 0x80)) return '—';
+	var d = mark & 0x7f;
+	return DSCP_NAMES[d] || ('0x' + d.toString(16));
+}
+
+/* Column model: display string + sort value per connection. */
+var COLS = [
+	{ title: 'Proto',       disp: function(c) { return c.proto.toUpperCase() + (c.family == 'ipv6' ? '6' : ''); } },
+	{ title: 'Source',      disp: function(c) { return c.src + ':' + c.sport; } },
+	{ title: 'Destination', disp: function(c) { return c.dst + ':' + c.dport; } },
+	{ title: 'State',       disp: function(c) { return c.state || '—'; } },
+	{ title: 'DSCP',        disp: function(c) { return dscpLabel(c.mark); } },
+	{ title: 'PPS',         disp: function(c) { return c._pps.toFixed(0); },      val: function(c) { return c._pps; } },
+	{ title: 'Rate',        disp: function(c) { return fmtRate(c._bps); },        val: function(c) { return c._bps; } },
+	{ title: 'Total',       disp: function(c) { return fmtBytes(c._tot); },       val: function(c) { return c._tot; } }
+];
+
+/* cgi-io, not rpcd: file.exec fails past 256 KiB, ~1500 connections. */
+function fetchConns() {
+	return fs.exec_direct('/usr/sbin/nssqos-conns');
+}
+
+var prev = {};
+var prevTime = 0;
+var lastConns = [];
+var frozen = false;
+var sortCol = 6;      /* Rate */
+var sortDir = -1;     /* descending */
+var colFilters = COLS.map(function() { return ''; });
+
+function connKey(c) {
+	return c.proto + '|' + c.src + '|' + c.sport + '|' + c.dst + '|' + c.dport;
+}
+
+function annotate(conns) {
+	var now = Date.now();
+	var dt = prevTime ? (now - prevTime) / 1000 : 0;
+
+	conns.forEach(function(c) {
+		var p = prev[connKey(c)];
+		c._tot = c.orig_bytes + c.repl_bytes;
+		var totPkts = c.orig_pkts + c.repl_pkts;
+		c._bps = 0; c._pps = 0;
+		if (p && dt > 0) {
+			c._bps = Math.max(0, (c._tot - p.bytes) * 8 / dt);
+			c._pps = Math.max(0, (totPkts - p.pkts) / dt);
+		}
+	});
+
+	prev = {};
+	conns.forEach(function(c) {
+		prev[connKey(c)] = { bytes: c._tot, pkts: c.orig_pkts + c.repl_pkts };
+	});
+	prevTime = now;
+}
+
+function sortVal(c, i) {
+	return COLS[i].val ? COLS[i].val(c) : COLS[i].disp(c).toLowerCase();
+}
+
+/* The header and filter rows are built ONCE; only the data rows are
+ * replaced on refresh — rebuilding the inputs would steal keyboard focus
+ * on every keystroke and every poll. */
+var headerCells = [];
+var dataBody = null;
+
+function render_rows() {
+	if (!dataBody)
+		return;
+
+	headerCells.forEach(function(th, i) {
+		var arrow = (i == sortCol) ? (sortDir > 0 ? ' ▲' : ' ▼') : '';
+		th.textContent = _(COLS[i].title) + arrow;
+	});
+
+	var conns = lastConns.slice();
+	conns.sort(function(a, b) {
+		var x = sortVal(a, sortCol), y = sortVal(b, sortCol);
+		if (x < y) return -1 * sortDir;
+		if (x > y) return 1 * sortDir;
+		return 0;
+	});
+
+	while (dataBody.firstChild) dataBody.removeChild(dataBody.firstChild);
+
+	var shown = 0;
+	conns.forEach(function(c) {
+		var cells = COLS.map(function(col) { return col.disp(c); });
+		for (var i = 0; i < COLS.length; i++) {
+			var f = colFilters[i].toLowerCase();
+			if (f && cells[i].toLowerCase().indexOf(f) < 0)
+				return;
+		}
+		shown++;
+		dataBody.appendChild(E('tr', { 'class': 'tr' }, cells.map(function(v, i) {
+			// data-title: mobile-stacked rows keep their column labels
+			// Array, not bare string: E() would assign the cell to innerHTML,
+			// and these carry addresses and names off the wire.
+			return E('td', { 'class': 'td', 'data-title': _(COLS[i].title) }, [ v ]);
+		})));
+	});
+
+	if (!shown)
+		dataBody.appendChild(E('tr', { 'class': 'tr placeholder' },
+			E('td', { 'class': 'td', 'colspan': COLS.length }, _('No matching connections'))));
+}
+
+function build_table() {
+	headerCells = COLS.map(function(col, i) {
+		return E('th', {
+			'class': 'th',
+			'style': 'cursor:pointer; white-space:nowrap',
+			'title': _('Click to sort'),
+			'click': function() {
+				if (sortCol == i) sortDir = -sortDir;
+				else { sortCol = i; sortDir = (COLS[i].val ? -1 : 1); }
+				render_rows();
+			}
+		}, _(col.title));
+	});
+
+	var filters = E('tr', { 'class': 'tr' }, COLS.map(function(col, i) {
+		return E('td', { 'class': 'td' }, E('input', {
+			'type': 'text',
+			'class': 'cbi-input-text',
+			'style': 'width:100%; min-width:3em',
+			'placeholder': _('filter'),
+			'value': colFilters[i],
+			'input': function(ev) {
+				colFilters[i] = ev.target.value;
+				render_rows();
+			}
+		}));
+	}));
+
+	dataBody = E('tbody');
+	return E('div', { 'style': 'overflow-x:auto' }, E('table', { 'class': 'table' }, [
+		E('thead', {}, [
+			E('tr', { 'class': 'tr table-titles' }, headerCells),
+			filters
+		]),
+		dataBody
+	]));
+}
+
+return view.extend({
+	load: function() {
+		return fetchConns();
+	},
+
+	render: function(res) {
+		var wrap = E('div');
+		var body = E('div', { 'id': 'nssconns' });
+
+		function ingest(r) {
+			if (frozen)
+				return;
+			var conns = [];
+			try { conns = JSON.parse(r || '[]'); } catch (e) {}
+			annotate(conns);
+			lastConns = conns;
+			render_rows();
+		}
+
+		var freezeBtn = E('button', {
+			'class': 'btn cbi-button',
+			'style': 'margin-bottom:10px',
+			'click': function(ev) {
+				frozen = !frozen;
+				ev.target.textContent = frozen ? _('Resume') : _('Freeze');
+				ev.target.className = frozen ? 'btn cbi-button cbi-button-positive'
+							     : 'btn cbi-button';
+				if (!frozen) {
+					/* skip one rate window so the long pause
+					   does not dilute the next delta */
+					prev = {}; prevTime = 0;
+				}
+			}
+		}, _('Freeze'));
+
+		body.appendChild(build_table());
+		ingest(res);
+		poll.add(function() {
+			return fetchConns().then(ingest);
+		}, 3);
+
+		wrap.appendChild(E('h2', {}, _('NSS Connections')));
+		wrap.appendChild(E('div', { 'class': 'cbi-map-descr' },
+			_('Live connection table with rates computed between polls — ' +
+			  'NSS-accelerated flows included (their counters are synced back ' +
+			  'from the firmware). The DSCP column shows classes applied by ' +
+			  'the QoS marking rules. Click a column header to sort; the row ' +
+			  'of boxes filters each column.')));
+		wrap.appendChild(freezeBtn);
+		wrap.appendChild(body);
+		return wrap;
+	},
+
+	handleSave: null,
+	handleSaveApply: null,
+	handleReset: null
+});
diff --git a/package/nss/nss-tools/files/luci-nss-qos.js b/package/nss/nss-tools/files/luci-nss-qos.js
new file mode 100644
index 0000000000000000000000000000000000000000..3132880cd3277f50637248e568b3766d81f6954f
--- /dev/null
+++ b/package/nss/nss-tools/files/luci-nss-qos.js
@@ -0,0 +1,123 @@
+'use strict';
+'require view';
+'require form';
+
+/*
+ * NSS QoS marking rules editor. Front end for /etc/config/nssqos, which
+ * the nssqos service renders into the standalone nftables table
+ * 'inet nssqos'. Marking (and fast-lane steering) applies to NSS
+ * accelerated flows too, in both directions.
+ */
+
+var CLASSES = [
+	['ef',   'EF – Expedited Forwarding (voice)'],
+	['va',   'VA – Voice Admit'],
+	['cs7',  'CS7 – Network control'],
+	['cs6',  'CS6 – Internetwork control'],
+	['cs5',  'CS5 – Signaling'],
+	['cs4',  'CS4 – Realtime interactive'],
+	['af41', 'AF41 – Multimedia conferencing'],
+	['af42', 'AF42 – Multimedia conferencing'],
+	['af43', 'AF43 – Multimedia conferencing'],
+	['cs3',  'CS3 – Broadcast video'],
+	['af31', 'AF31 – Multimedia streaming'],
+	['af32', 'AF32 – Multimedia streaming'],
+	['af33', 'AF33 – Multimedia streaming'],
+	['cs2',  'CS2 – OAM'],
+	['af21', 'AF21 – Low-latency data'],
+	['af22', 'AF22 – Low-latency data'],
+	['af23', 'AF23 – Low-latency data'],
+	['af11', 'AF11 – High-throughput data'],
+	['af12', 'AF12 – High-throughput data'],
+	['af13', 'AF13 – High-throughput data'],
+	['cs1',  'CS1 – Low priority'],
+	['le',   'LE – Least effort (bulk)'],
+	['cs0',  'CS0 – Best effort (default)']
+];
+
+return view.extend({
+	render: function() {
+		var m, s, o;
+
+		m = new form.Map('nssqos', _('NSS QoS Marking'),
+			_('DSCP marking and prioritization for the NSS-accelerated SQM. ' +
+			  'Each rule marks both directions of matching connections; the NSS ' +
+			  'firmware applies the mark to accelerated (offloaded) traffic as well. ' +
+			  'Fast-laned flows bypass the SQM queues entirely — mark sparse traffic ' +
+			  'only (games, calls, DNS), never bulk transfers.'));
+
+		s = m.section(form.NamedSection, 'global', 'global', _('Global'));
+		o = s.option(form.Flag, 'enabled', _('Enable'),
+			_('Master switch for all marking rules.'));
+		o.default = '1';
+		o.rmempty = false;
+
+		o = s.option(form.Flag, 'wash_ingress', _('Wash ingress DSCP'),
+			_('Reset untrusted DSCP on packets arriving from the ISP to CS0. ' +
+			  'Marking rules below still re-mark what they match.'));
+		o.default = '0';
+
+		o = s.option(form.Flag, 'wash_egress', _('Wash egress DSCP'),
+			_('Send all traffic to the ISP as CS0. Fast-lane prioritization ' +
+			  'is unaffected — it rides the internal priority mark, not the wire DSCP.'));
+		o.default = '0';
+
+		s = m.section(form.GridSection, 'rule', _('Rules'));
+		s.addremove = true;
+		s.anonymous = true;
+		s.sortable = true;
+		s.nodescriptions = true;
+
+		o = s.option(form.Flag, 'enabled', _('Enabled'));
+		o.default = '0';
+		o.editable = true;
+
+		o = s.option(form.Value, 'name', _('Name'));
+		o.rmempty = false;
+
+		o = s.option(form.ListValue, 'proto', _('Protocol'));
+		o.value('udp', 'UDP');
+		o.value('tcp', 'TCP');
+		o.value('tcpudp', 'TCP+UDP');
+		o.default = 'udp';
+
+		o = s.option(form.Value, 'src_ip', _('Source IP'),
+			_('Hosts or CIDRs, space-separated, IPv4 and/or IPv6. Empty matches any.'));
+		o.datatype = 'list(or(ipaddr,cidr))';
+		o.modalonly = true;
+
+		o = s.option(form.DynamicList, 'src_port', _('Source ports'),
+			_("One port or range per entry, e.g. '443' or '27015-27030'."));
+		o.datatype = 'or(port,portrange)';
+		o.modalonly = true;
+
+		o = s.option(form.Value, 'dest_ip', _('Destination IP'));
+		o.datatype = 'list(or(ipaddr,cidr))';
+		o.modalonly = true;
+
+		o = s.option(form.DynamicList, 'domain', _('Destination domain'),
+			_('DNS names, re-resolved periodically on the router. A CDN whose ' +
+			  'per-stream subdomains share the zone\'s front-end addresses is ' +
+			  'covered by its apex name. Combines with Destination IP (either matches).'));
+		o.datatype = 'hostname';
+		o.modalonly = true;
+
+		o = s.option(form.DynamicList, 'dest_port', _('Destination ports'),
+			_("One port or range per entry, e.g. '443' or '27015-27030'."));
+		o.datatype = 'or(port,portrange)';
+
+		o = s.option(form.ListValue, 'class', _('DSCP class'));
+		CLASSES.forEach(function(c) { o.value(c[0], c[1]); });
+		o.default = 'cs4';
+
+		o = s.option(form.ListValue, 'fastlane', _('Fast lane'),
+			_('Strict-priority lane ahead of the SQM queues, both directions. ' +
+			  "'Automatic' enables it for EF, VA and CS4–CS7."));
+		o.value('auto', _('Automatic'));
+		o.value('1', _('Always'));
+		o.value('0', _('Never'));
+		o.default = 'auto';
+
+		return m.render();
+	}
+});
diff --git a/package/nss/nss-tools/files/luci-nss-status.js b/package/nss/nss-tools/files/luci-nss-status.js
new file mode 100644
index 0000000000000000000000000000000000000000..52233fdbb5bff8759cf712cf9fe8f852b7fe623c
--- /dev/null
+++ b/package/nss/nss-tools/files/luci-nss-status.js
@@ -0,0 +1,145 @@
+'use strict';
+'require view';
+'require fs';
+'require poll';
+'require dom';
+
+// Renders the output of `nss-status -j` (the single source of truth for
+// NSS plane health); this view only formats, it computes nothing itself.
+
+function getStatus() {
+	return fs.exec('/usr/sbin/nss-status', ['-j']).then(function(res) {
+		if (res.code !== 0)
+			throw new Error(res.stderr || 'nss-status failed');
+		return JSON.parse(res.stdout);
+	});
+}
+
+function stateBadge(state) {
+	var map = {
+		active:  ['#2e7d32', _('Offload active')],
+		stalled: ['#c62828', _('Firmware armed but heartbeat silent — check the system log; a reboot returns to the host stack')],
+		host:    ['#f9a825', _('Host stack (NSS plane not armed)')]
+	};
+	var m = map[state] || ['#757575', state];
+	return E('div', {
+		'style': 'display:inline-block;padding:.3em .8em;border-radius:.3em;color:#fff;font-weight:bold;background:' + m[0]
+	}, [ m[1] ]);
+}
+
+// Every value below is device-derived (firmware version strings, netdev
+// names, counters). LuCI's E() assigns a bare string to innerHTML and only
+// builds text nodes for array members, so the brackets are load-bearing.
+function row(label, value) {
+	return E('tr', { 'class': 'tr' }, [
+		E('td', { 'class': 'td left', 'style': 'min-width:30%' }, label),
+		E('td', { 'class': 'td left' }, Array.isArray(value) ? value : [ value ])
+	]);
+}
+
+function onoff(v) {
+	return v ? _('loaded') : _('not loaded');
+}
+
+function offl(pkts, pct) {
+	return String(pkts) + ' (' + pct + '%)';
+}
+
+function renderStatus(d) {
+	var cores = (d.cores || []).map(function(c) {
+		return 'core' + c.core + ' ' + c.avg + '%';
+	}).join(', ');
+
+	var igs = (d.sqm.igs || []).map(function(i) {
+		return i.port + (i.active ? ' ✓' : ' ✗');
+	}).join('  ');
+
+	// d.mesh: {configured, fw_capable} - 802.11s mesh only offloads on the
+	// 11.4 firmware line; everywhere else it stays on the host path.
+	var mesh = d.mesh || {};
+	var wifi = d.wifi_offload == 1 ?
+	               (mesh.configured ? _('NSS offload active (wifili, 802.11s mesh offloaded)')
+	                                : _('NSS offload active (wifili)')) :
+	           d.wifi_offload == 0 ?
+	               (mesh.configured && mesh.fw_capable ? _('host mode (mesh configured; firmware supports mesh offload)') :
+	                mesh.configured ? _('host mode (mesh configured; mesh offload needs the 11.4 NSS firmware)') :
+	                                  _('host mode')) :
+	           _('ath11k not loaded');
+
+	// data-title lets the theme stack table rows into labeled cards on
+	// narrow (mobile) screens.
+	var portRows = (d.ports || []).map(function(p) {
+		return E('tr', { 'class': 'tr' }, [
+			E('td', { 'class': 'td', 'data-title': _('Port') }, [ p.netdev ]),
+			E('td', { 'class': 'td', 'data-title': 'if_num' }, [ String(p.ifnum) ]),
+			E('td', { 'class': 'td', 'data-title': _('Started') }, [ p.started ? _('yes') : _('no') ]),
+			E('td', { 'class': 'td', 'data-title': _('TX offloaded') }, [ offl(p.tx_offloaded, p.tx_offload_pct) ]),
+			E('td', { 'class': 'td', 'data-title': _('TX via host') }, [ String(p.tx_host_pkts) ]),
+			E('td', { 'class': 'td', 'data-title': _('RX offloaded') }, [ offl(p.rx_offloaded, p.rx_offload_pct) ]),
+			E('td', { 'class': 'td', 'data-title': _('RX to host') }, [ String(p.rx_host_pkts) ])
+		]);
+	});
+
+	return E('div', {}, [
+		E('p', {}, stateBadge(d.state)),
+		E('table', { 'class': 'table' }, [
+			row(_('Firmware'), d.fw_version + ' (fw_mask ' + d.fw_mask + ')'),
+			row(_('Heartbeat'), d.heartbeat_pps + ' ' + _('pkts/s (NSS→host)')),
+			row(_('NSS core load'), cores || '-'),
+			row(_('ECM accelerated connections'), d.ecm.loaded
+				? d.ecm.ipv4_accel + ' IPv4 / ' + d.ecm.ipv6_accel + ' IPv6 / ' + d.ecm.multicast_accel + ' ' + _('multicast')
+				: _('ECM not loaded')),
+			row(_('Bridge offload (bridge-mgr)'), onoff(d.modules.bridge_mgr)),
+			row(_('PPPoE manager'), onoff(d.modules.pppoe)),
+			row(_('Wi-Fi data path'), wifi),
+			row(_('SQM shaper'), d.sqm.active
+				? _('nsstbl on') + ' ' + d.sqm.device + (igs ? ' — ' + _('upload IGS:') + ' ' + igs : '')
+				: _('no NSS shaper on') + ' ' + d.sqm.device),
+			(d.sqm.fastlane && d.sqm.fastlane.active)
+				? row(_('Fast lane'), _('egress') + ' ' + d.sqm.fastlane.egress_pkts + ' pkts / ' +
+					_('ingress') + ' ' + d.sqm.fastlane.ingress_pkts + ' pkts — ' +
+					(d.sqm.qos_marking_rules || 0) + ' ' + _('marking rules'))
+				: E('tr', { 'style': 'display:none' })
+		]),
+		E('h3', {}, _('Firmware-attached ports')),
+		E('table', { 'class': 'table' }, [
+			E('tr', { 'class': 'tr table-titles' }, [
+				E('th', { 'class': 'th' }, _('Port')),
+				E('th', { 'class': 'th' }, 'if_num'),
+				E('th', { 'class': 'th' }, _('Started')),
+				E('th', { 'class': 'th' }, _('TX offloaded')),
+				E('th', { 'class': 'th' }, _('TX via host')),
+				E('th', { 'class': 'th' }, _('RX offloaded')),
+				E('th', { 'class': 'th' }, _('RX to host'))
+			])
+		].concat(portRows.length ? portRows : [
+			E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td', 'colspan': '7' }, _('No ports attached — host stack'))
+			])
+		])),
+		E('p', {}, E('em', {}, _('Offloaded packets are forwarded by the firmware and never reach the host. "via host" / "to host" is the host↔firmware exception path — what was not offloaded — so low numbers there mean offload is working. Broadcast and multicast discovery, connection setup, short-lived flows and traffic addressed to the router itself always take that path: a flow is only offloaded once it is established, so a quiet port that carries little else shows a low offloaded share. Port totals are on Status → Overview.')))
+	]);
+}
+
+return view.extend({
+	load: getStatus,
+
+	render: function(data) {
+		var container = E('div', {}, renderStatus(data));
+
+		poll.add(function() {
+			return getStatus().then(function(d) {
+				dom.content(container, renderStatus(d));
+			});
+		}, 10);
+
+		return E('div', {}, [
+			E('h2', {}, _('NSS Offload')),
+			container
+		]);
+	},
+
+	handleSave: null,
+	handleSaveApply: null,
+	handleReset: null
+});
diff --git a/package/nss/nss-tools/files/nss-offload.defaults b/package/nss/nss-tools/files/nss-offload.defaults
new file mode 100644
index 0000000000000000000000000000000000000000..eb1b7775d81cd66854c5f6f69efdc935ef98e6f1
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-offload.defaults
@@ -0,0 +1,22 @@
+uci -q batch << EOI
+# Keep OpenWrt's packet-steering service out of the NSS data path: its model is a
+# host NAPI per hardware queue, which does not describe a datapath where the
+# firmware delivers through N2H. In this mode the service writes rps_cpus=0 on the
+# netdevs it owns (the Wi-Fi VAPs and the EDMA conduit); the cores-1-3 mask for
+# the delivery netdevs comes from net.core.rps_default_mask in
+# 12-nss-networking.conf.
+#
+# Measured on a Wi-Fi client to wired host flow through the router, two runs
+# each: 749 and 800 Mbit/s with the service disabled against 619 and 626 with
+# it at its default, and the default also produced n2h_rx_queue drops (158 and
+# 83) where disabling it produced none. See 12-nss-networking.conf.
+#
+# Kernel flow offloading must stay off: its flowtable forwards established
+# flows before the netfilter hooks ECM classifies from. OpenWrt ships it off,
+# but a config kept across sysupgrade from a flowtable build has it on.
+set network.globals.packet_steering='0'
+set firewall.@defaults[0].flow_offloading='0'
+set firewall.@defaults[0].flow_offloading_hw='0'
+EOI
+
+exit 0
diff --git a/package/nss/nss-tools/files/nss-ppe-diff b/package/nss/nss-tools/files/nss-ppe-diff
new file mode 100644
index 0000000000000000000000000000000000000000..e6d92b8c7e6ec701e4af0cafdeec38ac024b812c
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-ppe-diff
@@ -0,0 +1,228 @@
+#!/bin/sh
+# nss-ppe-diff - snapshot the PPE's configuration registers, and diff a live
+# read against that snapshot.
+#
+# Why this exists. The per-port egress wedge survives a link cycle and a full
+# NSS data-plane detach and re-attach, and is cleared only by a reboot. That
+# narrows the holder to state which a reboot re-initialises and nothing else
+# rewrites - which in this SoC means a PPE register written once at probe. Every
+# readout we had answers "what is this register now", and none of them answers
+# the question that actually names a fault of that shape: "which register is no
+# longer what we wrote". Two host<->firmware owners share this register file, so
+# that question has to be answerable without knowing in advance which register
+# to suspect.
+#
+# So: save a baseline once the plane is armed and healthy, and diff at wedge
+# time. Any line that changed names the writer.
+#
+# usage:
+#   nss-ppe-diff save [file]   take a baseline (default /root/auto-recovery/ppe-baseline.txt)
+#   nss-ppe-diff [file]        diff the live registers against a baseline
+#   nss-ppe-diff dump          print the live registers, diff nothing
+#
+# Configuration registers only. Counters, queue occupancy, flow-control status
+# and the FDB are deliberately excluded: they change constantly by design and
+# would bury the one line that matters. nss-wedge-watch reads those.
+
+GLUE=/sys/kernel/debug/qca-ppe-nss
+BASE=0x3a000000
+# The clock controller: the per-port MAC clock branches live here, not in the
+# PPE, and they are as capable of stopping a port as any PPE gate.
+GCC=0x01800000
+BASELINE_DEFAULT=/root/auto-recovery/ppe-baseline.txt
+
+# Block bases are fixed by the SoC, not by the board: PPE at 0x3a000000 with
+# MAC_CSR 0x1000, XGMAC_CSR 0x3000, PRX 0xb000, IVLAN 0xf000, PTX 0x20000,
+# L2 0x60000, TM 0x400000, BM 0x600000, QM 0x800000. Everything board-shaped -
+# which ports exist, which are armed, each port's queue base and scheduler node
+# - is read from live state below. Never add a port range here.
+r() { devmem $(($1)) 32 2>/dev/null; }
+p_() { echo "$1 $(r $2)"; }
+
+ports() {
+	awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' "$GLUE/status" 2>/dev/null
+}
+
+dump() {
+	# --- global ---
+	p_ LPI_ENABLE            $((BASE + 0x400))
+	p_ L2_GLOBAL_CONF        $((BASE + 0x60038))
+	p_ AGE_TIMER             $((BASE + 0x60034))
+	p_ EG_BRIDGE_CONFIG      $((BASE + 0x26000))
+	p_ PRX_TDM_CTRL          $((BASE + 0xb000))
+	p_ TM_TDM_DEPTH          $((BASE + 0x400000))
+	p_ SHP_SLOT_L0           $((BASE + 0x400010))
+	p_ SHP_SLOT_L1           $((BASE + 0x400014))
+	p_ SHP_SLOT_PORT         $((BASE + 0x400018))
+
+	# --- per port: everything that gates whether the port can transmit ---
+	# The MAC index is port-1 for the GMACs; the XGMAC window is per port and
+	# is read for every port because which port is XGMAC-backed is a board
+	# property we must not encode.
+	for p in $(ports); do
+		g=$((p - 1))
+		p_ "PORT${p}_BRIDGE_CTRL"  $((BASE + 0x60300 + p * 4))
+		p_ "PORT${p}_CST_STATE"    $((BASE + 0x60100 + p * 4))
+		p_ "PORT${p}_MRU_MTU_W0"   $((BASE + 0x63000 + p * 0x10))
+		p_ "PORT${p}_MRU_MTU_W1"   $((BASE + 0x63000 + p * 0x10 + 4))
+		p_ "PORT${p}_MC_MTU_CTRL"  $((BASE + 0x60a00 + p * 4))
+		p_ "PORT${p}_EG_VLAN"      $((BASE + 0x20420 + p * 4))
+		p_ "PORT${p}_DEF_VID"      $((BASE + 0xf010 + p * 4))
+		p_ "PORT${p}_VLAN_CFG"     $((BASE + 0xf050 + p * 4))
+		p_ "GMAC${g}_ENABLE"       $((BASE + 0x1000 + g * 0x200))
+		p_ "GMAC${g}_SPEED"        $((BASE + 0x1000 + g * 0x200 + 0x4))
+		p_ "GMAC${g}_CTRL2"        $((BASE + 0x1000 + g * 0x200 + 0x18))
+		p_ "GMAC${g}_DBG_CTRL"     $((BASE + 0x1000 + g * 0x200 + 0x1c))
+		p_ "GMAC${g}_JUMBO"        $((BASE + 0x1000 + g * 0x200 + 0x30))
+		p_ "GMAC${g}_MIB_CTRL"     $((BASE + 0x1000 + g * 0x200 + 0x34))
+		p_ "XGMAC${p}_TX_CONF"     $((BASE + 0x3000 + p * 0x4000))
+		p_ "XGMAC${p}_RX_CONF"     $((BASE + 0x3000 + p * 0x4000 + 0x4))
+		p_ "XGMAC${p}_PKT_FILTER"  $((BASE + 0x3000 + p * 0x4000 + 0x8))
+		p_ "XGMAC${p}_TX_FLOW"     $((BASE + 0x3000 + p * 0x4000 + 0x70))
+		p_ "XGMAC${p}_RX_FLOW"     $((BASE + 0x3000 + p * 0x4000 + 0x90))
+		p_ "BM${p}_FC_W0"          $((BASE + 0x601000 + p * 0x10))
+		p_ "BM${p}_FC_W1"          $((BASE + 0x601000 + p * 0x10 + 4))
+		p_ "BM${p}_FC_MODE"        $((BASE + 0x600100 + p * 4))
+		p_ "BM${p}_GROUP"          $((BASE + 0x600180 + p * 4))
+		# port egress shaper: cfg is two words, credit and sign their own
+		# tables. Read word 0 first - these entries are behind a read
+		# shadow and word 1 belongs to whatever was latched last.
+		p_ "PSHP${p}_CFG_W0"       $((BASE + 0x474000 + p * 0x10))
+		p_ "PSHP${p}_CFG_W1"       $((BASE + 0x474000 + p * 0x10 + 4))
+		p_ "PSHP${p}_CREDIT"       $((BASE + 0x472000 + p * 0x10))
+		p_ "PSHP${p}_SIGN"         $((BASE + 0x470000 + p * 0x10))
+
+		# The port's own MAC clock branches, in the clock controller rather
+		# than the PPE. These matter more than their obscurity suggests:
+		# the driver enables every one of them exactly once, in probe, with
+		# clk_bulk_prepare_enable(), and nothing in the tree ever re-enables
+		# a branch afterwards. The common clock framework's enable_count
+		# stays at 1 for the life of the boot, so even an explicit
+		# clk_prepare_enable() from elsewhere would be a refcount bump with
+		# no register write - which makes a gated branch reboot-only state
+		# by construction, the exact shape of this fault. Measured on an
+		# AX3600: clearing the TX branch stops the port transmitting with
+		# its carrier up, its MAC TX counter at exactly zero, every
+		# host-owned gate healthy, and an admin link down/up unable to
+		# repair it; restoring the bit recovers it within one sample.
+		# Bit 0 is the enable, bit 31 reads back CLK_OFF.
+		p_ "GCC_PORT${p}_TX_CLK"   $((GCC + 0x68244 + (p - 1) * 8))
+		p_ "GCC_PORT${p}_RX_CLK"   $((GCC + 0x68240 + (p - 1) * 8))
+
+		# --- the port's own queues and scheduler nodes ---
+		# Queue base and L1 node id come out of the live QM/L0 maps, so
+		# this works on any IPQ807x port layout.
+		qb=$(( ($(r $((BASE + 0x810000 + p * 0x10))) >> 4) & 0xff ))
+		echo "PORT${p}_QBASE $qb"
+		q=$qb
+		while [ $q -lt $((qb + 16)) ]; do
+			p_ "Q${q}_L0_FLOW"   $((BASE + 0x402000 + q * 0x10))
+			p_ "Q${q}_L0_PORT"   $((BASE + 0x408000 + q * 0x10))
+			p_ "Q${q}_AC_W0"     $((BASE + 0x848000 + q * 0x10))
+			p_ "Q${q}_AC_W3"     $((BASE + 0x848000 + q * 0x10 + 0xc))
+			p_ "Q${q}_SHP_W0"    $((BASE + 0x41c000 + q * 0x10))
+			r $((BASE + 0x41c000 + q * 0x10 + 4)) >/dev/null
+			p_ "Q${q}_SHP_W2"    $((BASE + 0x41c000 + q * 0x10 + 8))
+			p_ "Q${q}_SHP_CRED"  $((BASE + 0x41a000 + q * 0x10))
+			q=$((q + 1))
+		done
+		sp=$(( $(r $((BASE + 0x402000 + qb * 0x10))) & 0x3f ))
+		for s in $sp $((sp + 1)); do
+			p_ "L1_${s}_FLOW"    $((BASE + 0x440000 + s * 0x10))
+			p_ "L1_${s}_PORT"    $((BASE + 0x446000 + s * 0x10))
+			p_ "L1_${s}_SHP_W0"  $((BASE + 0x45e000 + s * 0x10))
+			r $((BASE + 0x45e000 + s * 0x10 + 4)) >/dev/null
+			p_ "L1_${s}_SHP_W2"  $((BASE + 0x45e000 + s * 0x10 + 8))
+			p_ "L1_${s}_SHP_CRED" $((BASE + 0x45c000 + s * 0x10))
+		done
+	done
+
+	# --- VSI table: the firmware assigns these, so a lost membership or a
+	# cleared forwarding mask shows up here and nowhere else ---
+	v=0
+	while [ $v -lt 32 ]; do
+		p_ "VSI${v}_W0" $((BASE + 0x61800 + v * 0x10))
+		p_ "VSI${v}_W1" $((BASE + 0x61800 + v * 0x10 + 4))
+		p_ "EG_VSI_TAG${v}" $((BASE + 0x20000 + v * 4))
+		v=$((v + 1))
+	done
+
+	# --- the port scheduler's time-division tables: shared, written once ---
+	i=0
+	while [ $i -lt 128 ]; do
+		p_ "PSCH_TDM${i}" $((BASE + 0x47a000 + i * 0x10))
+		i=$((i + 1))
+	done
+	i=0
+	while [ $i -lt 48 ]; do
+		p_ "PRX_TDM${i}" $((BASE + 0xc000 + i * 0x10))
+		i=$((i + 1))
+	done
+}
+
+[ -r "$GLUE/status" ] || { echo "nss-ppe-diff: NSS plane not armed" >&2; exit 1; }
+
+case "${1:-}" in
+save)
+	f="${2:-$BASELINE_DEFAULT}"
+	mkdir -p "$(dirname "$f")"
+	# Stamp the boot. The capture directory survives sysupgrade on purpose,
+	# so without this a baseline could outlive the firmware that produced it
+	# and every changed default would read as a foreign write - a phantom
+	# diff is worse than no diff.
+	{ echo "# boot_id $(cat /proc/sys/kernel/random/boot_id)"; dump; } > "$f" || exit 1
+	echo "nss-ppe-diff: baseline saved to $f ($(($(wc -l < "$f") - 1)) registers)"
+	;;
+dump)
+	dump
+	;;
+*)
+	f="${1:-$BASELINE_DEFAULT}"
+	[ -r "$f" ] || {
+		echo "nss-ppe-diff: no baseline at $f - take one with 'nss-ppe-diff save'" >&2
+		exit 1
+	}
+	want=$(sed -n 's/^# boot_id //p' "$f")
+	have=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
+	[ -n "$want" ] && [ "$want" = "$have" ] || {
+		echo "nss-ppe-diff: $f was taken on a different boot ($want), not this one" >&2
+		echo "  Refusing to diff: register defaults can differ across firmware, so" >&2
+		echo "  every one of them would read as a foreign write. Re-run 'nss-ppe-diff" >&2
+		echo "  save' when the box is healthy, and diff after the next occurrence." >&2
+		exit 1
+	}
+	now=$(mktemp) || exit 1
+	res=$(mktemp) || exit 1
+	dump > "$now"
+	# Join on the register name rather than diffing line by line: the port
+	# set can differ between the two reads (a port may have been unplugged),
+	# and a positional diff would then report every following line.
+	#
+	# Collect into a file and print it once. Counting the lines of something
+	# already on its way to stdout invites writing the same report down two
+	# descriptors, and when both are the same file - which is exactly how
+	# nss-wedge-watch calls this - the second one starts from its own offset
+	# and overwrites the beginning of the capture.
+	awk '/^#/ {next}
+	     NR==FNR {was[$1] = $2; next}
+	     {
+		if (!($1 in was)) { printf "  %-22s (new)      -> %s\n", $1, $2; next }
+		if (was[$1] != $2) printf "  %-22s %s -> %s\n", $1, was[$1], $2
+		seen[$1] = 1
+	     }
+	     END {
+		for (k in was) if (!(k in seen)) printf "  %-22s %s -> (gone)\n", k, was[k]
+	     }' "$f" "$now" > "$res"
+	n=$(wc -l < "$res")
+	cat "$res"
+	rm -f "$now" "$res"
+	if [ "$n" = 0 ]; then
+		echo "nss-ppe-diff: every PPE configuration register still holds its baseline value."
+		echo "  Whatever is wrong with this box, nothing rewrote the PPE's configuration."
+	else
+		echo "nss-ppe-diff: $n PPE configuration registers changed since the baseline."
+		echo "  Nothing in this stack rewrites these after setup, so each line above is"
+		echo "  a write by the other owner of this register file."
+	fi
+	;;
+esac
diff --git a/package/nss/nss-tools/files/nss-status b/package/nss/nss-tools/files/nss-status
new file mode 100755
index 0000000000000000000000000000000000000000..24311fcdc22b1472f4a73dac97d6e9c043605191
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-status
@@ -0,0 +1,524 @@
+#!/bin/sh
+# nss-status: one-shot health report for the NSS offload data plane.
+# Human-readable by default; -j emits JSON (used by the LuCI status page);
+# -d/--debug appends a diagnostics snapshot (firmware EDMA/N2H counters,
+# ECM totals, recent NSS kernel messages). Read-only: safe to run at any time.
+
+# Every path the report reads hangs off one prefix, empty on the router. Point
+# it at an unpacked support capture to read that box's state on a workstation,
+# which is also how the parsers are exercised without hardware.
+R="${NSS_STATUS_ROOT:-}"
+
+. "$R/lib/nss/functions.sh"
+
+GLUE=$R/sys/kernel/debug/qca-ppe-nss
+DRV=$R/sys/kernel/debug/qca-nss-drv/stats
+ECM=$R/sys/kernel/debug/ecm
+NET=$R/sys/class/net
+MOD=$R/sys/module
+
+JSON=0
+DEBUG=0
+L2=0
+case "$1" in
+	-j) JSON=1 ;;
+	-d|--debug) DEBUG=1 ;;
+	-l2) L2=1 ;;
+esac
+
+mod() { [ -d "$MOD/$1" ] && echo 1 || echo 0; }
+
+# --- collect ---------------------------------------------------------------
+
+fw_version=$(nss_fw_version)
+[ -n "$fw_version" ] || fw_version="unknown"
+
+# 802.11s mesh state, same decision nss-up takes. mesh_cfg/mesh_capable only
+# say a mesh iface is configured and the firmware line supports offload; they
+# say nothing about whether a mesh vdev actually got created (vdev alloc can
+# fail at runtime - e.g. -524 - while the iface stays up on the host path).
+# "links" is written by ath11k_nss_mesh_vdev_alloc() only on success, so a
+# non-empty file is the actual runtime signal. It lives under the per-ab
+# debugfs root (ath11k/<bus>-<devname>/), so glob rather than assume a name.
+nss_mesh_state
+mesh_cfg=$NSS_MESH_CFG
+mesh_capable=$NSS_MESH_CAPABLE
+mesh_vdev=0
+for f in "$R"/sys/kernel/debug/ath11k/*/dbg_infra/links; do
+	grep -q "^link id" "$f" 2>/dev/null && mesh_vdev=1
+done
+
+fw_mask=$(cat "$GLUE/fw_mask" 2>/dev/null)
+[ -n "$fw_mask" ] || fw_mask="0x0"
+
+n2h_sum() { awk '$1 == "n2h_rx_pkts" {s += $3} END {print s + 0}' "$DRV/n2h" 2>/dev/null; }
+
+heartbeat=0
+if [ -r "$DRV/n2h" ]; then
+	a=$(n2h_sum); sleep 1; b=$(n2h_sum)
+	heartbeat=$((b - a))
+fi
+
+# "Core N:" then a Min/Avg/Max percent line; keep the Avg column per core.
+core_loads=$(awk '/^Core [0-9]+:/ {c=$2; sub(":","",c)}
+	/%/ {gsub("%",""); print c":"$2}' "$DRV/cpu_load_ubi" 2>/dev/null)
+
+# if_num N: netdev=lanX armed=1 overridden=1 started=1 injectable=1 fw_vsi=N
+#           tx_redirect_pkts=N tx_busy=N rx_fw_pkts=N
+#
+# The glue counters are the host<->firmware exception path: tx_redirect_pkts is
+# what the host handed to the firmware to egress the port, rx_fw_pkts is what
+# the firmware punted back up. The port's own totals come from the netdev, whose
+# counters are the MAC's MIB and therefore see every frame on the wire. What the
+# firmware forwarded on its own - the offloaded share - is the difference.
+#
+# Match the fields by name. By position, a field added to the line silently
+# shifts every counter after it into the wrong column, and the result still
+# looks like a plausible packet count.
+ports=$(awk '/^if_num/ {
+	sub(":", "", $2)
+	nd = ""; st = 0; tx = 0; rx = 0
+	for (i = 3; i <= NF; i++) {
+		split($i, kv, "=")
+		if (kv[1] == "netdev")                nd = kv[2]
+		else if (kv[1] == "started")          st = kv[2]
+		else if (kv[1] == "tx_redirect_pkts") tx = kv[2]
+		else if (kv[1] == "rx_fw_pkts")       rx = kv[2]
+	}
+	if (nd != "-") print $2 " " nd " " st " " tx " " rx
+}' "$GLUE/status" 2>/dev/null)
+
+# ifnum netdev started host_tx fw_rx tx_total rx_total tx_offl rx_offl tx_pct rx_pct
+ports=$(echo "$ports" | while read -r ifnum nd st htx frx; do
+	[ -n "$ifnum" ] || continue
+	ttx=$(cat "$NET/$nd/statistics/tx_packets" 2>/dev/null || echo 0)
+	trx=$(cat "$NET/$nd/statistics/rx_packets" 2>/dev/null || echo 0)
+	echo "$ifnum $nd $st $htx $frx $ttx $trx" | LC_ALL=C awk '{
+		otx = $6 - $4; orx = $7 - $5
+		if (otx < 0) otx = 0
+		if (orx < 0) orx = 0
+		ptx = ($6 > 0) ? 100 * otx / $6 : 0
+		prx = ($7 > 0) ? 100 * orx / $7 : 0
+		printf "%s %s %s %s %s %s %s %d %d %.1f %.1f\n",
+		       $1, $2, $3, $4, $5, $6, $7, otx, orx, ptx, prx
+	}'
+done)
+
+ecm_loaded=$(mod ecm)
+ecm_v4=$(cat "$ECM/ecm_nss_ipv4/accelerated_count" 2>/dev/null || echo 0)
+ecm_v6=$(cat "$ECM/ecm_nss_ipv6/accelerated_count" 2>/dev/null || echo 0)
+ecm_mc=$(( $(cat "$ECM/ecm_nss_ipv4/multicast_accelerated_count" 2>/dev/null || echo 0) +
+	$(cat "$ECM/ecm_nss_ipv6/multicast_accelerated_count" 2>/dev/null || echo 0) ))
+# An nft flowtable forwards an established flow from its ingress hook, ahead of
+# the netfilter hooks ECM classifies from, so ECM never sees the flow and the
+# firmware exceptions every packet of it to the host.
+flowtables=$(nft list flowtables 2>/dev/null | grep -c '^[[:space:]]*flowtable ')
+
+bridge_mgr=$(mod qca_nss_bridge_mgr)
+pppoe_mgr=$(mod qca_nss_pppoe)
+
+wifi_offload=$(cat "$MOD/ath11k/parameters/nss_offload" 2>/dev/null || echo -1)
+
+nss_sqm_section
+sqm_sec=$NSS_SQM_SEC
+sqm_dev=$NSS_SQM_DEV
+sqm_active=0
+[ -n "$sqm_dev" ] && tc qdisc show dev "$sqm_dev" 2>/dev/null | grep -q nsstbl && sqm_active=1
+
+# Fast lane: nsspfifo band packet counters (egress tree + ingress IFB tree).
+fastlane_pkts() {
+	tc -s qdisc show dev "$1" 2>/dev/null | grep -A1 nsspfifo | \
+		sed -n 's/.*Sent [0-9]* bytes \([0-9]*\) pkt.*/\1/p' | head -1
+}
+fl_egress=$(fastlane_pkts "$sqm_dev")
+fl_ingress=$(fastlane_pkts "ifb@${sqm_dev}")
+fl_active=0
+[ -n "$fl_egress$fl_ingress" ] && fl_active=1
+qos_rules=$(nft list chain inet nssqos forward 2>/dev/null | grep -c 'dscp set')
+igs_ports=""
+for p in $(uci -q get "sqm.${sqm_sec}.igs_upload"); do
+	if tc qdisc show dev "ifb-$p" 2>/dev/null | grep -q nsstbl; then
+		igs_ports="$igs_ports $p:1"
+	else
+		igs_ports="$igs_ports $p:0"
+	fi
+done
+
+# An NSS tree forwards nothing until one leaf is marked as its default
+# destination. A root left without one is the shape a failed or interrupted
+# shaper build leaves behind, and it is invisible everywhere else: the link
+# stays up, the carrier stays set, tc still lists a shaper. Name it, because
+# from the outside it looks exactly like a dead port or a dead line.
+sqm_dropping=""
+for d in $sqm_dev "ifb@${sqm_dev}" $(uci -q get "sqm.${sqm_sec}.igs_upload" | sed 's/[^ ]*/ifb-&/g'); do
+	[ -n "$d" ] || continue
+	tc qdisc show dev "$d" 2>/dev/null | head -n1 | grep -q '^qdisc nsstbl' || continue
+	tc qdisc show dev "$d" 2>/dev/null | grep -q set_default || sqm_dropping="$sqm_dropping $d"
+done
+
+state=host
+if [ "$fw_mask" != "0x0" ]; then
+	if [ "$heartbeat" -gt 0 ]; then
+		state=active
+	else
+		state=stalled
+	fi
+fi
+
+# Kernel log sweep: a WARN/oops anywhere in this boot is worth surfacing even
+# when everything else looks healthy (WARN_ON_ONCE fires once and scrolls away).
+kwarns=$(dmesg 2>/dev/null | grep -c 'cut here')
+koops=$(dmesg 2>/dev/null | grep -cE 'Oops:|BUG:|Kernel panic')
+
+# --- emit ------------------------------------------------------------------
+
+if [ "$JSON" = 1 ]; then
+	pjson=""
+	for line in $(echo "$ports" | tr ' ' ',' ); do
+		# line: ifnum,netdev,started,tx,rx
+		# Splitting is the point: one field per positional parameter.
+		# shellcheck disable=SC2046
+		set -- $(echo "$line" | tr ',' ' ')
+		[ -n "$1" ] || continue
+		pjson="$pjson{\"ifnum\":$1,\"netdev\":\"$2\",\"started\":$3,\"tx_host_pkts\":$4,\"rx_host_pkts\":$5,\"tx_total\":$6,\"rx_total\":$7,\"tx_offloaded\":$8,\"rx_offloaded\":$9,\"tx_offload_pct\":${10},\"rx_offload_pct\":${11}},"
+	done
+	pjson="[${pjson%,}]"
+
+	cjson=""
+	for c in $core_loads; do
+		cjson="$cjson{\"core\":${c%%:*},\"avg\":${c##*:}},"
+	done
+	cjson="[${cjson%,}]"
+
+	ijson=""
+	for i in $igs_ports; do
+		ijson="$ijson{\"port\":\"${i%%:*}\",\"active\":${i##*:}},"
+	done
+	ijson="[${ijson%,}]"
+
+	# The shaper fault the text report calls out: an NSS root with no default
+	# leaf drops every packet while the link stays up. It was computed and
+	# then thrown away here, so the LuCI page could never show the one state
+	# that most looks like dead hardware.
+	sfjson=""
+	for d in $sqm_dropping; do
+		sfjson="$sfjson\"$d\","
+	done
+	sfjson="[${sfjson%,}]"
+
+	cat <<-EOF
+	{"state":"$state","fw_version":"$fw_version","fw_mask":"$fw_mask",
+	"heartbeat_pps":$heartbeat,"cores":$cjson,"ports":$pjson,
+	"ecm":{"loaded":$ecm_loaded,"ipv4_accel":$ecm_v4,"ipv6_accel":$ecm_v6,"multicast_accel":$ecm_mc},
+	"modules":{"bridge_mgr":$bridge_mgr,"pppoe":$pppoe_mgr},
+	"wifi_offload":$wifi_offload,
+	"mesh":{"configured":$mesh_cfg,"offloaded":$mesh_vdev,"fw_capable":$mesh_capable},
+	"kernel_log":{"warns":$kwarns,"oopses":$koops},
+	"sqm":{"active":$sqm_active,"device":"$sqm_dev","igs":$ijson,
+	"shaper_fault":$sfjson,
+	"fastlane":{"active":$fl_active,"egress_pkts":${fl_egress:-0},"ingress_pkts":${fl_ingress:-0}},
+	"qos_marking_rules":$qos_rules}}
+	EOF
+	exit 0
+fi
+
+# --- L2 per-port datapath view (-l2) ---------------------------------------
+# host<->fw<->wire counters per offloaded port. The pointer that localises an
+# egress stall: a link-up port whose host->fw (glue tx_redirect) climbs while
+# the client stays unreachable is not putting frames on the wire.
+if [ "$L2" = 1 ]; then
+	edp=$DRV/edma/ports
+	# VSI table base (HPPE, SoC-wide on IPQ807x): PPE 0x3a000000 + L2 block
+	# 0x060000 + VSI_TBL 0x1800, 0x10 per VSI. Word0 holds the member and
+	# unknown-unicast/multicast/broadcast flood bitmaps: an emptied word0 on a
+	# started port means the firmware dropped the port out of its own flood
+	# masks, which silently black-holes host BUM egress (PADI/ARP/ND).
+	vsi_bmp() { [ -n "$1" ] && [ "$1" -ge 0 ] 2>/dev/null &&
+		devmem $((0x3a061800 + $1 * 0x10)) 32 2>/dev/null; }
+	echo "NSS L2 per-port datapath:"
+	printf "  %-6s %-4s %-4s %-4s %-4s %-4s %-11s %12s %9s %9s %12s %12s %12s\n" \
+	       port ifn car inj fwl vsi vsi_bmp "host->fw" "hostbusy" "hostdrop" \
+	       "fw->host" "wire->fw" "fw->wire"
+	# Port set comes from the live glue table, never a hardcoded range: the
+	# WAN is port 2 on one board and port 6 on the next.
+	for pn in $(awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' \
+		    "$GLUE/status" 2>/dev/null); do
+		line=$(grep "if_num $pn:" "$GLUE/status" 2>/dev/null)
+		nd=$(echo "$line" | sed -n 's/.*netdev=\([^ ]*\).*/\1/p')
+		[ -z "$nd" ] || [ "$nd" = "-" ] && continue
+		vsi=$(echo "$line" | sed -n 's/.*fw_vsi=\([^ ]*\).*/\1/p')
+		inj=$(echo "$line" | sed -n 's/.*injectable=\([^ ]*\).*/\1/p')
+		fwl=$(echo "$line" | sed -n 's/.*fw_link=\([^ ]*\).*/\1/p')
+		txr=$(echo "$line" | sed -n 's/.*tx_redirect_pkts=\([^ ]*\).*/\1/p')
+		tbz=$(echo "$line" | sed -n 's/.*tx_busy=\([^ ]*\).*/\1/p')
+		tdr=$(echo "$line" | sed -n 's/.*tx_dropped=\([^ ]*\).*/\1/p')
+		rxf=$(echo "$line" | sed -n 's/.*rx_fw_pkts=\([^ ]*\).*/\1/p')
+		car=$(cat "$NET/$nd/carrier" 2>/dev/null)
+		# A failed devmem read must not swallow the column: every field in
+		# this row is width-aligned and read by eye, so an empty one shifts
+		# everything after it and silently renames the remaining numbers.
+		bmp=$(vsi_bmp "$vsi")
+		etx=$(cat "$edp/$pn"/* 2>/dev/null | awk '/tx_pkts/{print $3}')
+		erx=$(cat "$edp/$pn"/* 2>/dev/null | awk '/rx_pkts/{print $3}')
+		printf "  %-6s %-4s %-4s %-4s %-4s %-4s %-11s %12s %9s %9s %12s %12s %12s\n" \
+		       "$nd" "$pn" "${car:-?}" "${inj:-?}" "${fwl:-?}" "${vsi:-?}" \
+		       "${bmp:-?}" "${txr:-?}" "${tbz:-?}" "${tdr:-?}" \
+		       "${rxf:-?}" "${etx:-?}" "${erx:-?}"
+	done
+	echo "  host->fw=glue tx_redirect  fw->host=glue rx_fw  wire->fw=edma ingress  fw->wire=edma egress"
+	echo "  link-up + host->fw climbing + client unreachable => egress stall (see /root/auto-recovery)"
+	echo "  A wedged WAN on a carrier-up port reads as one of:"
+	echo "    inj=0            host TX is dropped before the firmware - the port never got its"
+	echo "                     injection grant back after a transition"
+	echo "    hostbusy rising  the firmware stopped draining the host->fw ring"
+	echo "    fwl=0            we last told the firmware this port's link is DOWN, so it"
+	echo "                     will not transmit on it; a missed grant on our side"
+	echo "    hostdrop rising  nss-drv refused the frames before the firmware ever saw"
+	echo "                     them; host->fw counts those as sent, so read it here"
+	echo "    host->fw rising  frames reach the firmware and die past it (fabric/egress side);"
+	echo "                     an emptied vsi_bmp there means the flood masks were lost"
+
+	# When frames do die past the firmware, the PPE fabric already knows why:
+	# it counts every discard against a named reason, per port. Nothing was
+	# reading those, so the one question a wedge capture has to answer - is the
+	# fabric dropping this port's traffic, and for what - could not be answered
+	# after the fact. Report any port whose drop counters are moving; a healthy
+	# port has none at all, so silence here is meaningful too.
+	#
+	# The 'special' rows are not discards (ppe_drop_code_none counts forwarded
+	# frames), hence the filter on the type column rather than on the name.
+	drops=""
+	for pn in $(awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' \
+		    "$GLUE/status" 2>/dev/null); do
+		f="$DRV/ppe/code/drop/$pn"
+		[ -r "$f" ] || continue
+		top=$(awk '$2 == "=" && $4 == "drop" && $3 + 0 > 0 {print $3, $1}' "$f" 2>/dev/null |
+		      sort -rn | head -1)
+		[ -n "$top" ] && drops="${drops}
+    port $pn: $(echo "$top" | awk '{print $2}' | sed 's/^ppe_drop_code_//') = $(echo "$top" | awk '{print $1}')"
+	done
+	if [ -n "$drops" ]; then
+		echo "  PPE FABRIC DROPS (the hardware naming what it discarded, per port):$drops"
+		echo "    full list per port: nss-status -d, or"
+		echo "    awk '\$2==\"=\" && \$4==\"drop\" && \$3+0>0' $DRV/ppe/code/drop/<port>"
+	else
+		echo "  PPE fabric drop counters: all zero on every armed port"
+	fi
+
+	# A stalled port that drops nothing anywhere is not dropping, it is not being
+	# dequeued - and the thing that stops the port scheduler dequeuing a port is
+	# its egress shaper. Reproduced on an AX3600 by arming PSCH_SHP_CFG_TBL for one
+	# port with cir=1: that port's queue pinned at its admission ceiling, the
+	# buffer manager raised per-port flow control, the firmware's egress counter
+	# and the MAC MIB TX both froze, and neither an "ip link down/up" nor a
+	# data-plane restore brought it back - which is the field capture of this wedge
+	# down to the queue depth. A negative shaper credit outlives clearing the
+	# enable bit, so both are read here.
+	#
+	# We program no PPE shaper anywhere (grep-verified across the DSA drivers, the
+	# glue and every nss-tools script), and a healthy armed box reads zero in all
+	# of these, so anything armed here was armed by the firmware.
+	# PSCH_SHP_CFG_TBL 0x3a474000 (word1 bit4 = SHAPER_ENABLE, word0 bits 17:0 =
+	# CIR), PSCH_SHP_CREDIT_TBL 0x3a472000, PSCH_SHP_SIGN_TBL 0x3a470000 (bit0 =
+	# credit negative), 0x10 per port - qca-ssdk NHSS.QSDK.14.0.r8, hppe_shaper_reg.h
+	# relative to TRAFFIC_MANAGER_BASE_ADDR 0x400000.
+	shp=""
+	for pn in $(awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' \
+		    "$GLUE/status" 2>/dev/null); do
+		nd=$(sed -n "s/^if_num $pn: netdev=\([^ ]*\).*/\1/p" "$GLUE/status")
+		w0=$(devmem $((0x3a474000 + pn * 0x10)) 32 2>/dev/null)
+		w1=$(devmem $((0x3a474000 + pn * 0x10 + 4)) 32 2>/dev/null)
+		sg=$(devmem $((0x3a470000 + pn * 0x10)) 32 2>/dev/null)
+		[ -n "$w1" ] && [ -n "$sg" ] || continue
+		en=$(( ($w1 >> 4) & 1 ))
+		neg=$(( $sg & 1 ))
+		[ "$en" = 1 ] || [ "$neg" = 1 ] || continue
+		shp="${shp}
+    ${nd:-port $pn}: SHAPER_ENABLE=$en credit_neg=$neg cir=$(( $w0 & 0x3ffff )) \
+credit=$(devmem $((0x3a472000 + pn * 0x10)) 32 2>/dev/null)"
+	done
+	if [ -n "$shp" ]; then
+		echo "  PPE EGRESS SHAPER ARMED - the port scheduler will not drain these ports:$shp"
+		echo "    cir=0 with SHAPER_ENABLE=1 is a shaper with no rate: the port cannot"
+		echo "    transmit at all, and no link cycle recovers it - only a reboot."
+		echo "    Nothing in this build writes these registers; please report this block."
+	else
+		echo "  PPE egress shapers: disabled on every armed port (the healthy value)"
+	fi
+	exit 0
+fi
+
+echo "NSS offload status: $state"
+echo "  firmware:    $fw_version (fw_mask $fw_mask, heartbeat ${heartbeat} pkts/s)"
+if [ -n "$core_loads" ]; then
+	echo -n "  NSS cores:  "
+	for c in $core_loads; do echo -n " core${c%%:*} ${c##*:}% avg"; done
+	echo ""
+fi
+if [ -n "$ports" ]; then
+	echo "  ports:       offloaded = forwarded by the firmware, never reached the host"
+	printf "    %-6s %3s %3s  %18s %10s  %18s %10s\n" \
+	       "port" "if" "up" "tx offloaded" "via host" "rx offloaded" "to host"
+	echo "$ports" | while read -r ifnum nd st htx frx ttx trx otx orx ptx prx; do
+		[ -n "$ifnum" ] || continue
+		printf "    %-6s %3s %3s  %18s %10s  %18s %10s\n" \
+		       "$nd" "$ifnum" "$st" "$otx ($ptx%)" "$htx" "$orx ($prx%)" "$frx"
+	done
+	echo "    (via host / to host = the host<->firmware exception path, i.e. what was"
+	echo "     NOT offloaded: broadcast/multicast discovery, connection setup and"
+	echo "     short-lived flows, and traffic addressed to the router itself. A quiet"
+	echo "     port carries little else, so its share reads low. Port totals: ifconfig)"
+fi
+echo "  ECM:         loaded=$ecm_loaded, accelerated: $ecm_v4 IPv4 / $ecm_v6 IPv6 / $ecm_mc multicast"
+echo "  modules:     bridge-mgr=$bridge_mgr pppoe-mgr=$pppoe_mgr"
+case "$wifi_offload" in
+	1)  if [ "$mesh_cfg" = 1 ] && [ "$mesh_vdev" = 1 ]; then
+	        echo "  Wi-Fi:       NSS offload active (wifili, 802.11s mesh offloaded)"
+	    elif [ "$mesh_cfg" = 1 ]; then
+	        echo "  Wi-Fi:       NSS offload active (wifili; 802.11s mesh configured, not offloaded)"
+	    else
+	        echo "  Wi-Fi:       NSS offload active (wifili)"
+	    fi ;;
+	0)  if [ "$mesh_cfg" = 1 ] && [ "$mesh_capable" = 1 ]; then
+	        echo "  Wi-Fi:       host mode (mesh configured; firmware supports mesh offload - armed by nss-up)"
+	    elif [ "$mesh_cfg" = 1 ]; then
+	        echo "  Wi-Fi:       host mode (mesh configured; mesh offload needs the 11.4 NSS firmware and a mesh-enabled build)"
+	    else
+	        echo "  Wi-Fi:       host mode"
+	    fi ;;
+	*)  echo "  Wi-Fi:       ath11k not loaded" ;;
+esac
+if [ "$sqm_active" = 1 ]; then
+	igs_human=$(echo "$igs_ports" | sed 's/\([a-z0-9]*\):1/\1/g; s/\([a-z0-9]*\):0/\1(MISSING)/g')
+	echo "  SQM:         nsstbl shaper on $sqm_dev, upload IGS:${igs_human:- none}"
+	[ -n "$sqm_dropping" ] && echo "  SHAPER FAULT: no default leaf below the NSS root on:$sqm_dropping - those devices are dropping every packet they are given (link stays up)"
+	if [ "$fl_active" = 1 ]; then
+		echo "  fast lane:   egress ${fl_egress:-0} pkts / ingress ${fl_ingress:-0} pkts, ${qos_rules} marking rules active"
+	fi
+else
+	echo "  SQM:         no NSS shaper${sqm_dev:+ on $sqm_dev}"
+fi
+if [ "$kwarns" -gt 0 ] || [ "$koops" -gt 0 ]; then
+	echo "  kernel log:  $kwarns WARN / $koops oops this boot - see 'nss-status -d' or dmesg"
+else
+	echo "  kernel log:  clean (no WARN/oops this boot)"
+fi
+case "$state" in
+	active)  if [ "$flowtables" -gt 0 ]; then
+	             echo "  verdict:     FIRMWARE ARMED BUT AN NFT FLOWTABLE FORWARDS ESTABLISHED FLOWS AHEAD OF ECM - set firewall.@defaults[0].flow_offloading{,_hw}='0'"
+	         else
+	             echo "  verdict:     OFFLOAD ACTIVE"
+	         fi ;;
+	stalled) echo "  verdict:     FIRMWARE ARMED BUT HEARTBEAT SILENT - check logread; reboot returns to the host stack" ;;
+	host)    echo "  verdict:     host stack (NSS plane not armed - run nss-up or 'service nss start')" ;;
+esac
+
+[ "$DEBUG" = 1 ] || exit 0
+
+# --- debug snapshot (-d) -----------------------------------------------------
+# Every source is optional: with the NSS plane down most of these do not exist.
+
+sec() {
+	echo ""
+	echo "=== $1 ==="
+}
+
+sec "firmware EDMA error/pressure counters ($DRV/edma/err_stats)"
+if [ -r "$DRV/edma/err_stats" ]; then
+	cat "$DRV/edma/err_stats"
+else
+	echo "(not available - qca-nss-drv not loaded / firmware not armed)"
+fi
+
+sec "N2H (firmware-to-host) statistics ($DRV/n2h)"
+if [ -r "$DRV/n2h" ]; then
+	# The raw file repeats identical stat names once per core, told apart only
+	# by a banner line - prefix every stat line with its core so greps and
+	# over-time comparisons can never mix the two cores.
+	awk '/N2H [01]/ { core = $3 } { sub(/^\tn2h_/, "\tcore" core ".n2h_"); print }' "$DRV/n2h"
+	echo ""
+	echo "note: payload_alloc_fails = per-packet retries while the fw payload pool"
+	echo "  runs dry; bursts by design under saturating load. rx_queue[N]_drops ="
+	echo "  host-bound queue back-pressure at its limit (sysctl"
+	echo "  dev.nss.n2hcfg.n2h_queue_limit_coreN); neither touches offloaded flows."
+else
+	echo "(not available - qca-nss-drv not loaded / firmware not armed)"
+fi
+
+sec "PPE fabric drop codes, per port (nonzero only, $DRV/ppe/code/drop)"
+# Port numbers come from the live glue table, never a fixed range - the WAN is
+# port 2 on one board and port 6 on the next.
+if [ -d "$DRV/ppe/code/drop" ]; then
+	for pn in $(awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' \
+		    "$GLUE/status" 2>/dev/null); do
+		f="$DRV/ppe/code/drop/$pn"
+		[ -r "$f" ] || continue
+		nd=$(sed -n "s/.*if_num $pn: netdev=\([^ ]*\).*/\1/p" "$GLUE/status" 2>/dev/null)
+		hits=$(awk '$2 == "=" && $4 == "drop" && $3 + 0 > 0 {printf "    %-46s %s\n", $1, $3}' "$f" 2>/dev/null)
+		if [ -n "$hits" ]; then
+			echo "  port $pn (${nd:-?}):"
+			echo "$hits"
+		else
+			echo "  port $pn (${nd:-?}): no drops"
+		fi
+	done
+else
+	echo "(not available - qca-nss-drv not loaded / firmware not armed)"
+fi
+
+sec "PPE host-punt reasons (nonzero only, $DRV/ppe/code/cpu)"
+# Why the fabric handed a frame to the host instead of forwarding it. A wedge
+# that punts everything and a wedge that drops everything look identical from
+# the outside and are not the same fault.
+for w in exception non-exception; do
+	f="$DRV/ppe/code/cpu/$w"
+	[ -r "$f" ] || continue
+	# $2 == "=" pins the counter shape: the file's banner line also has a third
+	# field, and an unanchored numeric test compares it as a string and matches.
+	hits=$(awk '$2 == "=" && $3 + 0 > 0 {printf "    %-46s %s\n", $1, $3}' "$f" 2>/dev/null)
+	echo "  $w:"
+	echo "${hits:-    (none)}"
+done
+
+sec "firmware log ring (${DRV%/stats}/logs)"
+# Readable on demand, no coredump needed, and empty on a healthy box - so
+# anything in here at all is worth reading.
+found=0
+for c in "${DRV%/stats}"/logs/core*; do
+	[ -r "$c" ] || continue
+	found=1
+	if [ -s "$c" ]; then
+		echo "  $(basename "$c"):"
+		cat "$c" 2>/dev/null | tail -60
+	else
+		echo "  $(basename "$c"): empty"
+	fi
+done
+[ "$found" = 1 ] || echo "(not available - qca-nss-drv not loaded / firmware not armed)"
+
+sec "ECM connection totals ($ECM)"
+if [ -d "$ECM" ]; then
+	for f in ecm_db/connection_count \
+		 ecm_nss_ipv4/accelerated_count ecm_nss_ipv4/pending_accel_count \
+		 ecm_nss_ipv4/pending_decel_count \
+		 ecm_nss_ipv6/accelerated_count ecm_nss_ipv6/pending_accel_count \
+		 ecm_nss_ipv6/pending_decel_count; do
+		[ -r "$ECM/$f" ] && echo "$f: $(cat "$ECM/$f" 2>/dev/null)"
+	done
+else
+	echo "(not available - ecm not loaded)"
+fi
+
+sec "kernel warnings/oopses this boot (dmesg)"
+if [ "$kwarns" -gt 0 ] || [ "$koops" -gt 0 ]; then
+	dmesg 2>/dev/null | grep -B2 -A44 -E 'cut here|Oops:|BUG:|Kernel panic' | tail -150
+else
+	echo "(none)"
+fi
+
+sec "recent NSS kernel messages (dmesg)"
+dmesg 2>/dev/null | grep -i nss | tail -40
+
+sec "hints"
+echo "sysctl -w dev.nss.project.wt_stats=1 enables per-worker-thread firmware"
+echo "statistics under $DRV/project/"
diff --git a/package/nss/nss-tools/files/nss-tools.keep b/package/nss/nss-tools/files/nss-tools.keep
new file mode 100644
index 0000000000000000000000000000000000000000..1f4dd7b0d88217c662f194e90202f26ce27b0a72
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-tools.keep
@@ -0,0 +1,5 @@
+# Captures taken at the moment a port died. A sysupgrade rebuilds the overlay,
+# so without this the one state that explains a wedge is destroyed by the very
+# flash that carries the fix - which is exactly how one occurrence was lost.
+/root/auto-recovery
+/root/pstore
diff --git a/package/nss/nss-tools/files/nss-up b/package/nss/nss-tools/files/nss-up
new file mode 100755
index 0000000000000000000000000000000000000000..babde4ce65459bcb04b3f3edd0df66d3e0533600
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-up
@@ -0,0 +1,238 @@
+#!/bin/sh
+# Layer the NSS data-plane services on the armed firmware: bridge/multicast/
+# ECM/PPPoE managers, WAN and SQM. The nss init service armed the wired plane
+# and loaded ath11k with the data-path decision before netifd ran (the radios
+# bind once, no rebind here); this instance starts alongside netifd, verifies
+# that state, waits for the network topology, and brings up the rest. A
+# reboot with nss.general.enabled='0' returns the device to the host stack.
+set -e
+. /lib/nss/functions.sh
+# Every stage here loads its module by name. Stock OpenWrt answers modprobe with
+# ubox's kmodloader, which resolves a name by scanning /lib/modules and follows
+# each module's own depends= list. The optional 'kmod' package takes /sbin/modprobe
+# over (alternatives priority 200) with upstream kmod, which resolves names only
+# through a depmod-generated modules.dep that no OpenWrt image ships: every
+# modprobe below then fails as "not found" and, with no dependency walk, ECM
+# reports unresolved symbols instead.
+[ "$(readlink /sbin/modprobe)" = /sbin/kmodloader ] ||
+  [ -f "/lib/modules/$(uname -r)/modules.dep" ] ||
+  echo "WARN: modprobe cannot resolve module names here (the 'kmod' package replaced kmodloader and there is no modules.dep) - remove the 'kmod' package or run 'depmod -a'"
+FWM=/sys/kernel/debug/qca-ppe-nss/fw_mask
+[ "$(cat $FWM 2>/dev/null || echo 0x0)" != "0x0" ] || { echo "data plane not armed (the nss init service arms it before netifd) - nothing to do"; exit 1; }
+# nss-drv hands the armed ports their data plane from a one-shot workqueue
+# after the firmware boots; wait for that registration to reach every armed
+# port instead of guessing with a fixed sleep.
+NARM=$(grep -c 'armed=1' /sys/kernel/debug/qca-ppe-nss/status 2>/dev/null)
+ports_registered() {
+  [ "$(grep -c 'overridden=1' /sys/kernel/debug/qca-ppe-nss/status 2>/dev/null)" -ge "${NARM:-1}" ]
+}
+poll_until 20 ports_registered || true
+grep 'armed=1' /sys/kernel/debug/qca-ppe-nss/status
+
+# The firmware data plane is armed (the critical section above exits on
+# failure). Everything below - bridge-mgr, ECM, PPPoE, the Wi-Fi flip, WAN,
+# SQM - is best-effort: a failure here must not abort the script and leave the
+# firmware armed without ECM.
+set +e
+
+# Firmware log ring. The ring the firmware publishes through meminfo holds 32
+# entries, and a firmware trap logs five lines per attempt, so a single burst
+# overwrites the ring and a coredump can only ever show the trap itself, never
+# what led to it. The driver also exposes /sys/kernel/debug/qca-nss-drv/logs/*
+# only for a ring it allocated, so by default the log is unreadable while
+# running too. Allocate a larger ring on both counts.
+FWLOG="$(uci -q get nss.general.fw_logbuf)"
+[ -n "$FWLOG" ] || FWLOG=256
+[ "$FWLOG" -ge 32 ] 2>/dev/null && sysctl -qw dev.nss.general.logbuf="$FWLOG"
+
+# This instance starts before netifd, but the managers below bind to
+# netifd's topology (bridge-mgr member-walks the live bridge on load).
+# Wait for the interface objects and the first bridge to exist; a
+# bridge-less configuration just pays the short timeout and proceeds
+# (bridge-mgr also handles later joins through its netdev notifiers).
+ubus -t 20 wait_for network.interface 2>/dev/null
+have_bridge() { ls -d /sys/class/net/*/bridge >/dev/null 2>&1; }
+poll_until 15 have_bridge
+
+# bridge-mgr: offload Linux-bridge L2 forwarding into the firmware. Load after
+# the data plane is up (ports armed) and before ECM, so the firmware bridge
+# interface exists when ECM classifies bridged flows. On load it walks the
+# existing bridge's members and joins the wired (qca_ppe) ports; Wi-Fi members
+# are skipped until they become NSS interfaces.
+modprobe qca-nss-bridge-mgr 2>/dev/null || true
+
+# vlan-mgr: register 802.1Q upper devices of the armed ports as firmware VLAN
+# interfaces. Without it the firmware untags parsed IP traffic onto the parent
+# port device, so a plain tagged-VLAN WAN (e.g. DHCP on wan.N) never sees its
+# inbound packets. Load after the ports are armed (it resolves the parent
+# device's interface number on the netdev-notifier replay) and before ECM, so
+# connection hierarchies over VLANs bind the firmware VLAN interfaces.
+# The module is not in the default image (a firmware VLAN node with no attached
+# VSI coredumps core0, so it is opt-in at build time too). Say so rather than
+# letting the opt-in fail silently.
+if [ "$(uci -q get nss.general.vlan_mgr)" = "1" ]; then
+  modprobe qca-nss-vlan 2>/dev/null ||
+    echo "WARN: nss.general.vlan_mgr=1 but qca-nss-vlan is not in this image - rebuild with the NSS VLAN manager selected"
+fi
+
+sysctl -w net.netfilter.nf_conntrack_events=1
+modprobe ecm front_end_selection=1
+# ECM creates its debugfs tree from the module init; wait for the file rather
+# than guessing at a delay. A fixed sleep that is too short on a loaded boot
+# makes the write below fail silently and leaves the default classifier
+# accelerating from the first packet.
+ecm_ready() { [ -w /sys/kernel/debug/ecm/ecm_classifier_default/accel_delay_pkts ]; }
+poll_until 15 ecm_ready &&
+  echo 1 > /sys/kernel/debug/ecm/ecm_classifier_default/accel_delay_pkts ||
+  echo "WARN: ECM debugfs did not appear - accel_delay_pkts left at its default"
+
+# PPPoE connection-manager offload. Load unconditionally: the manager only
+# learns sessions created after it loads, and gating this on the current
+# network.wan.proto loses the race when the WAN becomes PPPoE only after boot
+# (fresh flash + config restore) - leaving every WAN flow stuck on the host
+# path. It is inert without a PPPoE session, and on images without the module
+# the redirect below swallows the error. The 'ifup wan' further down
+# (re)creates the session after the manager is resident.
+modprobe qca-nss-pppoe 2>/dev/null || true
+
+# Wi-Fi: the nss init service loaded ath11k before netifd with nss_offload
+# already decided and the pbuf n2h/clock tuning applied, so the radios bound
+# once, straight onto their data path (wifili when offloaded). Verify that
+# an offload-mode load actually produced radios; if none appeared, fall back
+# to host-mode Wi-Fi (the recovery/escape path). Nothing was up on the
+# failed path, so the rebind needs no prior wifi down.
+# Ask the ath11k platform driver for its phys rather than counting
+# /sys/class/ieee80211: on a board that also carries a PCIe radio, ath11k_pci
+# binds that one on its own and its phy alone satisfied the count, so the
+# fallback never ran when the SoC radios failed to bind.
+radios_up() { [ -n "$(ls -d /sys/bus/platform/drivers/ath11k/*/ieee80211/phy* 2>/dev/null)" ]; }
+if [ -e /sys/bus/platform/devices/c000000.wifi ] \
+   && [ "$(cat /sys/module/ath11k/parameters/nss_offload 2>/dev/null)" = "1" ]; then
+  if ! poll_until 15 radios_up; then
+    echo "WIFI OFFLOAD FAILED - falling back to host-mode wifi"
+    echo 0 > /sys/module/ath11k/parameters/nss_offload
+    echo c000000.wifi > /sys/bus/platform/drivers/ath11k/unbind 2>/dev/null
+    sleep 3
+    echo c000000.wifi > /sys/bus/platform/drivers/ath11k/bind
+    poll_until 12 radios_up
+    wifi up
+  fi
+fi
+
+# Linux RPS for the delivery netdevs is not applied here: net.core.rps_default_mask
+# (12-nss-networking.conf) already gives every netdev created after sysctl.d runs
+# the cores-1-3 mask at rx-queue creation, which covers the bridges, pppoe-wan and
+# the IGS ifb devices. See that file for why the Wi-Fi VAPs are not ours to set.
+
+# WAN + SQM bring-up is best-effort with retries (set +e is in effect).
+# Identify the WAN interface from the live default route (any section name
+# works); only when the WAN is down at this point fall back to the
+# conventional logical name 'wan'.
+. /lib/functions/network.sh
+network_find_wan wan_iface
+[ -n "$wan_iface" ] || wan_iface=wan
+ifup "$wan_iface"
+
+# Wait for the WAN to obtain an L3 address before flushing conntrack and
+# reporting: WAN negotiation (PPPoE especially) takes seconds, and the SQM
+# outcome below can only be judged once the ifup completed. Poll the real
+# L3 device for up to ~60s.
+# The L3 device (pppoe-wan for a PPPoE WAN, the DHCP/static device otherwise)
+# only exists once the interface is up, so re-derive it every iteration instead
+# of sampling it once before the WAN has negotiated.
+i=0
+while [ $i -lt 30 ]; do
+  wan_dev=$(ifstatus "$wan_iface" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
+  if [ -n "$wan_dev" ] \
+     && { ip -4 addr show dev "$wan_dev" 2>/dev/null | grep -q "inet " \
+          || ip -6 addr show dev "$wan_dev" scope global 2>/dev/null | grep -q "inet6 "; }; then
+    break
+  fi
+  i=$((i + 1))
+  sleep 2
+done
+[ -n "$wan_dev" ] || wan_dev=$wan_iface
+if [ $i -lt 30 ]; then
+  echo "$wan_dev has an IP after ~$((i * 2))s"
+else
+  echo "WARN: $wan_dev still has no IP after 60s; starting SQM anyway"
+fi
+
+# Flush conntrack/ECM so flows established during bring-up re-accelerate
+# against the finished topology. The short settle is deliberate and not a
+# guess: the WAN wait above returns as soon as the L3 device has an address,
+# while pppd is still installing routes and the firewall is still reloading,
+# and flushing into that window just re-creates the stale flows.
+sleep 3
+echo 1 > /sys/kernel/debug/ecm/ecm_db/defunct_all 2>/dev/null
+echo f > /proc/net/nf_conntrack 2>/dev/null
+# Report what is actually up. Everything past the critical section is
+# best-effort, so an unconditional "NSS+wifi+ECM up" turned a failed ECM load or
+# a partially registered plane into a green light with empty accel counts.
+v4=$(cat /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count 2>/dev/null)
+v6=$(cat /sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count 2>/dev/null)
+if [ -n "$v4" ] || [ -n "$v6" ]; then
+  echo "NSS+wifi+ECM up. accel counts: v4=${v4:-0} v6=${v6:-0}"
+else
+  echo "WARN: NSS plane armed but ECM is not accelerating (no ecm_nss_ipv4/ipv6 counters) - check 'logread | grep -i ecm'"
+fi
+
+# --- Optional offloads (NOT enabled in the default image) ------------------
+# Routed (L3) multicast, e.g. IPTV WAN->LAN. To enable it in a fork: add a
+# multicast-routing daemon to the build (CONFIG_PACKAGE_igmpproxy=y or smcroute),
+# ship your own /etc/config for it, disable its boot autostart so it starts only
+# here (after pppoe-wan has an address), and uncomment the line below. ECM
+# (ECM_MULTICAST_ENABLE, already on) then turns each kernel MFC entry the daemon
+# installs into a PPE hardware rule. See docs/CUSTOMIZE.md.
+# [ -x /usr/sbin/igmpproxy ] && /etc/init.d/igmpproxy start 2>/dev/null || true
+#
+# The other build-verified extras (nat46/MAP-T, vxlan, macvlan, gre) need no
+# bring-up step here - ECM offloads them automatically once their kmod and
+# interface exist.
+# ---------------------------------------------------------------------------
+
+# SQM starts from the iface hotplug on the 'ifup wan' above: sqm-scripts'
+# own 11-sqm covers sections shaping the L3 netdev, the 12-nss-sqm hotplug
+# (sqm-scripts-nss) covers sections shaping a lower device of the WAN stack
+# (the physical port, where the NSS shaper sits). Just report the outcome.
+# Test the resolved SECTION for being enabled, not just the sqm service: the
+# service is enabled in the default image while the shipped queue section is
+# not, and nss_sqm_section() falls back to the first section when none is
+# enabled - so checking the service alone burned 16s of polling and ended every
+# default boot with a WARN about a shaper nobody asked for.
+if /etc/init.d/sqm enabled; then
+  nss_sqm_section
+  sqm_attached() { tc qdisc show dev "$NSS_SQM_DEV" 2>/dev/null | grep -q nsstbl; }
+  if [ -z "$NSS_SQM_DEV" ]; then
+    echo "sqm service enabled but no queue section found"
+  elif ! [ "$(uci -q get "sqm.${NSS_SQM_SEC}.enabled")" -eq 1 ] 2>/dev/null; then
+    echo "SQM not configured (queue section '$NSS_SQM_SEC' is disabled)"
+  else
+  poll_until 16 sqm_attached
+  if sqm_attached; then
+    echo "SQM active on $NSS_SQM_DEV"
+  else
+    echo "WARN: SQM not attached on $NSS_SQM_DEV (logread | grep -i sqm)"
+  fi
+  # Report the per-port upload IGS trees (the section's igs_upload option).
+  for p in $(uci -q get "sqm.${NSS_SQM_SEC}.igs_upload"); do
+    if tc qdisc show dev "ifb-$p" 2>/dev/null | grep -q nsstbl; then
+      echo "upload IGS active: $p -> ifb-$p"
+    else
+      echo "WARN: upload IGS tree missing on ifb-$p (logread | grep upload_igs)"
+    fi
+  done
+  fi
+fi
+
+# Baseline the PPE's configuration registers now that the plane is armed and
+# settled. The per-port egress wedge is cleared only by a reboot, which points
+# at a register a reboot re-initialises and nothing else rewrites - and the only
+# way to name one of those without guessing which to suspect is to know what it
+# held when the box was healthy. Costs ~2s and one file; nss-wedge-watch diffs
+# against it at wedge time. Best effort: a missing baseline degrades the capture,
+# it must never fail a bring-up.
+nss-ppe-diff save >/dev/null 2>&1 ||
+  echo "WARN: could not baseline the PPE registers (nss-ppe-diff save)"
+
+exit 0
diff --git a/package/nss/nss-tools/files/nss-wedge-watch b/package/nss/nss-tools/files/nss-wedge-watch
new file mode 100755
index 0000000000000000000000000000000000000000..61bda3b7de0a8a18f4f7357a50dabc13e7ffd96d
--- /dev/null
+++ b/package/nss/nss-tools/files/nss-wedge-watch
@@ -0,0 +1,499 @@
+#!/bin/sh
+# nss-wedge-watch - catch a per-port NSS egress stall and capture the state that
+# names it. Two field captures of this fault dead-ended because the only thing
+# read at wedge time was the per-port packet count, which says a port is dead but
+# not why. This samples the same counters continuously and, the moment a port
+# goes egress-dead with the link still up, dumps every readout that discriminates
+# between the remaining causes - before anyone reboots.
+#
+# Detection: carrier up AND the firmware's fw->wire counter frozen AND the host
+# still handing frames to the firmware, for $HOLD consecutive samples.
+#
+# The port set comes from the live glue table, never a hardcoded range.
+
+GLUE=/sys/kernel/debug/qca-ppe-nss
+DRV=/sys/kernel/debug/qca-nss-drv
+NET=/sys/class/net
+PPE_BASE=0x3a000000
+INTERVAL="${INTERVAL:-5}"
+HOLD="${HOLD:-4}"
+# Default into the directory sysupgrade is told to keep (lib/upgrade/keep.d),
+# so a capture survives the flash that carries the fix for it.
+OUTDIR="${OUTDIR:-/root/auto-recovery}"
+
+[ -r "$GLUE/status" ] || { echo "nss-wedge-watch: NSS plane not armed" >&2; exit 1; }
+
+bootid=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | cut -c1-8)
+
+# field <line> <key>  -> value of key=value in an if_num line
+field() { echo "$1" | sed -n "s/.*$2=\([^ ]*\).*/\1/p"; }
+
+port_line() { grep "if_num $1:" "$GLUE/status" 2>/dev/null; }
+
+# firmware per-port egress / ingress (see nss-status: rx=fw->wire, tx=wire->fw)
+fw_egress()  { awk '/_rx_pkts/{print $3}' "$DRV/stats/edma/ports/$1/stats" 2>/dev/null; }
+fw_ingress() { awk '/_tx_pkts/{print $3}' "$DRV/stats/edma/ports/$1/stats" 2>/dev/null; }
+
+ports() { awk '/^if_num/ && !/netdev=-/ {sub(/:/,"",$2); print $2}' "$GLUE/status" 2>/dev/null; }
+
+reg() { devmem $(($1)) 32 2>/dev/null; }
+
+# Hardware truth for what left the wire: the MAC MIB TX frame counters, summed
+# over all three cast types because host-injected traffic on a stalled port is
+# mostly ARP/ND broadcast and would otherwise not show up at all. The MIB names
+# each of these once, so there is no ambiguity with the netdev counters ethtool
+# prints above them.
+mib_tx() {
+	ethtool -S "$1" 2>/dev/null |
+		awk '/^ *tx_(unicast|broadcast|multicast):/ {n += $2} END {print n+0}'
+}
+mib_rx() {
+	ethtool -S "$1" 2>/dev/null |
+		awk '/^ *rx_(unicast|broadcast|multicast):/ {n += $2} END {print n+0}'
+}
+
+# ---------------------------------------------------------------------------
+# Movement.
+#
+# Every other readout in this file is instantaneous, and on its own an
+# instantaneous readout cannot tell a wedged port from a busy one: a queue
+# sitting at its admission ceiling with buffer-manager flow control raised is
+# ALSO exactly what an ordinary congested port looks like (measured on the
+# bench by forcing a port to 100M under load). Whether a port is dead is a
+# question about movement, so sample the deciding counters twice and put the
+# deltas in the file. The verdict then belongs to the evidence rather than to
+# the header.
+SAMPLE="${SAMPLE:-3}"
+S1=/tmp/.nss-wedge-s1
+S2=/tmp/.nss-wedge-s2
+MV=/tmp/.nss-wedge-mv
+
+sample_ports() {
+	for p in $(ports); do
+		line=$(port_line "$p")
+		n=$(field "$line" netdev)
+		echo "$p $n $(fw_egress $p) $(fw_ingress $p) $(field "$line" tx_redirect_pkts) $(mib_tx "$n") $(mib_rx "$n")"
+	done
+}
+
+# Writes the movement table to $MV. Lines whose verdict is EGRESS-DEAD name the
+# ports that are offered traffic and put none of it on the wire.
+movement_scan() {
+	sample_ports > "$S1"
+	sleep "$SAMPLE"
+	sample_ports > "$S2"
+	{
+	echo "--- movement over ${SAMPLE}s (this is what separates wedged from congested) ---"
+	printf '  %-5s %-7s %-4s %10s %10s %10s %8s %8s  %s\n' \
+		port dev car "fw->wire" "wire->fw" "host->fw" mac_tx mac_rx verdict
+	while read -r p n a b c d e; do
+		l2=$(grep "^$p " "$S2")
+		a2=$(echo "$l2" | awk '{print $3}'); b2=$(echo "$l2" | awk '{print $4}')
+		c2=$(echo "$l2" | awk '{print $5}'); d2=$(echo "$l2" | awk '{print $6}')
+		e2=$(echo "$l2" | awk '{print $7}')
+		da=$(( ${a2:-0} - ${a:-0} )); db=$(( ${b2:-0} - ${b:-0} ))
+		dc=$(( ${c2:-0} - ${c:-0} )); dd=$(( ${d2:-0} - ${d:-0} ))
+		de=$(( ${e2:-0} - ${e:-0} ))
+		car=$(cat "$NET/$n/carrier" 2>/dev/null)
+		# Delivered is the best of the two independent "it left" counters:
+		# the firmware's own egress accounting and the MAC MIB. Compare it
+		# against what was offered rather than asking merely whether it
+		# moved - a port throttled to a trickle (measured: 1 frame put on
+		# the wire out of 37 offered, with the port shaper armed) is dead
+		# to its client, and a bare "did anything move" test calls that
+		# healthy.
+		del=$da; [ $dd -gt $del ] && del=$dd
+		if [ "$car" != 1 ]; then
+			v="link down"
+		elif [ $dc -le 0 ] && [ $db -le 0 ] && [ $de -le 0 ] && [ $del -le 0 ]; then
+			v="idle - nothing offered, inconclusive"
+		elif [ $dc -gt 0 ] && [ $del -le 0 ]; then
+			v="EGRESS-DEAD $dc offered, nothing reached the wire"
+		elif [ $dc -gt 0 ] && [ $(( del * 8 )) -lt $dc ]; then
+			v="EGRESS-GATED only $del of $dc offered reached the wire"
+		elif [ $del -gt 0 ]; then
+			v="transmitting"
+		else
+			v="receiving only - no egress offered, inconclusive"
+		fi
+		printf '  %-5s %-7s %-4s %10s %10s %10s %8s %8s  %s\n' \
+			"$p" "$n" "${car:-?}" "$da" "$db" "$dc" "$dd" "$de" "$v"
+	done < "$S1"
+	echo "  Deltas, not totals. mac_tx/mac_rx are the PPE MAC MIB frame counters"
+	echo "  (unicast+broadcast+multicast), i.e. hardware truth for what crossed"
+	echo "  the wire. The verdict weighs what reached the wire against what was"
+	echo "  offered: a port offered traffic that delivers none of it is wedged,"
+	echo "  and one that delivers a trickle is gated. A port that is transmitting"
+	echo "  is NOT wedged no matter how full its queue is - a queue pinned at the"
+	echo "  admission ceiling with buffer-manager flow control raised is also"
+	echo "  exactly what ordinary congestion looks like, so nothing below this"
+	echo "  table can be read as a wedge unless this table says so first."
+	} > "$MV"
+}
+
+# ports that measured egress-dead or throttled to a trickle in the last scan
+dead_ports() { awk '/EGRESS-DEAD|EGRESS-GATED/{print $1}' "$MV" 2>/dev/null; }
+
+capture() {
+	pn="$1"; nd="$2"; why="${3:-measured egress-dead}"
+	mkdir -p "$OUTDIR"
+	seq=0
+	while [ -e "$OUTDIR/wedge-$bootid-$seq.txt" ]; do seq=$((seq+1)); done
+	out="$OUTDIR/wedge-$bootid-$seq.txt"
+	{
+	echo "=== nss-wedge-watch: port $pn ($nd) - $why ==="
+	date; uptime; echo "boot_id=$(cat /proc/sys/kernel/random/boot_id)"
+	echo
+	[ -s "$MV" ] && { cat "$MV"; echo; }
+	# What CHANGED beats what IS. This fault survives a link cycle and a full
+	# data-plane re-attach and yields only to a reboot, so the holder is a
+	# register a reboot re-initialises and nothing else rewrites. Diffing
+	# against the baseline nss-up took while the box was healthy names such a
+	# register without anyone having had to suspect it in advance - which is
+	# the whole difficulty, because two owners share this register file.
+	echo "--- PPE configuration vs the baseline taken when this box came up ---"
+	nss-ppe-diff 2>&1
+	echo
+	echo "--- glue ---"; cat "$GLUE/status"
+	echo
+	# Every per-interface control message the host sends the firmware -
+	# open, close, link state - goes out synchronously and is abandoned
+	# after three seconds. A close that is abandoned was still delivered,
+	# so the firmware acts on it while the host records a failure, and the
+	# host's idea of that interface goes stale in the one direction that
+	# stops a port transmitting. These counters say whether that has
+	# happened on this box; both zero excludes the whole mechanism.
+	echo "--- firmware control-message health ---"
+	for k in phif_timeouts phif_stale_responses; do
+		echo "  $k = $(cat "/sys/module/qca_nss_drv/parameters/$k" 2>/dev/null)"
+	done
+	echo
+	# Each port's MAC clock branch, judged on its own rather than against a
+	# baseline: CLK_OFF asserted on a port whose carrier is up is wrong on its
+	# face, so this still answers on a box whose baseline was never taken.
+	# The driver enables these once in probe and nothing re-enables one, so a
+	# gated branch is repairable only by a reboot - measured on an AX3600,
+	# clearing one stops the port transmitting with its carrier up, its MAC TX
+	# counter at exactly zero and an admin link cycle unable to recover it.
+	echo "--- per-port MAC clock branches (bit0 enable, bit31 CLK_OFF) ---"
+	gated_clk=""
+	for p in $(ports); do
+		n=$(field "$(port_line $p)" netdev)
+		tx=$(reg $((0x01800000 + 0x68244 + (p - 1) * 8)))
+		rx=$(reg $((0x01800000 + 0x68240 + (p - 1) * 8)))
+		car=$(cat "$NET/$n/carrier" 2>/dev/null)
+		echo "  port $p ($n) carrier=${car:-?} tx=$tx rx=$rx"
+		[ "$car" = 1 ] || continue
+		for c in "tx $tx" "rx $rx"; do
+			w=${c#* }; d=${c%% *}
+			[ -n "$w" ] || continue
+			v=$(printf "%d" "$w")
+			# CLK_OFF is the whole answer: set means the branch is not
+			# running, whatever the enable bit says. The two cases point
+			# at different culprits and both are fatal to the port, so
+			# judge on bit 31 alone and let the enable bit name which.
+			# Testing "off AND disabled" would miss the more likely one:
+			# clk_set_rate() on a link event reprograms the parent RCG,
+			# and an RCG whose newly selected parent is not running fails
+			# its update and leaves the branch enabled but halted.
+			[ $(( (v >> 31) & 1 )) = 1 ] || continue
+			if [ $(( v & 1 )) = 0 ]; then
+				gated_clk="$gated_clk port $p $d (disabled);"
+			else
+				gated_clk="$gated_clk port $p $d (enabled but halted - parent/RCG);"
+			fi
+		done
+	done
+	if [ -n "$gated_clk" ]; then
+		echo "  VERDICT: a carrier-up port has its MAC clock gated ->$gated_clk"
+		echo "  Nothing in this stack re-enables one of these after probe, so this"
+		echo "  port cannot transmit again until the box is rebooted. Whoever"
+		echo "  cleared it is the fault."
+	else
+		echo "  VERDICT: every carrier-up port's MAC clock is running."
+	fi
+	echo
+	echo "--- nss-status ---"; nss-status 2>&1; nss-status -l2 2>&1
+	echo
+	# Whether the firmware ever saw the frames, and whether it dropped them on
+	# egress, is the single fact that splits a firmware-side stall from a fabric
+	# one. rx_queue[*]_drops are the egress drops and nothing was reading them.
+	echo "--- firmware EDMA: per-port stats + egress queue drops ---"
+	for p in $(ports); do
+		echo "## port $p"; cat "$DRV/stats/edma/ports/$p/stats" 2>/dev/null
+		cat "$DRV/stats/edma/ports/$p/ring_map" 2>/dev/null
+	done
+	echo "--- firmware EDMA: error stats ---"; cat "$DRV/stats/edma/err_stats" 2>/dev/null
+	echo "--- firmware EDMA: ring stats (tx / txcmpl) ---"
+	for r in "$DRV"/stats/edma/rings/tx/* "$DRV"/stats/edma/rings/txcmpl/*; do
+		[ -e "$r" ] && cat "$r" 2>/dev/null
+	done
+	echo
+	echo "--- firmware log ring ---"; cat "$DRV/logs/core0" 2>/dev/null
+	echo "--- firmware pbuf pools (n2h) ---"; cat "$DRV/stats/n2h" 2>/dev/null
+	echo
+	echo "--- PPE drop codes / punt reasons, per port ---"
+	for p in $(ports); do
+		echo "## port $p drop"; awk '$2=="=" && $3+0>0' "$DRV/stats/ppe/code/drop/$p" 2>/dev/null
+	done
+	cat "$DRV/stats/ppe/code/cpu/exception" 2>/dev/null
+	cat "$DRV/stats/ppe/code/cpu/non-exception" 2>/dev/null
+	echo
+	# The host writes these and then never touches them again, so if one is wrong
+	# at wedge time the firmware changed it underneath us - that is the whole
+	# dual-ownership question, and it has never been read on a wedged box.
+	echo "--- PPE per-port egress gates (host-owned, read back) ---"
+	echo "LPI_ENABLE        = $(reg $((PPE_BASE + 0x400)))   (0 = PPE-side 802.3az off, the healthy value)"
+	for p in $(ports); do
+		echo "port $p: PORT_BRIDGE_CTRL=$(reg $((PPE_BASE + 0x060300 + p * 4))) \
+CST_STATE=$(reg $((PPE_BASE + 0x060100 + p * 4))) \
+MRU_MTU_CTRL=$(reg $((PPE_BASE + 0x063000 + p * 0x10)))"
+	done
+	echo
+	# A stalled port that counts nothing is holding, not dropping, and the two
+	# things that hold a port are buffer-manager flow control and the queue
+	# admission ceiling. Neither counts a packet, so only these registers show
+	# it. PORT_FC_STATUS is read-only hardware state; a non-zero fc field on a
+	# port that cannot transmit is the answer.
+	# The BM tables are indexed by BM port, NOT by PPE port: BM 0-7 belong to
+	# EDMA, BM 8-13 are physical ports 1-6, BM 14 is EIP (upstream's own
+	# comment above ipq9574_ppe_bm_port_config). Reading them at the raw port
+	# number - which this did until it was checked against that map - reports
+	# EDMA's entries under a physical port's name, so every earlier field
+	# reading of "fc" here described the wrong port and meant nothing.
+	echo "--- BM per-port flow control (bm = port + 7) ---"
+	for p in $(ports); do
+		bm=$((p + 7))
+		v=$(reg $((PPE_BASE + 0x600140 + bm * 4)))
+		echo "port $p (bm $bm): PORT_FC_STATUS=$v fc=$(( (v >> 16) & 3 ))  \
+cfg_W0=$(reg $((PPE_BASE + 0x601000 + bm * 0x10))) \
+cfg_W1=$(reg $((PPE_BASE + 0x601000 + bm * 0x10 + 4)))  \
+FC_MODE=$(reg $((PPE_BASE + 0x600100 + bm * 4)))"
+	done
+	echo
+	# The per-queue enqueue and dequeue enables. Qualcomm's own PPE driver
+	# clears both of these for every queue when it configures the QM
+	# ("Enable enqueue" / "Enable dequeue", ppe_config.c); this stack never
+	# writes either register, so whatever holds them is never put back. A
+	# queue with DEQ_DISABLE set is never serviced: it fills, its port's MAC
+	# transmits nothing, and no counter anywhere records a loss - which is
+	# this fault exactly. Measured 0 on all 300 queues of a healthy box, so
+	# the reset default is fine and a 1 here names a writer, not a default.
+	# Three registers, disambiguated against qca-ssdk's own headers:
+	#   DEQ_DIS_TBL    qos 0x30000 + 0x400000 = 0x430000
+	#   OQ_ENQ_OPR_TBL qm  0x5c000 + 0x800000 = 0x85c000
+	#   OQ_DEQ_OPR_TBL qm  0x64000 + 0x800000 = 0x864000
+	# ssdk's adpt_hppe_queue_flush() disables the first two as a pair and
+	# leaves re-enabling to its caller, with two error returns that exit
+	# with the queue still disabled - so a stuck bit here is a flush that
+	# never finished.
+	echo "--- per-queue enqueue/dequeue enables (bit0 set = DISABLED) ---"
+	for p in $(ports); do
+		qb=$(( ($(reg $((PPE_BASE + 0x810000 + p * 0x10))) >> 4) & 0xff ))
+		dd=""; de=""; q=$qb
+		while [ $q -lt $((qb + 16)) ]; do
+			[ $(( $(reg $((PPE_BASE + 0x430000 + q * 0x10))) & 1 )) = 1 ] && dd="$dd $q"
+			[ $(( $(reg $((PPE_BASE + 0x85c000 + q * 0x10))) & 1 )) = 1 ] && de="$de $q"
+			q=$((q + 1))
+		done
+		do=""; q=$qb
+		while [ $q -lt $((qb + 16)) ]; do
+			[ $(( $(reg $((PPE_BASE + 0x864000 + q * 0x10))) & 1 )) = 1 ] && do="$do $q"
+			q=$((q + 1))
+		done
+		echo "port $p queues $qb..$((qb + 15)): DEQ_DIS=[${dd:- none}] ENQ_DIS=[${de:- none}] OQ_DEQ_OPR=[${do:- none}]"
+	done
+	echo
+	# Queue occupancy is instantaneous and reads 0 on a healthy box; a value
+	# pinned at the admission ceiling is a queue that is never drained. The
+	# port's queue base is read back out of the QM unicast map rather than
+	# assumed, so this works on any IPQ807x port layout.
+	#
+	# Then the layer that decides the dequeue, which is where this fault lives.
+	# Three shapers can stop a queue draining - the queue's own L0 shaper, the L1
+	# node it feeds, and the port shaper - and so can a zero DRR weight on that L1
+	# node. Reproduced on an AX3600 by arming PSCH_SHP_CFG_TBL for one port with
+	# cir=1: the queue pinned at 252, the buffer manager raised flow control, the
+	# firmware's egress counter and the MAC MIB TX both froze, and an "ip link
+	# down/up" did not recover it - the field capture of this wedge exactly. A
+	# negative shaper credit outlives clearing SHAPER_ENABLE (measured: the port
+	# stays dead until the credit and sign are reset too), so all three are read.
+	#
+	# We program no PPE shaper anywhere and every one of these reads zero on a
+	# healthy armed box, so a non-zero value here is somebody else's write. The one
+	# known writer is the vendor's own nss_qdisc PPE mode (nss_ppe.c
+	# nss_ppe_port_shaper_set(), reached by a root nsstbl/nsshtb on a physical port
+	# when accel_mode is left at its iproute2 default of PPE): it arms the shaper
+	# with cir = rate/1000*8 - zero for "no rate given", which is degenerate, not
+	# unlimited - and its reset path zeroes only the config, never the tokens it
+	# pre-loaded, which is why the credit stays in debt. That object is compiled out
+	# of this build (NSS_QDISC_PPE_ENABLE=n), so the cir value discriminates: 0 or a
+	# multiple of 8 is consistent with it, anything else is not.
+	#
+	# The L1 tables are indexed by the L0 SP node id, NOT by the port: this dump
+	# used to read L1_FLOW_MAP(port) and got unrelated entries, because index 1..6
+	# are unprogrammed and the ports live at 36,37,40,41,... The id comes out of the
+	# queue's own L0_FLOW_MAP sp_id field, so no per-board table is needed.
+	# Offsets are relative to TRAFFIC_MANAGER_BASE_ADDR 0x400000, from qca-ssdk
+	# NHSS.QSDK.14.0.r8 hppe_shaper_reg.h: L0 shaper cfg 0x1c000 credit 0x1a000,
+	# L1 shaper cfg 0x5e000 credit 0x5c000, port shaper sign 0x70000 credit 0x72000
+	# cfg 0x74000, 0x10 per entry.
+	echo "--- QM per-queue occupancy + egress scheduler/shapers, per port ---"
+	echo "   global shaper slots: L0=$(reg $((PPE_BASE + 0x400010))) \
+L1=$(reg $((PPE_BASE + 0x400014))) PORT=$(reg $((PPE_BASE + 0x400018)))"
+	gated=""
+	for p in $(ports); do
+		qb=$(( ($(reg $((PPE_BASE + 0x810000 + p * 0x10))) >> 4) & 0xff ))
+		echo "## port $p (queues $qb..$((qb + 15)))"
+		pw0=$(reg $((PPE_BASE + 0x474000 + p * 0x10)))
+		pw1=$(reg $((PPE_BASE + 0x474000 + p * 0x10 + 4)))
+		pen=$(( (${pw1:-0} >> 4) & 1 ))
+		pneg=$(( $(reg $((PPE_BASE + 0x470000 + p * 0x10))) & 1 ))
+		echo "   PORT shaper en=$pen neg=$pneg cir=$(( ${pw0:-0} & 0x3ffff )) \
+cfg=$pw0/$pw1 credit=$(reg $((PPE_BASE + 0x472000 + p * 0x10)))"
+		[ "$pen" = 1 ] || [ "$pneg" = 1 ] &&
+			gated="$gated port $p (port shaper en=$pen neg=$pneg);"
+		q=$qb
+		while [ $q -lt $((qb + 16)) ]; do
+			# The L0/L1 shaper enable is C_SHAPER_ENABLE at bit 68 of
+			# the entry, i.e. word 2 bit 4 - word 1 there is EIR, and
+			# reading it would report a rate bit as an enable. Their
+			# negative-credit flag is bit 30 of the credit word itself
+			# (the port shaper alone has a separate sign table).
+			#
+			# These are multi-word table entries behind a read shadow:
+			# reading word 0 latches the entry, and only then do the
+			# later words belong to it. Jumping straight to word 2
+			# returns whichever entry was latched last, which reads as
+			# every port having an armed shaper.
+			reg $((PPE_BASE + 0x41c000 + q * 0x10)) >/dev/null
+			reg $((PPE_BASE + 0x41c000 + q * 0x10 + 4)) >/dev/null
+			l0e=$(( ($(reg $((PPE_BASE + 0x41c000 + q * 0x10 + 8))) >> 4) & 1 ))
+			l0c=$(reg $((PPE_BASE + 0x41a000 + q * 0x10)))
+			# empty=1 with occ>0 means the admission counter leaked
+			# rather than the queue holding anything - a different
+			# fault from a queue that is never dequeued, and the two
+			# are indistinguishable from occupancy alone.
+			echo "   q$q occ=$(( $(reg $((PPE_BASE + 0x84e000 + q * 0x10))) & 4095 )) \
+empty=$(( $(reg $((PPE_BASE + 0x86c000 + q * 0x10))) & 1 )) \
+drop_state=$(reg $((PPE_BASE + 0x856000 + q * 0x10))) \
+AC_W0=$(reg $((PPE_BASE + 0x848000 + q * 0x10))) \
+L0_FLOW=$(reg $((PPE_BASE + 0x402000 + q * 0x10))) \
+L0_PORT=$(reg $((PPE_BASE + 0x408000 + q * 0x10))) \
+L0_shp_en=$l0e credit=$l0c neg=$(( (${l0c:-0} >> 30) & 1 ))"
+			[ "$l0e" = 1 ] && gated="$gated port $p (q$q L0 shaper);"
+			q=$((q + 1))
+		done
+		# The two L1 nodes this port's queues feed, addressed by the SP id the
+		# port's first queue reports rather than by the port number.
+		sp=$(( $(reg $((PPE_BASE + 0x402000 + qb * 0x10))) & 0x3f ))
+		for s in $sp $((sp + 1)); do
+			lf=$(reg $((PPE_BASE + 0x440000 + s * 0x10)))
+			reg $((PPE_BASE + 0x45e000 + s * 0x10)) >/dev/null
+			reg $((PPE_BASE + 0x45e000 + s * 0x10 + 4)) >/dev/null
+			len=$(( ($(reg $((PPE_BASE + 0x45e000 + s * 0x10 + 8))) >> 4) & 1 ))
+			lc=$(reg $((PPE_BASE + 0x45c000 + s * 0x10)))
+			cdrr=$(( (${lf:-0} >> 10) & 0x3ff ))
+			echo "   L1 sp$s port=$(( $(reg $((PPE_BASE + 0x446000 + s * 0x10))) & 0xf )) \
+flow=$lf sp_id=$(( ${lf:-0} & 0xf )) c_drr=$cdrr e_drr=$(( (${lf:-0} >> 20) & 0x3ff )) \
+shp_en=$len credit=$lc neg=$(( (${lc:-0} >> 30) & 1 ))"
+			[ "$len" = 1 ] && gated="$gated port $p (L1 sp$s shaper);"
+			[ "$cdrr" = 0 ] && gated="$gated port $p (L1 sp$s c_drr=0);"
+		done
+	done
+	if [ -n "$gated" ]; then
+		echo "   VERDICT: the egress scheduler is gated ->$gated"
+		echo "   The port scheduler will not dequeue those ports, and a link cycle"
+		echo "   does not clear it. Nothing in this build writes a PPE shaper; the"
+		echo "   vendor nss_qdisc PPE path that does is compiled out here, and it"
+		echo "   can only ever write cir=0 or a multiple of 8 (rate/1000*8)."
+	else
+		echo "   VERDICT: no shaper armed, no zero DRR weight - the egress"
+		echo "   scheduler is not what is holding this port."
+	fi
+	echo
+	echo "--- per-port MAC MIB (hardware truth for what left the wire) ---"
+	for p in $(ports); do
+		n=$(field "$(port_line $p)" netdev)
+		[ -n "$n" ] && { echo "## $n"; ethtool -S "$n" 2>/dev/null; }
+	done
+	echo
+	echo "--- qdiscs ---"; tc -s qdisc show 2>/dev/null
+	echo "--- links ---"; ip -br link
+	echo "--- dmesg ---"; dmesg
+	echo "--- logread ---"; logread | tail -400
+	} > "$out" 2>&1
+	logger -t nss-wedge-watch "port $pn ($nd) egress dead - state captured in $out"
+	echo "$out"
+}
+
+# One-shot: capture right now, for someone sitting in front of a wedged box.
+# This is the mode to hand a reporter - it takes the same dump the watcher takes,
+# without needing the watcher to have been running beforehand.
+if [ "${1:-}" = "-1" ] || [ "${1:-}" = "--now" ]; then
+	movement_scan
+	pn="${2:-}"
+	why="measured egress-dead"
+	if [ -n "$pn" ]; then
+		dead_ports | grep -qx "$pn" ||
+			why="port named on the command line, NOT measured egress-dead"
+	else
+		# Pick a port that actually measured dead. If none did, still take
+		# the dump - a reference capture of a healthy box is useful - but
+		# say so, because a capture that claims a wedge it never observed
+		# is worse than no capture at all.
+		pn=$(dead_ports | head -1)
+		if [ -z "$pn" ]; then
+			for p in $(ports); do
+				n=$(field "$(port_line $p)" netdev)
+				[ "$(cat "$NET/$n/carrier" 2>/dev/null)" = 1 ] &&
+					{ pn="$p"; break; }
+			done
+			why="REFERENCE CAPTURE - no port measured egress-dead"
+		fi
+	fi
+	[ -n "$pn" ] || { echo "nss-wedge-watch: no link-up port" >&2; exit 1; }
+	out=$(capture "$pn" "$(field "$(port_line $pn)" netdev)" "$why")
+	echo "$out"
+	awk 'NR<=3' "$MV" >&2
+	exit 0
+fi
+
+logger -t nss-wedge-watch "armed (interval ${INTERVAL}s, hold ${HOLD})"
+
+# per-port previous sample and frozen-run length, kept in shell vars addressed by
+# port number (busybox ash has no arrays).
+while :; do
+	for pn in $(ports); do
+		line=$(port_line "$pn")
+		nd=$(field "$line" netdev)
+		[ -n "$nd" ] && [ "$nd" != "-" ] || continue
+		[ "$(cat "$NET/$nd/carrier" 2>/dev/null)" = 1 ] || continue
+
+		eg=$(fw_egress "$pn"); htx=$(field "$line" tx_redirect_pkts)
+		[ -n "$eg" ] && [ -n "$htx" ] || continue
+
+		peg=""; phtx=""; run=0
+		eval "peg=\${eg_$pn:-}"
+		eval "phtx=\${htx_$pn:-}"
+		eval "run=\${run_$pn:-0}"
+		if [ -n "$peg" ] && [ -n "$phtx" ]; then
+			# egress frozen while the host is still feeding the firmware
+			if [ "$eg" = "$peg" ] && [ "$htx" -gt "$phtx" ]; then
+				run=$((run + 1))
+			else
+				run=0
+			fi
+		fi
+		eval "eg_$pn=\$eg" ; eval "htx_$pn=\$htx" ; eval "run_$pn=\$run"
+
+		if [ "$run" -ge "$HOLD" ]; then
+			movement_scan
+			capture "$pn" "$nd" \
+				"egress frozen for $((HOLD * INTERVAL))s while the host kept feeding it" \
+				>/dev/null
+			eval "run_$pn=0"
+		fi
+	done
+	sleep "$INTERVAL"
+done
diff --git a/package/nss/nss-tools/files/nss.init b/package/nss/nss-tools/files/nss.init
new file mode 100755
index 0000000000000000000000000000000000000000..55ee2b14d796d45ee30a6b57782829c4203530c2
--- /dev/null
+++ b/package/nss/nss-tools/files/nss.init
@@ -0,0 +1,87 @@
+#!/bin/sh /etc/rc.common
+# START and USE_PROCD are read by /etc/rc.common, not by this file.
+# shellcheck disable=SC2034
+# NSS offload data-plane bring-up, split around netifd.
+#
+# start_service (START=19, before netifd): make the data-path decision once
+# and load Wi-Fi accordingly. With nss.general.enabled unset/'1' the wired
+# plane is armed first (glue -> fw_mask -> qca-nss-drv; the fw_mask write
+# boots the firmware synchronously), the pbuf n2h/clock tuning is applied,
+# and ath11k loads with nss_offload=1 - the radios bind once, straight onto
+# the NSS data path (wifili), with no later rebind and exactly one WCSS
+# remoteproc boot. With enabled='0', or when arming fails, ath11k loads in
+# plain host mode. ath11k has no module autoload in this tree - this
+# service brings Wi-Fi up on either path; wired EDMA networking never
+# depends on it.
+#
+# The rest of the plane - bridge/multicast/ECM/PPPoE managers, WAN, SQM -
+# is layered on by the /usr/sbin/nss-up instance once netifd has built the
+# topology. A reboot always re-runs this decision; to stay on the host
+# stack permanently:
+#   uci set nss.general.enabled='0'; uci commit nss
+# (the uci flag survives sysupgrade, unlike an rc.d disable).
+
+START=19
+USE_PROCD=1
+
+NSSOFF=/sys/module/ath11k/parameters/nss_offload
+
+wifi_load_host() {
+	modprobe ath11k 2>/dev/null
+	[ -w $NSSOFF ] && echo 0 > $NSSOFF
+	modprobe ath11k_ahb 2>/dev/null
+	modprobe ath11k_pci 2>/dev/null
+}
+
+start_service() {
+	local wifi_offload=1
+	if [ "$(uci -q get nss.general.enabled)" = "0" ]; then
+		logger -t nss "NSS bring-up disabled via uci (nss.general.enabled=0), staying on the host stack"
+		wifi_load_host
+		return 0
+	fi
+
+	. /lib/nss/functions.sh
+	# 802.11s mesh is offloadable only on the mesh-capable firmware line
+	# with a mesh-enabled build; otherwise mesh keeps Wi-Fi on the host
+	# path while the wired offload still arms - mesh works normally there.
+	nss_mesh_state
+	if [ "$NSS_MESH_CFG" = 1 ] && [ "$NSS_MESH_CAPABLE" != 1 ]; then
+		logger -t nss "mesh interface configured: Wi-Fi stays on the host path (mesh offload needs the 11.4 NSS firmware and a mesh-enabled build)"
+		wifi_offload=0
+	fi
+
+	modprobe qca-ppe-nss 2>/dev/null
+	modprobe qca-nss-drv 2>/dev/null
+	FWM=/sys/kernel/debug/qca-ppe-nss/fw_mask
+	# "all" arms every wired port the board exposes - the glue discovers
+	# the per-device DSA port<->if_num map from the live topology, so this
+	# works across the ipq807x family with no board-specific mask.
+	[ "$(cat $FWM 2>/dev/null)" = "0x0" ] && echo all > $FWM 2>/dev/null
+	if [ "$(cat $FWM 2>/dev/null || echo 0x0)" = "0x0" ]; then
+		logger -t nss "firmware arming failed - staying on the host stack"
+		wifi_load_host
+		return 0
+	fi
+
+	# Order matters: the n2h pool/clock tuning goes in before the radios
+	# bind, so the wifili registration already sees the tuned pool and no
+	# Wi-Fi reload is needed afterwards. pbuf self-gates on nss_offload,
+	# so a host-path Wi-Fi decision skips the Wi-Fi pool tuning by itself.
+	modprobe ath11k 2>/dev/null
+	[ -w $NSSOFF ] && echo "$wifi_offload" > $NSSOFF
+	/etc/init.d/qca-nss-pbuf start >/dev/null 2>&1
+	modprobe ath11k_ahb 2>/dev/null
+	modprobe ath11k_pci 2>/dev/null
+
+	procd_open_instance nss-up
+	procd_set_param command /usr/sbin/nss-up
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
+
+stop_service() {
+	echo "The NSS plane cannot be detached at runtime; reboot to return to the host stack."
+	echo "To keep it off across reboots: uci set nss.general.enabled='0'; uci commit nss"
+}
diff --git a/package/nss/nss-tools/files/nss.sysctl b/package/nss/nss-tools/files/nss.sysctl
new file mode 100644
index 0000000000000000000000000000000000000000..02d82f32417cf62247c67a6e363fbfe6b4c703f1
--- /dev/null
+++ b/package/nss/nss-tools/files/nss.sysctl
@@ -0,0 +1,34 @@
+# With firmware RPS and the Linux RPS fan-out, bursts to host-terminated
+# flows land on the per-CPU receive backlogs; the 1000-packet default
+# overflows at line-rate bursts (softnet_stat column-2 drops). 4096 absorbs
+# them with no measured drops at ~1.5 Gbit/s offered.
+net.core.netdev_max_backlog=4096
+
+# Default RPS mask applied to every rx queue at creation, so it needs no
+# re-application when a netdev is recreated. Mask 'e' = cores 1-3: every ipq807x
+# is a quad A53, and core 0 is left to the N2H queue-0 NAPI that firmware RPS
+# hashes host-terminated flows onto.
+# This service runs at START=11, before netifd, so it covers every delivery netdev
+# created afterwards: the bridges, pppoe-wan and the IGS ifb devices. The wired
+# ports exist before it runs and keep the kernel default, which is correct - under
+# offload their traffic never reaches a host softirq.
+#
+# The Wi-Fi VAPs are deliberately NOT ours to set. OpenWrt's own packet_steering
+# service owns rps_cpus for every netdev that has a device symlink and no lower_*
+# - on ipq807x the Wi-Fi VAPs and the EDMA conduit netdev - and it re-runs on
+# every interface.* event. We set network.globals.packet_steering='0'
+# (98-nss-offload, and qca-nss-ecm's init forces it again on every start and on
+# its network/packet_steering reload triggers), and in that mode it writes 0 to
+# those queues - so any VAP rps_cpus we set is erased again within a second.
+#
+# That override is measured, not assumed. Leaving the service at its default
+# puts the VAPs on core 3, the EDMA conduit on core 2 and the conduit NAPI
+# thread on core 0. On a Wi-Fi client to wired host flow through the router,
+# two runs each: with the service disabled 749 and 800 Mbit/s and no n2h queue
+# drops; with it at its default 619 and 626 Mbit/s and 158 then 83 fresh
+# n2h_rx_queue drops. Its placement fights firmware RPS, which already hashes
+# host-terminated flows onto the N2H queues this mask is shaped around.
+#
+# Do not add a writer to fight the service either - configure the service, as
+# 98-nss-offload does.
+net.core.rps_default_mask=e
diff --git a/package/nss/nss-tools/files/nssqos-conns b/package/nss/nss-tools/files/nssqos-conns
new file mode 100755
index 0000000000000000000000000000000000000000..3f3c345b072a45f965f212628e555f5f4e2f4a56
--- /dev/null
+++ b/package/nss/nss-tools/files/nssqos-conns
@@ -0,0 +1,46 @@
+#!/bin/sh
+# Emit the conntrack table as JSON for the LuCI "NSS Connections" viewer.
+# Works for NSS-accelerated flows too: ECM periodically syncs their packet
+# and byte counters back into conntrack, so rate deltas computed from two
+# samples reflect offloaded traffic. The DSCP class of connections marked
+# by nssqos rides in the ct mark (dscp | 0x80, qosmate-compatible).
+
+exec awk '
+BEGIN { printf "[" ; first = 1 }
+/^ipv[46]/ {
+	fam = $1; proto = $3; timeout = $5
+	state = ""
+	# tuples/counters appear twice: first = original, second = reply.
+	# awk arrays persist across records - clear them or absent fields
+	# (e.g. counters with acct off) would leak stale values.
+	delete src; delete dst; delete sport; delete dport
+	delete pkts; delete bytes
+	pkts[1] = 0; pkts[2] = 0; bytes[1] = 0; bytes[2] = 0
+	ns = 0; np = 0; nb = 0; nsp = 0; ndp = 0; nd = 0
+	mark = 0
+	for (i = 6; i <= NF; i++) {
+		if (index($i, "=") == 0) {
+			if (state == "" && $i !~ /^\[/) state = $i
+			continue
+		}
+		split($i, kv, "=")
+		k = kv[1]; v = kv[2]
+		if (k == "src") src[++ns] = v
+		else if (k == "dst") dst[++nd] = v
+		else if (k == "sport") sport[++nsp] = v
+		else if (k == "dport") dport[++ndp] = v
+		else if (k == "packets") pkts[++np] = v
+		else if (k == "bytes") bytes[++nb] = v
+		else if (k == "mark") mark = v
+	}
+	# require the full original tuple; counters may be absent without acct
+	if (ns < 1 || nsp < 1) next
+	if (!first) printf ","
+	first = 0
+	printf "{\"family\":\"%s\",\"proto\":\"%s\",\"state\":\"%s\",\"timeout\":%d,", fam, proto, state, timeout
+	printf "\"src\":\"%s\",\"sport\":%d,\"dst\":\"%s\",\"dport\":%d,", src[1], sport[1], dst[1], dport[1]
+	printf "\"orig_pkts\":%d,\"orig_bytes\":%d,\"repl_pkts\":%d,\"repl_bytes\":%d,", pkts[1], bytes[1], pkts[2], bytes[2]
+	printf "\"mark\":%d}", mark
+}
+END { printf "]\n" }
+' /proc/net/nf_conntrack 2>/dev/null
diff --git a/package/nss/nss-tools/files/nssqos-resolve b/package/nss/nss-tools/files/nssqos-resolve
new file mode 100644
index 0000000000000000000000000000000000000000..c80a8b56b8434a7203676b1e7bfec40e0a6e784e
--- /dev/null
+++ b/package/nss/nss-tools/files/nssqos-resolve
@@ -0,0 +1,80 @@
+#!/bin/sh
+# Resolves the 'domain' lists of /etc/config/nssqos rules into the nft sets
+# <rule>_v4 / <rule>_v6 of table inet nssqos (declared by the nssqos
+# service render). 'once' runs a single pass (the service uses it right
+# after every (re)render so the sets never sit empty); without arguments it
+# loops as the procd resolver instance, re-reading the config every tick.
+#
+# Standalone on purpose, NOT an /etc/init.d/nssqos extra command: a
+# long-lived instance routed through rc.common inherits the procd service
+# lock fd and deadlocks every later start/stop/reload of the service.
+
+SETFILE=/var/etc/nssqos-sets.nft
+
+# Names of enabled rules carrying at least one 'domain' entry.
+domain_rules() {
+	uci -q show nssqos | sed -n 's/^nssqos\.\([^.]*\)\.domain=.*/\1/p' | \
+	while read -r s; do
+		[ "$(uci -q get "nssqos.$s.enabled")" = 1 ] && echo "$s"
+	done
+}
+
+# All A/AAAA answers for one name, one per line (busybox nslookup; the
+# 'answer:' anchor skips the resolver's own Server/Address header).
+resolve_name() {
+	nslookup "$1" 2>/dev/null | sed -n '/answer:/,$p' | awk '/^Address/{print $NF}'
+}
+
+# One resolve pass: atomically swap every domain rule's set elements (one
+# nft transaction). A name that stops resolving keeps its last-known
+# elements rather than dropping coverage on a DNS hiccup.
+pass() {
+	local cfg d a v4 v6 batch=""
+	[ "$(uci -q get nssqos.global.enabled)" = 0 ] && return 0
+	for cfg in $(domain_rules); do
+		v4="" v6=""
+		for d in $(uci -q get "nssqos.$cfg.domain"); do
+			for a in $(resolve_name "$d"); do
+				# DNS answers are attacker-influenced and go verbatim
+				# into the root `nft -f` batch below; accept only IP
+				# literals so a crafted record can't inject ruleset
+				# statements (and junk tokens don't fail the batch).
+				case "$a" in
+				*[!0-9A-Fa-f:./]*) continue ;;
+				*:*) v6="$v6 $a" ;;
+				*) v4="$v4 $a" ;;
+				esac
+			done
+		done
+		v4=$(echo $v4 | tr ' ' '\n' | sort -u | xargs)
+		v6=$(echo $v6 | tr ' ' '\n' | sort -u | xargs)
+		[ -n "$v4" ] && batch="$batch
+flush set inet nssqos ${cfg}_v4
+add element inet nssqos ${cfg}_v4 { $(echo "$v4" | sed 's/ /, /g') }"
+		[ -n "$v6" ] && batch="$batch
+flush set inet nssqos ${cfg}_v6
+add element inet nssqos ${cfg}_v6 { $(echo "$v6" | sed 's/ /, /g') }"
+	done
+	[ -n "$batch" ] || return 0
+	mkdir -p "$(dirname "$SETFILE")"
+	echo "$batch" > "$SETFILE"
+	nft -f "$SETFILE" || logger -t nssqos "domain set update failed"
+}
+
+if [ "$1" = "once" ]; then
+	pass
+	exit 0
+fi
+
+while :; do
+	pass
+	# Clamp the tick. resolve_interval is user- and ACL-writable, and the
+	# default-only fallback covered just the unset case: a 0 sleeps not at
+	# all, and a non-numeric value makes busybox sleep fail and return
+	# immediately - either way this becomes a tight loop of DNS lookups and
+	# root `nft -f` transactions. Anything that is not a sane number of
+	# seconds falls back to the default.
+	interval=$(uci -q get nssqos.global.resolve_interval)
+	[ "$interval" -ge 30 ] 2>/dev/null || interval=300
+	sleep "$interval"
+done
diff --git a/package/nss/nss-tools/files/nssqos.config b/package/nss/nss-tools/files/nssqos.config
new file mode 100644
index 0000000000000000000000000000000000000000..203a1eb86c181494228f2c53263704e8052c2586
--- /dev/null
+++ b/package/nss/nss-tools/files/nssqos.config
@@ -0,0 +1,245 @@
+# NSS QoS marking - DSCP marking and fast-lane prioritization for the
+# NSS-accelerated SQM (see Status -> NSS Offload and the wiki's SQM page).
+#
+# Each enabled rule marks BOTH directions of matching connections: once as
+# written and once with source/destination mirrored. Marking survives NSS
+# acceleration: the firmware rewrites the DSCP field and steers the flow
+# into the SQM fast lane on offloaded packets too.
+#
+# What a DSCP class buys you on this router (three separate effects):
+#   1. WAN fast lane - classes cs4/cs5/cs6/cs7/ef/va take a strict-priority
+#      lane ahead of the SQM queue in both directions (that is the ONLY
+#      WAN-queue effect of the value; the shaper itself is single-tin).
+#   2. Wi-Fi WMM - mac80211 maps DSCP to a Wi-Fi access category:
+#      ef/cs6/cs7 -> Voice, cs4/cs5/af4x/cs3/af3x -> Video, cs1 -> Background.
+#      So marking helps the air even though the WAN shaper is single-tin.
+#   3. Wire mark - what leaves toward the ISP / downstream devices. ISPs
+#      routinely bleach this, so egress marks are effectively local-only;
+#      the fast lane rides an internal priority mark, not the wire DSCP.
+#
+# Classes follow RFC 4594 service classes: one class per traffic role, no
+# contradictions (all interactive gaming is cs4, all voice is ef, etc.).
+#
+# Rule options:
+#   name       - free-form label
+#   enabled    - '1' to activate, '0' to keep as an inert example
+#   proto      - 'udp', 'tcp' or 'tcpudp'
+#   src_ip     - source host(s)/CIDR(s), space-separated, IPv4 and/or
+#                IPv6 (optional; mixed lists render one rule per family)
+#   dest_ip    - destination host(s)/CIDR(s), same syntax (optional)
+#   src_port   - source port(s): '443', '27015-27030', '80 443' (optional)
+#   dest_port  - destination port(s), same syntax (optional)
+#   domain     - destination DNS name(s), one per 'list domain' line
+#                (optional). The router resolves them itself and keeps a
+#                per-rule address set fresh (re-resolved every
+#                resolve_interval seconds), so this works no matter which
+#                DNS server the clients use. Covers CDNs whose per-stream
+#                subdomains resolve to the zone's shared front-end
+#                addresses: one apex name matches every edge host.
+#                Combines with dest_ip (either matches) and src_ip
+#                (must also match).
+#   class      - DSCP class: cs0-cs7, af11-af43, ef, va, le
+#   fastlane   - 'auto' (default: on for cs4/cs5/cs6/cs7/ef/va), '1' or '0'.
+#                Fast-laned flows bypass the SQM queue in both directions;
+#                mark sparse traffic only (games, calls, DNS) - a bulk
+#                download in the fast lane starves everything else.
+
+# Global options:
+#   enabled      - master switch
+#   wash_ingress - '1': reset untrusted inbound DSCP to CS0 (marking rules
+#                  below still re-mark what they match). Left off: the
+#                  download re-marks are what drive Wi-Fi WMM on this stack.
+#   wash_egress  - '1': send everything to the ISP as CS0; fast-lane
+#                  steering survives (it rides the priority mark)
+#   wan_device   - override the WAN L3 device for the wash rules. The
+#                  auto-detection assumes the conventional logical interface
+#                  name 'wan' (pppoe-wan on PPPoE, else network.wan.device);
+#                  set this if your WAN interface is named differently.
+#   resolve_interval - seconds between re-resolves of 'domain' rules. Minimum
+#                30; a smaller or unparsable value falls back to 300, because
+#                each pass is a DNS round and a root nft transaction and a 0
+#                would spin.
+#                  (default 300)
+
+config global 'global'
+	option enabled '1'
+	option wash_ingress '0'
+	option wash_egress '0'
+
+# --- Active by default: sparse, latency-critical, low false-positive -------
+
+# DNS - tiny, sparse and latency-critical: a textbook fast-lane candidate.
+# Matches any resolver (ISP, public, or a local forwarder the firewall
+# DNATs to); the mirrored reply direction is covered automatically, and
+# port 853 also catches DoT.
+config rule
+	option name 'DNS'
+	option enabled '1'
+	option proto 'tcpudp'
+	option dest_port '53 853'
+	option class 'cs5'
+
+# Real-Time Interactive (RFC 4594 CS4) - the single class for ALL interactive
+# gaming, consoles and PC alike. Xbox / CoD game-state on UDP 3074 (older CoD
+# titles use up to 3079), CoD-PC via Battle.net on 20500/20510/28960 plus the
+# classic Blizzard range 6112-6119; CoD on Steam rides the Steam rule below.
+# NOT matched on purpose: shared STUN 3478-3480 (Teams/Zoom/WebRTC media
+# would land in the fast lane), the Xbox IPsec/Teredo transports 500/4500/
+# 3544 (real VPN tunnels ride the same ports), and PSN's dynamic
+# 49152-65535 game range.
+config rule
+	option name 'Game consoles / Call of Duty'
+	option enabled '1'
+	option proto 'udp'
+	option dest_port '3074-3079 6112-6119 20500 20510 28960'
+	option class 'cs4'
+
+# Valve's game-traffic + voice envelope (game traffic / SDR relays UDP
+# 27000-27250; Steamworks P2P/voice 4379-4380). UDP only: bulk Steam
+# DOWNLOADS ride HTTP/TCP and must never enter the fast lane.
+config rule
+	option name 'PC games - Steam/Source/CS2'
+	option enabled '1'
+	option proto 'udp'
+	option dest_port '27000-27250 4379 4380'
+	option class 'cs4'
+
+# Riot game-state (League 5000-5500 + 7000-8000, Valorant 7000-8000 +
+# 8180-8181). The client/chat/patcher (TCP 2099/5222-5223/8088) and the
+# in-game voice ports (dynamic 50-port window anywhere in 1024-65000) are
+# deliberately not matched - only the UDP game stream belongs in the lane.
+config rule
+	option name 'PC games - Riot (League/Valorant)'
+	option enabled '1'
+	option proto 'udp'
+	option dest_port '5000-5500 7000-8000 8180-8181'
+	option class 'cs4'
+
+# MS Teams media rides UDP 3478-3481 to Microsoft's Teams relays (the
+# 'Optimize' row, ID 11, of the M365 endpoint list). Scoping to the relay
+# CIDRs disambiguates 3478 from console/game STUN. The 50000-50059 client
+# port ranges are NOT matched: they only exist when a tenant admin pins
+# them - the client default is random source ports.
+config rule
+	option name 'Video call - MS Teams'
+	option enabled '1'
+	option proto 'udp'
+	option dest_ip '52.112.0.0/14 52.122.0.0/15 2603:1063::/38'
+	option dest_port '3478-3481'
+	option class 'af41'
+
+# Discord voice/video. Destination UDP ports per Discord staff: 50000-50032
+# and 19294-19344, both inclusive. Not guaranteed static - if voice stops
+# matching, re-check Discord's current ranges.
+config rule
+	option name 'Video call - Discord voice'
+	option enabled '1'
+	option proto 'udp'
+	option dest_port '50000-50032 19294-19344'
+	option class 'af41'
+
+# WhatsApp voice/video calls. Ports per WhatsApp's own "Can't make voice/video
+# calls" help articles: UDP/TCP 3478, 3480 and 3484 (the voice article also
+# lists 443 as a fallback). 443 is deliberately NOT matched - it is all of
+# HTTPS and would sweep the entire web into this class. 3478/3480 are shared
+# WebRTC/STUN (also Teams/Zoom/console media); the games rule above refuses
+# them, but it refuses them from the CS4 *fast lane*, where shared STUN would
+# starve the link. Here the class is AF41 - managed queue + Wi-Fi Video, never
+# fast-laned - so other real-time media incidentally landing here is harmless:
+# AF41 is already what the Teams/Zoom/Discord call rules assign.
+config rule
+	option name 'Video call - WhatsApp'
+	option enabled '1'
+	option proto 'tcpudp'
+	option dest_port '3478 3480 3484'
+	option class 'af41'
+
+# --- Examples (enabled '0'): flip on and tune to your setup ----------------
+
+# Telephony signaling (RFC 4594 CS5). Safe - narrow, sparse. 5060/5061
+# cover SIP and SIP-over-TLS (Telekom consumer lines signal on UDP 5060,
+# DeutschlandLAN SIP-Trunk is TCP-only); 5070/5080 catch the Telekom
+# platform's inbound SIP toward the PBX/client. Telekom's own CPE preset
+# marks SIP CS6 - both CS5 and CS6 ride this router's fast lane.
+config rule
+	option name 'VoIP - SIP signaling'
+	option enabled '0'
+	option proto 'tcpudp'
+	option dest_port '5060 5061 5070 5080'
+	option class 'cs5'
+
+# Voice bearer (RFC 4594 EF - also Telekom's own preset for RTP). The
+# ranges below are Telekom's published RTP ports for consumer lines
+# (UDP 30000-31000 + 40000-41000); DeutschlandLAN SIP-Trunk uses the
+# platform-side range 9000-27000 instead. Other providers: scope to their
+# documented RTP range or your phone's IP - a bulk UDP flow landing in a
+# too-broad range sits in the EF fast lane and starves everything. Do not
+# scope by provider IP: Telekom explicitly documents their platform
+# clusters as too dynamic to pin.
+config rule
+	option name 'VoIP - RTP media'
+	option enabled '0'
+	option proto 'udp'
+	option dest_port '30000-31000 40000-41000'
+	option class 'ef'
+
+# Multimedia conferencing (RFC 4594 AF41). NOT fast-laned on purpose: a video
+# call is a few Mbit/s, not sparse - it belongs in the managed queue, and af41
+# still gets Wi-Fi Video. Zoom meeting media is UDP 8801-8810 (Zoom-exclusive
+# ports); its 3478/3479 TURN fallback is shared STUN and not matched.
+config rule
+	option name 'Video call - Zoom'
+	option enabled '0'
+	option proto 'udp'
+	option dest_port '8801-8810'
+	option class 'af41'
+
+# Broadcast video (RFC 4594 CS3). Telekom MagentaTV rides the same PPPoE/VID7
+# uplink; its live channels are multicast (PPE-bridged). Scope to the set-top
+# box IP or the multicast group if you use IPTV.
+config rule
+	option name 'IPTV - Telekom MagentaTV'
+	option enabled '0'
+	option proto 'udp'
+	option class 'cs3'
+
+# Scavenger (RFC 4594 CS1). Example matches the classic BitTorrent port range;
+# to deprioritize a NAS/backup host instead, drop dest_port and set src_ip to
+# that host. Never fast-laned. On this single-tin WAN SQM cs1 mainly buys Wi-Fi
+# Background (AC_BK) and downstream honoring; switch the SQM to cake diffserv4
+# for a true WAN bulk tin.
+config rule
+	option name 'Bulk / backups / torrents'
+	option enabled '0'
+	option proto 'tcpudp'
+	option dest_port '6881-6889'
+	option class 'cs1'
+
+# Multimedia streaming (RFC 4594 AF31) from a KNOWN service - a personal
+# media server or a specific CDN - matched by name instead of by port.
+# 'domain' follows the service's address changes automatically, and one
+# apex name covers every per-stream edge subdomain when the CDN fronts
+# them with shared zone addresses (the usual anycast setup). af31 buys
+# Wi-Fi Video and downstream honoring; deliberately NO fast lane - a
+# buffer burst at line rate in the fast lane would starve interactive
+# traffic.
+config rule
+	option name 'Video stream - my media CDN'
+	option enabled '0'
+	option proto 'tcpudp'
+	option dest_port '443'
+	option class 'af31'
+	list domain 'cdn.example.com'
+
+# Big-name streaming (Netflix / YouTube / Spotify / Twitch) has no rule on
+# purpose. By port it is indistinguishable from web (all HTTPS/QUIC on
+# 443), and 'domain' cannot pin it either: these CDNs hand each player
+# its own per-session edge hostnames (e.g. rN---sn-xxxx.googlevideo.com)
+# whose addresses are NOT shared with any resolvable parent - resolving
+# 'googlevideo.com' or 'youtube.com' catches the website, not the video
+# bytes. 'domain' works where the probe shows shared front-end addresses:
+#   nslookup <edge host seen in traffic>  vs  nslookup <apex>
+# same addresses (typical for Cloudflare/anycast-fronted zones) -> one
+# apex entry covers every edge host; different addresses (Google, Netflix
+# OCA, Akamai-style per-edge CDNs) -> leave it alone. Best practice for
+# big streaming is CS0 and fq_codel - never fast-lane buffered video.
diff --git a/package/nss/nss-tools/files/nssqos.init b/package/nss/nss-tools/files/nssqos.init
new file mode 100755
index 0000000000000000000000000000000000000000..3061b0938c1e32f2d6f196604e382d548b40c35d
--- /dev/null
+++ b/package/nss/nss-tools/files/nssqos.init
@@ -0,0 +1,317 @@
+#!/bin/sh /etc/rc.common
+# START and USE_PROCD are read by /etc/rc.common, not by this file.
+# shellcheck disable=SC2034
+# NSS QoS marking: renders /etc/config/nssqos into a standalone nftables
+# table (inet nssqos, mangle-priority forward chain). Rules DSCP-mark
+# matching connections and optionally steer them into the SQM fast lane
+# (`meta priority set 100:0`, consumed by nss-edma.qos trees and, via ECM,
+# by the NSS firmware for accelerated flows in both directions).
+#
+# The table is our own, so firewall (fw4) reloads never touch it, and
+# deleting it removes every trace. LuCI edits reload this service through
+# the procd config trigger.
+
+START=51
+USE_PROCD=1
+
+RULESET=/var/etc/nssqos.nft
+
+# DSCP classes the fast lane accepts by default ('fastlane auto'): the
+# real-time and above classes (RFC 4594 CS4 up, plus EF/VA voice).
+AUTO_FAST_CLASSES="cs4 cs5 cs6 cs7 ef va"
+
+# Class name -> DSCP value. Rendered numerically; some class mnemonics
+# (va, le) are not understood by every nft userspace.
+class_to_dscp() {
+	case "$1" in
+	cs0) echo 0 ;;  cs1) echo 8 ;;  cs2) echo 16 ;; cs3) echo 24 ;;
+	cs4) echo 32 ;; cs5) echo 40 ;; cs6) echo 48 ;; cs7) echo 56 ;;
+	af11) echo 10 ;; af12) echo 12 ;; af13) echo 14 ;;
+	af21) echo 18 ;; af22) echo 20 ;; af23) echo 22 ;;
+	af31) echo 26 ;; af32) echo 28 ;; af33) echo 30 ;;
+	af41) echo 34 ;; af42) echo 36 ;; af43) echo 38 ;;
+	ef) echo 46 ;; va) echo 44 ;; le) echo 1 ;;
+	*) return 1 ;;
+	esac
+}
+
+# 'a b-c,d' -> '{ a, b-c, d }' (nft set), empty input -> empty output.
+# Used for port lists and address lists alike. A named-set reference
+# ('@name', from a domain rule) passes through verbatim.
+to_set() {
+	local in out
+	case "$1" in
+	@*) echo "$1"; return 0 ;;
+	esac
+	in=$(echo "$1" | tr ',' ' ')
+	set -- $in
+	[ $# -eq 0 ] && return 0
+	out=$(echo "$*" | sed 's/ /, /g')
+	echo "{ $out }"
+}
+
+# Subset of an IP/CIDR list belonging to one family ('ip' or 'ip6'). Lists may
+# mix families (e.g. a service's published v4+v6 ranges); each family's rule
+# gets its own subset. A '@name' set reference maps to the family's named set.
+addrs_of() {
+	local a out=""
+	for a in $1; do
+		case "$a" in
+		@*) [ "$2" = ip6 ] && out="$out ${a}_v6" || out="$out ${a}_v4" ;;
+		*:*) [ "$2" = ip6 ] && out="$out $a" ;;
+		*) [ "$2" = ip ] && out="$out $a" ;;
+		esac
+	done
+	echo $out
+}
+
+# Rules with 'domain' entries (filled by collect_domain_rule): each gets a
+# pair of named sets <cfg>_v4/<cfg>_v6 that /usr/sbin/nssqos-resolve keeps
+# populated.
+DOMAIN_RULES=""
+
+collect_domain_rule() {
+	local cfg="$1" enabled domains
+	config_get_bool enabled "$cfg" enabled 0
+	config_get domains "$cfg" domain
+	[ "$enabled" = 1 ] && [ -n "$domains" ] && DOMAIN_RULES="$DOMAIN_RULES $cfg"
+}
+
+# Trust boundary: /etc/config/nssqos is writable by any LuCI role granted the
+# nssqos ACL, and its values are rendered verbatim into the root `nft -f`
+# ruleset below. The LuCI form's datatype checks run only in the browser, so
+# re-validate here - a field carrying an nft metacharacter could otherwise
+# break out of the statement we build and inject arbitrary ruleset commands
+# (e.g. close the rule and `flush ruleset`). Addresses, ports, device and rule
+# names never legitimately contain those characters.
+valid_addr_list() {	# space/comma-separated IPs or CIDRs; empty = "any"
+	local t
+	for t in $(echo "$1" | tr ',' ' '); do
+		case "$t" in *[!0-9A-Fa-f:./]*) return 1 ;; esac
+	done
+	return 0
+}
+valid_port_list() {	# space/comma-separated ports or ranges; empty = "any"
+	local t
+	for t in $(echo "$1" | tr ',' ' '); do
+		case "$t" in *[!0-9-]*) return 1 ;; esac
+	done
+	return 0
+}
+valid_dev() {		# a netdev name (iifname/oifname match)
+	case "$1" in ''|*[!A-Za-z0-9._@-]*) return 1 ;; esac
+	return 0
+}
+# Cosmetic field (nft comment + log line only): strip anything that could close
+# the comment string or start a new ruleset line rather than reject the rule.
+sanitize_name() { printf '%s' "$1" | tr -d '"\\\n\r'; }
+
+# Emit the nft rules for one direction of one uci rule.
+# Args: $1=proto-match $2=src_ip $3=dest_ip $4=src_ports $5=dest_ports
+#       $6=dscp value  $7=fastlane(0/1)  $8=rule name
+emit_direction() {
+	# Quote every assignment: ash's 'local' field-splits unquoted values,
+	# and $1 carries spaces ("meta l4proto tcp").
+	local proto="$1" sip="$2" dip="$3" sports="$4" dports="$5" dscp="$6" fast="$7" name="$8"
+	local fam fsip fdip match action emitted=0
+
+	# Per family, restrict each address list to that family's subset. An
+	# address list with no entry in a family excludes the rule from it.
+	for fam in ip ip6; do
+		fsip=$(addrs_of "$sip" $fam)
+		fdip=$(addrs_of "$dip" $fam)
+		[ -n "$sip" ] && [ -z "$fsip" ] && continue
+		[ -n "$dip" ] && [ -z "$fdip" ] && continue
+		emitted=1
+		match="$proto"
+		[ -n "$fsip" ] && match="$match $fam saddr $(to_set "$fsip")"
+		[ -n "$fdip" ] && match="$match $fam daddr $(to_set "$fdip")"
+		[ -n "$sports" ] && match="$match th sport $sports"
+		[ -n "$dports" ] && match="$match th dport $dports"
+		action="$fam dscp set $dscp"
+		[ "$fast" = 1 ] && action="$action meta priority set 100:0"
+		# Record the class in the ct mark (dscp | 0x80, qosmate-compatible)
+		# so LuCI Status -> Realtime -> Connections can show it per flow.
+		action="$action ct mark set $(printf 0x%x $((0x80 | dscp)))"
+		printf '%s\n' "$match $action counter comment \"$name\"" >> "$RULESET"
+	done
+	[ "$emitted" = 1 ] || \
+		logger -t nssqos "rule '$name': src/dest address families never overlap, skipping"
+}
+
+render_rule() {
+	local cfg="$1"
+	local name enabled proto src_ip dest_ip src_port dest_port class fastlane
+	local dscp fast pmatch sset dset domains
+
+	config_get_bool enabled "$cfg" enabled 0
+	[ "$enabled" = 1 ] || return 0
+
+	config_get name "$cfg" name "$cfg"
+	config_get proto "$cfg" proto udp
+	config_get src_ip "$cfg" src_ip
+	config_get dest_ip "$cfg" dest_ip
+	config_get src_port "$cfg" src_port
+	config_get dest_port "$cfg" dest_port
+	config_get class "$cfg" class
+	config_get fastlane "$cfg" fastlane auto
+	config_get domains "$cfg" domain
+
+	name=$(sanitize_name "$name")
+	if ! valid_addr_list "$src_ip" || ! valid_addr_list "$dest_ip"; then
+		logger -t nssqos "rule '$name': invalid address field, skipping"
+		return 0
+	fi
+	if ! valid_port_list "$src_port" || ! valid_port_list "$dest_port"; then
+		logger -t nssqos "rule '$name': invalid port field, skipping"
+		return 0
+	fi
+
+	dscp=$(class_to_dscp "$class") || {
+		logger -t nssqos "rule '$name': unknown class '$class', skipping"
+		return 0
+	}
+
+	case "$proto" in
+	tcp|udp) pmatch="meta l4proto $proto" ;;
+	tcpudp) pmatch="meta l4proto { tcp, udp }" ;;
+	*)
+		logger -t nssqos "rule '$name': unknown proto '$proto', skipping"
+		return 0
+		;;
+	esac
+
+	fast=0
+	case "$fastlane" in
+	1) fast=1 ;;
+	0) ;;
+	*) case " $AUTO_FAST_CLASSES " in *" $class "*) fast=1 ;; esac ;;
+	esac
+
+	sset=$(to_set "$src_port")
+	dset=$(to_set "$dest_port")
+
+	# Domain rules match the rule's resolved-address sets as destination
+	# (plus the mirrored reply direction). dest_ip, if also given, is an
+	# additional alternative; dest-less literal rules are suppressed so a
+	# domain-only rule never widens to match-everything.
+	if [ -n "$domains" ]; then
+		emit_direction "$pmatch" "$src_ip" "@$cfg" "$sset" "$dset" "$dscp" "$fast" "$name"
+		emit_direction "$pmatch" "@$cfg" "$src_ip" "$dset" "$sset" "$dscp" "$fast" "$name"
+		[ -n "$dest_ip" ] || return 0
+	fi
+
+	# As written, plus the mirrored reply direction.
+	emit_direction "$pmatch" "$src_ip" "$dest_ip" "$sset" "$dset" "$dscp" "$fast" "$name"
+	emit_direction "$pmatch" "$dest_ip" "$src_ip" "$dset" "$sset" "$dscp" "$fast" "$name"
+}
+
+# L3 device the WAN forward path uses (pppoe-wan on a PPPoE uplink) —
+# deterministic from uci at any boot stage, no live-network query needed.
+wan_l3_device() {
+	local dev
+	dev=$(uci -q get nssqos.global.wan_device)
+	if [ -n "$dev" ]; then
+		# nssqos-namespace value (ACL-writable) -> validate before it lands
+		# in an iifname/oifname match; network.wan.* below is system config.
+		valid_dev "$dev" && { echo "$dev"; return; }
+		logger -t nssqos "ignoring invalid wan_device '$dev'"
+	fi
+	if [ "$(uci -q get network.wan.proto)" = "pppoe" ]; then
+		echo "pppoe-wan"
+	else
+		uci -q get network.wan.device
+	fi
+}
+
+start_service() {
+	local enabled wash_egress wash_ingress wandev cfg
+
+	config_load nssqos
+	config_get_bool enabled global enabled 1
+	if [ "$enabled" != 1 ]; then
+		nft delete table inet nssqos 2>/dev/null
+		return 0
+	fi
+
+	config_foreach collect_domain_rule rule
+
+	mkdir -p "$(dirname "$RULESET")"
+	{
+		printf '%s\n' "table inet nssqos"
+		printf '%s\n' "flush table inet nssqos"
+		printf '%s\n' "table inet nssqos {"
+		for cfg in $DOMAIN_RULES; do
+			printf 'set %s_v4 { type ipv4_addr; }\n' "$cfg"
+			printf 'set %s_v6 { type ipv6_addr; }\n' "$cfg"
+		done
+		printf '%s\n' "chain forward {"
+		printf '%s\n' "type filter hook forward priority mangle; policy accept;"
+	} > "$RULESET"
+
+	config_get_bool wash_ingress global wash_ingress 0
+	config_get_bool wash_egress global wash_egress 0
+	wandev=$(wan_l3_device)
+
+	# Ingress wash first: inbound DSCP from the ISP is untrusted; marking
+	# rules below re-mark whatever they match, wash covers the rest.
+	if [ "$wash_ingress" = 1 ] && [ -n "$wandev" ]; then
+		printf '%s\n' "iifname \"$wandev\" ip dscp != cs0 ip dscp set cs0 counter comment \"wash ingress\"" >> "$RULESET"
+		printf '%s\n' "iifname \"$wandev\" ip6 dscp != cs0 ip6 dscp set cs0 counter comment \"wash ingress\"" >> "$RULESET"
+	fi
+
+	config_foreach render_rule rule
+
+	# Egress wash last: the wire leaves as CS0, but fast-lane steering is
+	# carried by the priority mark and survives the wash (the firmware
+	# remarks accelerated packets to the post-wash value).
+	if [ "$wash_egress" = 1 ] && [ -n "$wandev" ]; then
+		printf '%s\n' "oifname \"$wandev\" ip dscp != cs0 ip dscp set cs0 counter comment \"wash egress\"" >> "$RULESET"
+		printf '%s\n' "oifname \"$wandev\" ip6 dscp != cs0 ip6 dscp set cs0 counter comment \"wash egress\"" >> "$RULESET"
+	fi
+
+	{
+		printf '%s\n' "}"
+		printf '%s\n' "}"
+	} >> "$RULESET"
+
+	# nft -f is all-or-nothing, which is what we want - a half-applied QoS
+	# table is worse than none. But that means one rule nft dislikes voids
+	# every rule, so say which and why instead of leaving the operator with
+	# a silently unmarked network: check first, and log nft's own diagnostic.
+	if ! err=$(nft -c -f "$RULESET" 2>&1); then
+		logger -t nssqos "ruleset rejected, no rules applied: $err"
+		logger -t nssqos "offending ruleset kept at $RULESET"
+		return 1
+	fi
+	if ! err=$(nft -f "$RULESET" 2>&1); then
+		logger -t nssqos "failed to apply $RULESET: $err"
+		return 1
+	fi
+
+	# Immediate pass so domain-rule sets never sit empty after a
+	# (re)render; the resolver instance's next tick could be minutes away.
+	[ -n "$DOMAIN_RULES" ] && /usr/sbin/nssqos-resolve once &
+
+	# The resolver registers only on start/restart (procd's reload path
+	# holds procd_lock with no service context open, so instance calls
+	# no-op there). It re-reads the config every tick itself, so reloads
+	# that add/remove domain rules need no instance changes.
+	procd_open_instance resolver
+	procd_set_param command /usr/sbin/nssqos-resolve
+	procd_set_param respawn
+	procd_close_instance
+}
+
+stop_service() {
+	nft delete table inet nssqos 2>/dev/null
+	return 0
+}
+
+reload_service() {
+	start_service
+}
+
+service_triggers() {
+	procd_add_reload_trigger "nssqos"
+}
diff --git a/package/nss/nss-tools/tests/nss-status.test.sh b/package/nss/nss-tools/tests/nss-status.test.sh
new file mode 100644
index 0000000000000000000000000000000000000000..584a94e020022b6864aad454ddad3e8f2a08a5be
--- /dev/null
+++ b/package/nss/nss-tools/tests/nss-status.test.sh
@@ -0,0 +1,279 @@
+#!/usr/bin/env bash
+# Tests for nss-status, run against a synthetic /sys tree (NSS_STATUS_ROOT) with
+# the external commands it shells out to stubbed on PATH. No hardware, no root.
+#
+# Run with: bash package/nss/nss-tools/tests/nss-status.test.sh
+#
+# The port table's fixture is generated from the format string in the glue
+# driver rather than pasted from a device. A pasted line is a snapshot of one
+# build: add a field to the driver and the fixture still describes the old
+# layout, so a parser reading the wrong column keeps passing. Generating it
+# means the day a field is inserted, this fixture grows it too and any parser
+# that located a counter by column number fails here instead of on the router
+# - which is how a field insert once turned every offload share into 100%.
+
+set -euo pipefail
+
+here="$(cd -- "$(dirname -- "$0")" && pwd)"
+files="$here/../files"
+glue_src="$here/../../../kernel/qca-ppe-nss/src/qca_ppe_nss.c"
+
+fail=0
+check() { # check <name> <want> <got>
+	if [ "$2" = "$3" ]; then
+		printf 'PASS  %s\n' "$1"
+	else
+		printf 'FAIL  %s\n  want: %s\n  got:  %s\n' "$1" "$2" "$3"
+		fail=1
+	fi
+}
+skip() { printf 'SKIP  %s\n        %s\n' "$1" "$2"; }
+
+# ---- the driver's port line, and a value per field -------------------------
+
+# The seq_printf whose first literal is the port line; keep the keys in the
+# order the driver prints them.
+port_fmt="$(sed -n 's/.*"\(if_num %d: netdev=[^"]*\)\\n".*/\1/p' "$glue_src")"
+[ -n "$port_fmt" ] || { echo "FAIL  cannot find the if_num format in $glue_src"; exit 1; }
+
+port_keys="$(printf '%s\n' "$port_fmt" | tr ' ' '\n' | sed -n 's/^\([a-z_]*\)=%.*/\1/p')"
+for want_key in netdev armed overridden started fw_vsi tx_redirect_pkts \
+		tx_busy tx_dropped tx_ungranted fw_link rx_fw_pkts; do
+	printf '%s\n' "$port_keys" | grep -qx "$want_key" ||
+		{ echo "FAIL  driver no longer prints $want_key"; exit 1; }
+done
+
+# Distinct value per key, so a counter read from the wrong column cannot
+# coincidentally match the right one. Chosen to be hostile to a column slip:
+# fw_vsi is a small number that reads like a plausible packet count, which is
+# exactly what made the original mistake invisible.
+port_line() { # port_line <ifnum> <netdev> <started> <tx_redirect> <rx_fw>
+	local out="if_num $1:" k
+	for k in $port_keys; do
+		case "$k" in
+		netdev)           out="$out netdev=$2" ;;
+		armed|overridden) out="$out $k=1" ;;
+		started)          out="$out started=$3" ;;
+		tx_redirect_pkts) out="$out tx_redirect_pkts=$4" ;;
+		rx_fw_pkts)       out="$out rx_fw_pkts=$5" ;;
+		fw_vsi)           out="$out fw_vsi=7" ;;
+		# Distinct from tx_busy, which sits next to it: the whole point of
+		# this counter is that it disagrees with tx_redirect_pkts, so a
+		# reader that picked up either neighbour has to fail here.
+		tx_dropped)       out="$out tx_dropped=9" ;;
+		fw_link)          out="$out fw_link=1" ;;
+		tx_ungranted)     out="$out tx_ungranted=11" ;;
+		*)                out="$out $k=3" ;;
+		esac
+	done
+	printf '%s\n' "$out"
+}
+
+# ---- synthetic root --------------------------------------------------------
+
+root="$(mktemp -d)"
+trap 'rm -rf "$root"' EXIT
+
+mkdir -p "$root/lib/nss" "$root/sys/kernel/debug/qca-ppe-nss" \
+	 "$root/sys/kernel/debug/qca-nss-drv/stats" \
+	 "$root/sys/kernel/debug/ecm/ecm_nss_ipv4" \
+	 "$root/sys/kernel/debug/ecm/ecm_nss_ipv6" \
+	 "$root/sys/module/ecm" "$root/bin"
+cp "$files/functions.sh" "$root/lib/nss/functions.sh"
+
+glue="$root/sys/kernel/debug/qca-ppe-nss"
+drv="$root/sys/kernel/debug/qca-nss-drv/stats"
+
+echo 0x3c > "$glue/fw_mask"
+printf '\tn2h_rx_pkts = 5000\n' > "$drv/n2h"
+printf 'Core 0:\n Min 1%% Avg 4%% Max 9%%\n' > "$drv/cpu_load_ubi"
+echo 116 > "$root/sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count"
+echo 48 > "$root/sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count"
+
+netdev() { # netdev <name> <tx_packets> <rx_packets>
+	mkdir -p "$root/sys/class/net/$1/statistics"
+	echo "$2" > "$root/sys/class/net/$1/statistics/tx_packets"
+	echo "$3" > "$root/sys/class/net/$1/statistics/rx_packets"
+	echo 1 > "$root/sys/class/net/$1/carrier"
+}
+netdev wan 1000 2000
+netdev lan1 500 400
+
+{ port_line 2 wan 1 250 500; port_line 3 lan1 1 0 0
+  port_line 6 - 0 0 0; } > "$glue/status"
+
+# Externals the report shells out to; their answers are per-test, via files.
+# The uci stub honours show/get the way uci does, quotes included: 'show'
+# quotes option values and 'get' does not, and a stub that ignored the
+# difference would let a caller that forgot to unquote pass here.
+stub() { printf '#!/bin/sh\n%s\n' "$2" > "$root/bin/$1"; chmod +x "$root/bin/$1"; }
+stub tc  '[ $# -gt 0 ] || { echo STUB; exit 0; }
+cat "$TC_OUT" 2>/dev/null || true'
+stub uci 'for a in "$@"; do last=$a; done
+case " $* " in
+*" show "*) grep "^$last\." "$UCI_OUT" 2>/dev/null ;;
+*" get "*)  sed -n "s|^$last=||p" "$UCI_OUT" 2>/dev/null | tr -d "'\''" ;;
+esac
+true'
+stub nft   'true'
+stub dmesg 'true'
+: > "$root/tc.out"
+: > "$root/uci.out"
+export TC_OUT="$root/tc.out" UCI_OUT="$root/uci.out"
+
+# The router runs these under busybox, which is a different shell and a
+# different awk from the one a workstation reaches for. NSS_TEST_SH lets the
+# whole suite re-run against busybox applets rather than trusting that the two
+# agree - they do not, on exactly the string handling these parsers lean on.
+run() {
+	NSS_STATUS_ROOT="$root" PATH="$root/bin:$PATH" \
+		"${NSS_TEST_SH:-sh}" "$files/nss-status" "$@"
+}
+
+# A busybox built as a standalone shell runs its own applets and never consults
+# PATH, so a stub cannot stand in for one it happens to ship - tc, here.
+# OpenWrt builds busybox without either, so this is a limit of the runner's
+# busybox and not of the script. Say so out loud: a case quietly dropped from a
+# run reads as a case that passed, which is the failure this whole file exists
+# to stop.
+stubs_honoured=1
+PATH="$root/bin:$PATH" "${NSS_TEST_SH:-sh}" -c 'tc' 2>/dev/null | \
+	grep -q '^STUB$' || stubs_honoured=0
+json_num() { printf '%s' "$1" | tr ',{' '\n\n' | sed -n "s/^\"$2\"://p" | head -1; }
+port_field() { # port_field <json> <ifnum> <key>
+	printf '%s' "$1" | tr '{' '\n' | grep "\"ifnum\":$2," |
+		tr ',' '\n' | sed -n "s/^\"$3\"://p" | head -1
+}
+
+# ---- the port table --------------------------------------------------------
+
+out="$(run -j)"
+
+check 'port: host TX comes from tx_redirect_pkts, not a neighbouring field' \
+	250 "$(port_field "$out" 2 tx_host_pkts)"
+check 'port: host RX comes from rx_fw_pkts, not a neighbouring field' \
+	500 "$(port_field "$out" 2 rx_host_pkts)"
+check 'port: wire totals come from the netdev MIB' \
+	1000 "$(port_field "$out" 2 tx_total)"
+check 'port: offloaded TX is wire minus host' \
+	750 "$(port_field "$out" 2 tx_offloaded)"
+check 'port: offload share is a share, not a hardcoded 100' \
+	75.0 "$(port_field "$out" 2 tx_offload_pct)"
+check 'port: a port the firmware never punted for reads 100%' \
+	100.0 "$(port_field "$out" 3 tx_offload_pct)"
+check 'port: an unarmed port (netdev=-) is left out' \
+	'' "$(port_field "$out" 6 tx_total)"
+
+# The whole reason the columns are read by name. Insert a field ahead of the
+# counters, exactly as the injectable= field was, and the values must not move.
+{ sed 's/started=1/started=1 lookahead=9/' "$glue/status"; } > "$glue/status.new"
+mv "$glue/status.new" "$glue/status"
+shifted="$(run -j)"
+check 'port: a field inserted before the counters does not shift them' \
+	250 "$(port_field "$shifted" 2 tx_host_pkts)"
+{ port_line 2 wan 1 250 500; port_line 3 lan1 1 0 0
+  port_line 6 - 0 0 0; } > "$glue/status"
+
+# ---- state -----------------------------------------------------------------
+
+# An armed firmware whose N2H counter is not moving is the shape of a wedge,
+# and it must not report as active - that reading is the whole point of taking
+# two samples rather than one.
+check 'state: armed firmware with a frozen counter is stalled, not active' \
+	'"stalled"' "$(json_num "$out" state)"
+check 'heartbeat: a frozen counter is zero pps' \
+	0 "$(json_num "$out" heartbeat_pps)"
+
+# Move the counter inside the sampling window, well clear of either end.
+( sleep 0.3; printf '\tn2h_rx_pkts = 6000\n' > "$drv/n2h" ) &
+moving="$(run -j)"; wait
+check 'state: armed firmware with a moving counter is active' \
+	'"active"' "$(json_num "$moving" state)"
+check 'heartbeat: reported as the per-second delta' \
+	1000 "$(json_num "$moving" heartbeat_pps)"
+printf '\tn2h_rx_pkts = 5000\n' > "$drv/n2h"
+
+echo 0x0 > "$glue/fw_mask"
+check 'state: no armed port is host mode' \
+	'"host"' "$(json_num "$(run -j)" state)"
+echo 0x3c > "$glue/fw_mask"
+
+# ---- the shaper's default leaf ---------------------------------------------
+# An NSS tree with no default leaf drops every packet handed to it while tc
+# still lists a shaper and the carrier stays set. The report has to name it.
+
+printf "sqm.wan=queue\nsqm.wan.enabled='1'\nsqm.wan.interface='pppoe-wan'\n" > "$root/uci.out"
+
+check 'sqm: the shaped device is resolved by section type, not by name' \
+	'"pppoe-wan"' "$(json_num "$(run -j)" device)"
+
+if [ "$stubs_honoured" = 0 ]; then
+	skip 'sqm: the default-leaf cases' \
+		"this shell runs a built-in tc, so the stub never gets asked"
+else
+	printf 'qdisc nsstbl 1: root refcnt 2 rate 165Mbit\n' > "$root/tc.out"
+	check 'sqm: a root with no default leaf is reported as dropping' \
+		1 "$(run | grep -c 'dropping')"
+
+	printf 'qdisc nsstbl 1: root refcnt 2 rate 165Mbit set_default\n' > "$root/tc.out"
+	check 'sqm: a root with a default leaf is not' \
+		0 "$(run | grep -c 'dropping')"
+fi
+
+# ---- the L2 per-port view --------------------------------------------------
+# host->fw counts frames handed to nss-drv, which reports a silent drop as a
+# successful transmit, so the drop counter beside it is the only thing that
+# separates "the firmware took these" from "the firmware refused every one".
+# Two field captures of a dead WAN were unreadable for want of exactly this.
+
+stub devmem 'echo 0x05050505'
+for p in 2 3; do
+	mkdir -p "$drv/edma/ports/$p"
+	printf '\tedma_port[%s]_rx_pkts = 111%s\n\tedma_port[%s]_tx_pkts = 222%s\n' \
+		"$p" "$p" "$p" "$p" > "$drv/edma/ports/$p/stats"
+done
+
+# Resolve the column from the header rather than counting it. A positional
+# read is exactly what this file exists to catch, and adding the fw_link
+# column broke a first draft of these three checks that had counted.
+l2_field() { # l2_field <port> <column header>
+	run -l2 | awk -v want="$2" -v port="$1" '
+		$1 == "port" { for (i = 1; i <= NF; i++) if ($i == want) col = i; next }
+		$1 == port && col { print $col }'
+}
+
+check 'l2: hostdrop reports the drop counter, not a neighbouring field' \
+	9 "$(l2_field wan hostdrop)"
+check 'l2: host->fw is still the redirect counter beside it' \
+	250 "$(l2_field wan 'host->fw')"
+check 'l2: fw->wire is the firmware egress counter, not its ingress twin' \
+	1112 "$(l2_field wan 'fw->wire')"
+check 'l2: wire->fw is the ingress counter' \
+	2222 "$(l2_field wan 'wire->fw')"
+check 'l2: fwl reports the firmware link state we last set' \
+	1 "$(l2_field wan fwl)"
+
+# ---- mesh: configured is not the same as offloaded -------------------------
+# ath11k_nss_mesh_vdev_alloc() can fail at runtime (wrong fw line, capability
+# probe reject) while the iface stays configured and up on the host path.
+# mesh_cfg alone used to be reported as "offloaded"; it must now agree with
+# the debugfs link list ath11k_nss_mesh_vdev_alloc() only writes on success.
+
+printf "wireless.mesh=wifi-iface\nwireless.mesh.mode='mesh'\n" > "$root/uci.out"
+mkdir -p "$root/sys/module/ath11k/parameters"
+echo 1 > "$root/sys/module/ath11k/parameters/nss_offload"
+mkdir -p "$root/sys/kernel/debug/ath11k/ahb-c000000.wifi/dbg_infra"
+
+check 'mesh: configured but no vdev is reported as not offloaded' \
+	'0' "$(json_num "$(run -j)" offloaded)"
+check 'mesh: configured but no vdev says so in the text report' \
+	1 "$(run | grep -c 'mesh configured, not offloaded')"
+
+printf 'link id 39\n' > "$root/sys/kernel/debug/ath11k/ahb-c000000.wifi/dbg_infra/links"
+
+check 'mesh: a real vdev is reported as offloaded' \
+	'1' "$(json_num "$(run -j)" offloaded)"
+check 'mesh: a real vdev says so in the text report' \
+	1 "$(run | grep -c 'mesh offloaded')"
+
+exit "$fail"
diff --git a/target/linux/generic/hack-6.18/262-lib-crypto-unhide.patch b/target/linux/generic/hack-6.18/262-lib-crypto-unhide.patch
new file mode 100644
index 0000000000000000000000000000000000000000..2fcce11da1b60ef6709e45c6e58bbb5104a8979f
--- /dev/null
+++ b/target/linux/generic/hack-6.18/262-lib-crypto-unhide.patch
@@ -0,0 +1,57 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Thu, 16 Jul 2026 10:40:40 +0200
+Subject: [PATCH] lib/crypto: add tristate strings for the packaged crypto
+ libraries
+
+The lib/crypto reorganization removed the user prompts from the
+library Kconfig symbols, turning them select-only. The kmod
+packaging enables these symbols by writing them into the kernel
+config, which the kernel's oldconfig silently drops for promptless
+symbols unless some built-in selector (e.g. WIREGUARD) happens to be
+enabled, leaving kmod-crypto-lib-chacha20, kmod-crypto-lib-poly1305,
+kmod-crypto-lib-chacha20poly1305 and kmod-crypto-lib-curve25519
+empty and their exports absent from Module.symvers. Restore prompts
+for the four symbols those packages anchor on, following the
+CRYPTO_LIB_ARC4 precedent.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
