++		goto free;
++	}
++
++	ath11k_dbg(ar->ab, ATH11K_DBG_NSS, "nss peer id %d security cfg complete\n",
++		   peer->peer_id);
++free:
++	kfree(wlmsg);
++	return status;
++}
