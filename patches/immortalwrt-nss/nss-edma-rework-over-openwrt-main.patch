++
++	switch (preamble_type) {
++	case WMI_RATE_PREAMBLE_OFDM:
++		peer->nss.nss_stats->rxrate.legacy = rate;
++		break;
++	case WMI_RATE_PREAMBLE_CCK:
++		peer->nss.nss_stats->rxrate.legacy = rate;
