diff --git a/target/linux/generic/pending-6.18/682-ipmr-do-not-drop-GSO-packets-that-fit-the-MTU.patch b/target/linux/generic/pending-6.18/682-ipmr-do-not-drop-GSO-packets-that-fit-the-MTU.patch
new file mode 100644
index 0000000000000000000000000000000000000000..3e1a321bc76439c909e3a7d1b1b6accfdeee720f
--- /dev/null
+++ b/target/linux/generic/pending-6.18/682-ipmr-do-not-drop-GSO-packets-that-fit-the-MTU.patch
@@ -0,0 +1,46 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Sat, 10 Oct 2026 14:34:17 +0200
+Subject: [PATCH] ipmr: do not drop GSO packets that fit the MTU after
+ segmentation
+
+ipmr_prepare_xmit() drops a packet with DF set when skb->len exceeds the
+route MTU, without checking whether it is a GSO packet. A UDP multicast
+stream received with fraglist GRO or UDP GRO forwarding enabled is
+aggregated into GSO packets, and every aggregate is dropped with
+FragFails, while ip_forward() lets the same packets pass by checking
+skb_gso_validate_network_len(). Do the same for multicast routing.
+ip6mr has no such check and leaves GSO packets to ip6_output().
+
+On an IPQ8074 router with fraglist GRO on, a 10 Mbit/s stream of
+1316-byte DF datagrams routed by igmpproxy loses 14.5 to 15.5% (n=3)
+and 0% with this change.
+
+Fixes: 9fd1ff5d2ac7 ("udp: Support UDP fraglist GRO/GSO.")
+Link: https://lore.kernel.org/netdev/20261010131842.2157365-1-julius@bairaktaris.de/
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+ net/ipv4/ipmr.c | 5 ++++-
+ 1 file changed, 4 insertions(+), 1 deletion(-)
+
+--- a/net/ipv4/ipmr.c
++++ b/net/ipv4/ipmr.c
+@@ -1891,6 +1891,7 @@ static int ipmr_prepare_xmit(struct net
+ 	struct rtable *rt;
+ 	struct flowi4 fl4;
+ 	int    encap = 0;
++	unsigned int mtu;
+ 
+ 	vif_dev = vif_dev_read(vif);
+ 	if (!vif_dev)
+@@ -1923,7 +1924,9 @@ static int ipmr_prepare_xmit(struct net
+ 			return -1;
+ 	}
+ 
+-	if (skb->len+encap > dst4_mtu(&rt->dst) && (ntohs(iph->frag_off) & IP_DF)) {
++	mtu = dst4_mtu(&rt->dst) - encap;
++	if (skb->len > mtu && (ntohs(iph->frag_off) & IP_DF) &&
++	    !(skb_is_gso(skb) && skb_gso_validate_network_len(skb, mtu))) {
+ 		/* Do not fragment multicasts. Alas, IPv4 does not
+ 		 * allow to send ICMP, so that packets will disappear
+ 		 * to blackhole.
diff --git a/target/linux/qualcommax/base-files/etc/init.d/pstore-archive b/target/linux/qualcommax/base-files/etc/init.d/pstore-archive
new file mode 100755
index 0000000000000000000000000000000000000000..c23abf4cae2ab522a9d3cf8628d404b55053c53f
--- /dev/null
+++ b/target/linux/qualcommax/base-files/etc/init.d/pstore-archive
@@ -0,0 +1,33 @@
+#!/bin/sh /etc/rc.common
+# Archive pstore crash dumps to persistent storage early in boot, then
+# clear pstore so the next crash has free records.
+#
+# This runs before NTP has synced (and sysfixtime only offers the newest
+# file mtime), so the wall clock can lag reality and barely advance between
+# consecutive reboots - date-only directory names from back-to-back boots
+# then land seconds apart and read like repeat archives of a single boot.
+# Suffix the kernel's per-boot boot_id so every directory maps to exactly
+# one boot regardless of clock state.
+START=11
+
+boot() {
+	local boot_id dir d
+
+	grep -q pstore /proc/filesystems || return 0
+	mkdir -p /sys/fs/pstore
+	grep -q ' /sys/fs/pstore pstore ' /proc/mounts || \
+		mount -t pstore pstore /sys/fs/pstore 2>/dev/null
+	ls /sys/fs/pstore/ 2>/dev/null | grep -q . || return 0
+
+	boot_id="$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null)"
+	dir="/root/pstore/$(date +%Y%m%d-%H%M%S)${boot_id:+-$boot_id}"
+	mkdir -p "$dir"
+	cp /sys/fs/pstore/* "$dir/" 2>/dev/null
+	rm -f /sys/fs/pstore/*
+	logger -t pstore-archive "crash dumps archived to $dir"
+
+	# keep the newest 20 archives - flash space over unbounded history
+	for d in $(ls -dt /root/pstore/*/ 2>/dev/null | tail -n +21); do
+		rm -rf "$d"
+	done
+}
