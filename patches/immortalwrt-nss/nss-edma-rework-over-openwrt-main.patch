++	msg_cb = (nss_wifili_msg_callback_t)ath11k_nss_wifili_event_receive;
++
++	nss_cmn_msg_init(&wlmsg->cm, ar->ab->nss.if_num,
++			 NSS_WIFILI_PEER_SECURITY_TYPE_MSG,
++			 sizeof(struct nss_wifili_peer_security_type_msg),
