++static int ath11k_nss_vdev_alloc(struct ath11k_vif *arvif)
++{
++	struct ath11k_base *ab = arvif->ar->ab;
++	enum nss_dynamic_interface_type if_type;
++	int if_num;
++
++	/* Initialize completion for verifying NSS message response */
