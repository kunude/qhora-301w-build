# ═══════════════════════════════════════════════════════════════════════════
#  QHora-301W 出厂预置的 honk 配置
#  ─────────────────────────────────────────────────────────────────────────
#  来源：本仓库 files-honk/etc/honk/config.dae，由 prepare-build.sh 在叠加
#        files/ 之后按变体叠加进固件（只有 honk 版固件带它）。
#
#  这份文件与 kenzok8/small 里 honk 包自带的 config.dae **功能段完全一致**
#  （逐行对照过），只多了两类东西：
#    ① 注释：订阅要填在哪、面板在哪、哪些值不要动；
#    ② 一行被注释掉的 ipversion_prefer（原因见下）。
#  这么做是有意的：honk 处于 alpha，未知语法会让它**拒绝启动**，
#  所以出厂配置不做任何"我觉得更好"的改动，只把该写清楚的地方写清楚。
#
#  ⚠️ 本文件权限必须是 0600（prepare-build.sh 会强制收紧）。
#     honk 与 dae 同源，配置里天生要放订阅链接，因此不接受 group/other 可读。
#
#  ⚠️ honk 默认**不自启**（/etc/config/honk 里 enabled='0'、initialized='0'）。
#     首次使用：LuCI「服务 → Honk」→ 先「初始化」（它会做内核/网络自检），
#     再「启用」。预置成自启反而容易在自检未过时空转。
#
#  ── doona 面板 ────────────────────────────────────────────────────────────
#  doona 不是独立包，产物由 luci-app-honk 装进 /usr/share/doona，
#  再由下面 system.dae 的 native_api.ui 指出去，honk 自己在 127.0.0.1:9527
#  提供，所以浏览器要访问 http://<路由器IP>:9527/ui/（或从 LuCI 页面跳转）。
# ═══════════════════════════════════════════════════════════════════════════

include {
    system.dae
}

# 出站分组。policy 决定同一组内多个节点如何选：
# min_moving_avg = 按最近一段时间的平均延迟选最快（honk 新增的策略）。
group {
    proxy {
        policy: min_moving_avg
    }
}

# DNS：国内域名走阿里 DoH 直连，其余走 Google DoH 经代理。
# 这两条上游是**健康探测/解析用**，不是节点，可以留在预置里。
dns {
    upstream {
        default: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        remote: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> proxy
    }
    routing {
        request {
            qname(geosite: private) -> asis
            qname(geosite: cn) -> default
            fallback: remote
        }
    }

    # 若你的网络 IPv6 出口不稳（表现为间歇性解析超时 / 部分站点打不开），
    # 取消下面这行的注释，强制 DNS 优先用 IPv4。这一条在 dae 上是实测有效的
    # 修法，honk 沿用同一套配置语义；但本仓库没有在设备上验证过 honk 的
    # 行为，所以默认保持注释状态 —— 需要时再开。
    # ipversion_prefer: 4
}

# 分流：私有网段 / 国内 IP / 国内域名走直连，**其余全部交给 proxy 组**。
#
# ⚠️ fallback 是「上面所有规则都没命中」的那部分流量。kenzok8 包里自带的
#    上游配置写的是 `fallback: direct` —— 照抄过来就是「装了代理栈也永远不出国」：
#    进程在跑、doona 面板能开、日志一句报错没有，只是所有墙外流量都直连超时。
#    这里与 dae 线（files-dae/config.dae 的 `fallback: proxy`）对齐，改成 proxy。
#
#    还没填订阅时 proxy 组是空的，墙外照样不通 —— 那是预期行为（没节点可用），
#    不是这份配置的问题。想临时全直连（比如排障）就改回 direct 再重启 honk。
routing {
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    dip(geoip: private) && !dport(53) -> direct(must)
    dip(geoip: cn) && !dport(53) -> direct(must)
    domain(geosite: cn) -> direct
    fallback: proxy
}

# ── 订阅：需要你自己填 ────────────────────────────────────────────────────
# 固件是公开仓库的产物，任何有效订阅链接写进来就等于公开你的机场。
# 所以这里只放一个**注释掉的**示例，字段本身留着，值由使用者在设备上填
# （LuCI 的 Honk 页面可以填，也可以直接编辑本文件后重启 honk）。
#
# subscription {
#     my_sub {
#         url: 'https://example.com/api/v1/client/subscribe?token=在此填你的令牌'
#     }
# }
#
# 填完记得：
#   uci set honk.main.enabled='1'
#   uci set honk.main.initialized='1'
#   uci commit honk && /etc/init.d/honk restart
# （或者直接在 LuCI 里点「初始化」→「启用」，它会把 state 目录一并建好。）
