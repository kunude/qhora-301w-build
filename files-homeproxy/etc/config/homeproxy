# ═══════════════════════════════════════════════════════════════════════════
#  QHora-301W 出厂预置的 HomeProxy 配置（Custom routing 三分流）
#  ─────────────────────────────────────────────────────────────────────────
#  来源：本仓库 files-homeproxy/etc/config/homeproxy，由 prepare-build.sh
#        在叠加 files/ 之后按变体叠加进固件（只有 PROXY_STACK=homeproxy 的
#        固件会带它，passwall2 版不受影响）。
#
#  这份配置把 passwall2 那套「Reject / Direct / Proxy」三分流，等价搬到
#  HomeProxy 的 Custom routing（自定义路由）上：
#    · Reject ：广告域名      → action=reject（直接丢弃）
#    · Direct ：国内 + Apple + 抖音 + 银行域名 + 国内 IP → 直连
#    · Proxy  ：geolocation-!cn（境外）→ URLTest 代理组
#    · 其余未命中 → routing.default_outbound
#    · DNS    ：国内域名用 223.5.5.5 直连解析，其余用 8.8.8.8 的 DoH（经代理）
#
#  与 passwall2 版的字段对照（语义相同、结构不同）：
#    passwall2                     HomeProxy custom
#    ----------------------------  ------------------------------------------
#    nodes type=_urltest           routing_node 'main' (node=urltest)
#    shunt_rules Reject            ruleset 'ads' + routing_rule Reject(action=reject)
#    shunt_rules Direct            ruleset ×7   + routing_rule Direct(outbound=direct-out)
#    shunt_rules Proxy             ruleset 'noncn' + routing_rule Proxy(outbound=main)
#    node 的 Reject/_blackhole     routing_rule 的 action='reject'
#    default_node                  routing.default_outbound
#    remote_dns_doh / detour        dns_server 'remote_dns' (https 8.8.8.8, outbound=main)
#    直连 DNS                       dns_server 'direct_dns' (udp 223.5.5.5)
#
#  ❌ 不写进固件的（固件是公开仓库产物，凭据进来就等于公开）：
#     · 节点本身的地址 / 端口 / 密码 / UUID / REALITY 公钥
#     · 机场订阅链接（含 service id 与密钥）
#     ⇒ 出厂只预置「策略」（分流 / DNS / 选路 / 订阅开关），凭据由使用者自己补。
#     两条路：
#       A) 手动节点：填下面 node_vless / node_ss 里你实际用的那个即可
#       B) 订阅：在「节点 → Subscriptions」页填链接后更新（开关已预置，见
#          下面的 subscription 段）。注意订阅自动建出来的节点，section id 是
#          MD5(节点名)，固件没法预知 ⇒ 刷完要把它勾进 routing_node 'main' 的
#          URLTest 成员里（工程有现成的 uci 命令，见 README）。
#     ⚠️ 两个模板留空是可以的，但**此时必须保持 default_outbound='nil'**：
#        address 为空的节点生成的出站不合法，sing-box check 会 FATAL，
#        init 据此 return 1 —— 也就是说，节点没填就启用是起不来的
#        （好在它发生在改 dnsmasq / nft 之前，不会把 LAN 弄断）。
#
#  ⚠️ default_outbound 故意留 'nil'（= 不启动服务）——
#     /etc/init.d/homeproxy 的 start_service() 是这样判的：
#         custom 模式 → 取 routing.default_outbound（缺省即 'nil'）
#         非 custom  → 取 config.main_node
#     取到 'nil' 时直接 `return 1`，不生成配置、不起 sing-box。
#     节点还空着就启动的话，LAN 的解析与转发会被压到一条走不通的代理链上。
#     填好节点后二选一启用：
#       · 界面：LuCI「服务 → HomeProxy → 路由设置」→ Default outbound 选 Main
#       · 命令：uci set homeproxy.routing.default_outbound='main'
#               uci commit homeproxy && /etc/init.d/homeproxy restart
#
#  ⚠️ 三个实测踩过的坑：
#     1) 列表型选项必须写 list，不能写成 option x 'a' 'b'（uci 解析器只认
#        list 语法，单行多值会报 "Parse error: too many arguments"）。
#     2) routing_rule 段的先后顺序 = 匹配优先级，Reject 必须排在最前。
#     3) urltest_interval 要写「裸秒数」（生成器做的是 值 + 's'），
#        写成 '3m' 会得到 '3ms'。
# ═══════════════════════════════════════════════════════════════════════════

config homeproxy 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '0'
	option log_level 'warn'

config homeproxy 'routing'
	# ↓ 填好节点后再改成 'main'（或直接在界面里把 Default outbound 选成 Main）
	option default_outbound 'nil'
	# 解析节点地址（域名）用的解析器；default-dns = WAN 下发的那台，走直连
	option default_outbound_dns 'default-dns'
	option sniff_override '1'
	option bypass_cn_traffic '0'

config homeproxy 'dns'
	option dns_strategy 'prefer_ipv4'
	# 未命中 dns_rule 的查询默认走这台（经代理的 DoH）
	option default_server 'remote_dns'

# ── 订阅设置（开关全部预置，唯独 ❌ 不含订阅 URL）────────────────────────
#  刷完机在「服务 → HomeProxy → 节点 → Subscriptions」页填入你自己的订阅链接，
#  点「Update nodes from subscriptions」，节点会自动建出来（带分组标签页）。
#  ⚠️ 这里刻意没有 subscription_url —— 固件是公开产物，订阅链接里含机场的
#     service id 与密钥，写进预置等于把它们公开。仓库有构建期守卫
#     （scripts/check-no-credentials.sh）盯着这一点，写了会直接编不过。
#  · auto_update      每天定时自动更新订阅节点与规则资源。拉取失败时
#                     update_subscriptions.uc 会跳过该组、**保留旧节点**
#                     （node_cache 为空即 return），不会把节点清空。
#  · update_via_proxy 0 = 直连拉取订阅。首次填链接时还没有可用节点，只能直连；
#                     若你的订阅域名本身被墙，先手动加一个节点并启用，
#                     再把这项改成 1（经代理更新）。
#  · filter_nodes / filter_keywords
#                     机场常把「剩余流量 100G / 到期时间」塞成假节点，
#                     这里按关键词把它们过滤掉（与参考机实测配置一致）。
config homeproxy 'subscription'
	option auto_update '1'
	option auto_update_time '2'
	option update_via_proxy '0'
	option allow_insecure '0'
	option packet_encoding 'xudp'
	option filter_nodes 'blacklist'
	list filter_keywords '重置|到期|过期|剩余|套餐'
	list filter_keywords 'Expiration|Remaining'

# ── 节点模板 ①：VLESS + REALITY（推荐，抗封锁最好）──────────────────────
#    要填：address / uuid / tls_sni / tls_reality_public_key / tls_reality_short_id
#    协议、传输、TLS、uTLS 指纹、vision 流控都已经设好，不用动。
config node 'node_vless'
	option label 'VLESS-REALITY'
	option type 'vless'
	# ↓↓↓ 服务端地址（域名或 IP，不带 https:// 和端口）↓↓↓
	option address ''
	option port '443'
	# ↓↓↓ UUID ↓↓↓
	option uuid ''
	option vless_flow 'xtls-rprx-vision'
	option tls '1'
	# ↓↓↓ REALITY 伪装域名（SNI）↓↓↓
	option tls_sni ''
	option tls_reality '1'
	# ↓↓↓ REALITY 公钥 / short id ↓↓↓
	option tls_reality_public_key ''
	option tls_reality_short_id ''
	option tls_utls 'chrome'

# ── 节点模板 ②：Shadowsocks ─────────────────────────────────────────────
#    要填：address / port / password（加密方式按你的服务端改）
config node 'node_ss'
	option label 'Shadowsocks'
	option type 'shadowsocks'
	# ↓↓↓ 服务端地址 / 端口 / 密码 ↓↓↓
	option address ''
	option port '8388'
	option shadowsocks_encrypt_method 'aes-256-gcm'
	option password ''

# ── 出站：URLTest 自动选路组 ────────────────────────────────────────────
#  生成后的 tag 是 cfg-main-out，被 Proxy 规则和 DoH 下载 detour 引用。
config routing_node 'main'
	option label 'Main'
	option enabled '1'
	option node 'urltest'
	list urltest_nodes 'node_vless'
	list urltest_nodes 'node_ss'
	option urltest_url 'https://www.google.com/generate_204'
	option urltest_interval '180'
	option urltest_tolerance '50'
	option urltest_idle_timeout '1800'

# ── 规则集（固件预置的 .srs，type=local）────────────────────────────────
#  这 9 个二进制规则文件随固件打包在 /etc/homeproxy/ruleset/，
#  首次启动**零下载** ⇒ sing-box 必然起得来。
#
#  ⚠️ 出厂默认绝不能写成 type 'remote'，原因是一条很硬的链：
#     remote 是 sing-box **在服务启动那一刻**才去 url 下载（生成出来的
#     download_detour 还得经代理）。raw.githubusercontent.com 直连不通、只能走
#     代理，而能用的代理恰恰是这个还没起来的服务 —— 先有鸡后有蛋。任一规则
#     下载失败 ⇒ sing-box 起不来；而 /etc/init.d/homeproxy 早在起 sing-box
#     **之前**就把 dnsmasq 劫持到 127.0.0.1:5333 了 ⇒ DNS 全挂
#     ⇒ **整个 LAN 上不了网**（实测过：刷完配好节点一启用就断网）。
#     文件齐了 + local ⇒ 这条链根本不存在。
#
#  规则文件怎么保持最新：
#    · 编译期（推荐）：每次构建自动从上游拉最新 .srs 写进覆盖层 ——
#        scripts/fetch-homeproxy-rulesets.sh（prepare-build.sh 自动调用）。
#        关掉它用仓库固定版：RULESETS_REFRESH=0；要求"必须最新、否则别编"：
#        RULESETS_STRICT=1。
#    · 机器上：换掉 .srs 后 /etc/init.d/homeproxy restart 即可。
#    · 想恢复自动更新：界面里把某条的 Type 改成 Remote 并填 URL
#      （选 Local 时 URL 字段会自动隐藏，反之亦然）。
#    · 看固件里这份规则的来源与时间：cat /etc/homeproxy/rulesets.lock
#
#  ⚠️ type=local 时只认 format/path —— 多写 url/outbound/update_interval 会让
#     sing-box check 报 unknown field 而 FATAL，所以只留三个字段。
#
#  名字对应关系（三处必须一致：本文件、configs/homeproxy-rulesets.list、
#  files-homeproxy/etc/uci-defaults/95-homeproxy-rulesets；
#  构建期由 fetch-homeproxy-rulesets.sh 自动核对）

# 上游：…/sing-geosite/rule-set/geosite-category-ads-all.srs
config ruleset 'ads'
	option label 'Ads'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/ads.srs'

# 上游：…/sing-geosite/rule-set/geosite-cn.srs
config ruleset 'cn'
	option label 'CN'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/cn.srs'

# 上游：…/sing-geosite/rule-set/geosite-apple.srs
config ruleset 'apple'
	option label 'Apple'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/apple.srs'

# 上游：…/sing-geosite/rule-set/geosite-apple%40cn.srs   （%40 是 URL 编码的 @）
config ruleset 'apple_cn'
	option label 'AppleCN'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/apple_cn.srs'

# 上游：…/sing-geosite/rule-set/geosite-apple-update.srs
config ruleset 'apple_upd'
	option label 'AppleUpdate'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/apple_upd.srs'

# 上游：…/sing-geosite/rule-set/geosite-category-bank-cn.srs
config ruleset 'bank_cn'
	option label 'BankCN'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/bank_cn.srs'

# 上游：…/sing-geosite/rule-set/geosite-douyin.srs
config ruleset 'douyin'
	option label 'Douyin'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/douyin.srs'

# 上游：…/sing-geosite/rule-set/geosite-geolocation-!cn.srs
config ruleset 'noncn'
	option label 'NonCN'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/noncn.srs'

# 上游：…/sing-geoip/rule-set/geoip-cn.srs
config ruleset 'geoip_cn'
	option label 'GeoIPCN'
	option enabled '1'
	option type 'local'
	option format 'binary'
	option path '/etc/homeproxy/ruleset/geoip_cn.srs'

# ── 路由规则（段的先后顺序 = 匹配优先级，Reject 必须最先）──────────────

config routing_rule 'Reject'
	option label 'Reject'
	option enabled '1'
	option action 'reject'
	list rule_set 'ads'

config routing_rule 'Direct'
	option label 'Direct'
	option enabled '1'
	option action 'route'
	option outbound 'direct-out'
	list rule_set 'cn'
	list rule_set 'apple'
	list rule_set 'apple_cn'
	list rule_set 'apple_upd'
	list rule_set 'bank_cn'
	list rule_set 'douyin'
	list rule_set 'geoip_cn'

config routing_rule 'Proxy'
	option label 'Proxy'
	option enabled '1'
	option action 'route'
	option outbound 'main'
	list rule_set 'noncn'

# ── DNS ────────────────────────────────────────────────────────────────
#  国内域名 → direct_dns（223.5.5.5，直连）；其余 → remote_dns（DoH，经代理）
config dns_server 'remote_dns'
	option label 'RemoteDoH'
	option enabled '1'
	option type 'https'
	option server '8.8.8.8'
	option path '/dns-query'
	option outbound 'main'

config dns_server 'direct_dns'
	option label 'DirectUDP'
	option enabled '1'
	option type 'udp'
	option server '223.5.5.5'
	option outbound 'direct-out'

config dns_rule 'cn_dns'
	option label 'CNDNS'
	option enabled '1'
	option action 'route'
	option server 'direct_dns'
	list rule_set 'cn'
