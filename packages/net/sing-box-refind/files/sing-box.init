#!/bin/sh /etc/rc.common
#
# sing-box（reF1nd 源码编译版）的 procd 启动脚本
#
# 设计取舍：
#   · 启动前一定先跑 `sing-box check`。静默启动失败最难查 —— 日志里只有一行
#     FATAL，而 dnsmasq/防火墙可能已经把流量导过来了，表现是"整个 LAN 断网"。
#     这样失败会直接留在 logread 里，且 procd 不会反复重试一个配置错误的进程。
#   · 不做 nftables 规则。默认 config.json 用 **tun + auto_route + auto_redirect**，
#     路由/nft 由 sing-box 自己装（内部用 netlink 写 nft 表），省掉一整层手写规则，
#     也不会和 firewall4 抢表。
#     代价：所有流量都过一遍用户态，NSS 硬件加速不生效 —— 这是纯净线的已知取舍
#     （HomeProxy 线走 tproxy + nft 国内 IP 直连，不受影响）。
#   · reload 走 restart（sing-box 不支持 SIGHUP 重载配置）。

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/sing-box

start_service() {
	local enabled conffile workdir

	config_load sing-box
	config_get_bool enabled main enabled 0
	config_get conffile main conffile /etc/sing-box/config.json
	config_get workdir main workdir /etc/sing-box

	[ "$enabled" = "1" ] || {
		echo "sing-box: 未启用（/etc/config/sing-box 里 enabled=0）"
		return 0
	}

	[ -x "$PROG" ] || { echo "sing-box: 找不到 $PROG"; return 1; }
	[ -f "$conffile" ] || { echo "sing-box: 找不到配置文件 $conffile"; return 1; }

	# 配置自检。失败就别启动 —— 比启动后悄悄死循环好查得多。
	if ! "$PROG" check -c "$conffile" >/dev/null 2>&1; then
		echo "sing-box: 配置检查失败，明细如下：" >&2
		"$PROG" check -c "$conffile" 2>&1 | head -n 20 >&2
		return 1
	fi

	procd_open_instance main
	procd_set_param command "$PROG" run -c "$conffile" -D "$workdir"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$conffile"
	# 日志交给 procd 转发到 syslog：logread -e sing-box 就能看。
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sing-box
}

reload_service() {
	restart
}
