# SPDX-License-Identifier: GPL-2.0-only
#
# sing-box —— **源码编译版**（内核来自 reF1nd/sing-box，不是官方 SagerNet）
#
# 这是一个模板（.in），不是可直接构建的配方：
#   scripts/resolve-singbox-src.sh 在构建时把 @VER@ / @SHA@ / @HASH@ 三处替换掉，
#   再把渲染结果落位成 feeds/packages/net/sing-box（**覆盖** feed 里那份）。
#   故意命名为 Makefile.in —— extra-packages.sh 的"自带配方"循环用
#   find -name Makefile 扫描，不会误抓它。
#
# ── 为什么要这条通道（SINGBOX_MODE=source）──────────────────────────
# 之前两条路都有各自的问题：
#   · feed 的 sing-box（openwrt/packages 或 immortalwrt/packages）是**上游发布版**，
#     协议实现、各种 fix 要等 nekohasekai 打 tag 才有；
#   · 用 reF1nd 的 **预编译二进制**（reF1nd/sing-box-releases 的 tar.gz）能拿到最新，
#     但那是"外面套壳"：二进制不是本机构建、musl/CPU 特性不可控、也没法按需裁剪，
#     而它偏偏又要求 HomeProxy 侧有 clash_api.proxy_providers / cache_file.store_selected
#     两个补丁字段（上游 1.14.3 没有），壳与核被绑成一对。
# 这条通道把两件事解耦：内核**在本构建树里从源码编**（golang-package.mk 交叉编译，
# GOARCH/GOARM64/ABI 全部跟基座一致），版本由 PKG_SOURCE_VERSION 钉死，可复现。
#
# ── 为什么用 codeload tar.gz 而不是 git:// ──────────────────────────
# OpenWrt 的 git 下载器只会做完整 clone（不支持 --depth / --filter），sing-box
# 仓库带完整历史有几百 MB，每个 runner 都白拉一遍。codeload 的
#   https://codeload.github.com/reF1nd/sing-box/tar.gz/<sha>
# 只给该 commit 的树（~25MB），且能进 dl/ 缓存、有 PKG_HASH 可校验。
# 代价：换 commit 必须同时换 hash —— 这正是 resolve 脚本干的事。
#
# ── 构建标签：对齐上游 release 的 DEFAULT_BUILD_TAGS（去掉 naive）─────────
# 取自 reF1nd/sing-box@testing:release/DEFAULT_BUILD_TAGS。少了 badlinkname 会
# 在链接期报 //go:linkname 相关错误；tfogo_checklinkname0 是 tfo-go 的
# -checklinkname=0 配套。**故意不开 with_gvisor**：reF1nd 已把 gVisor 从默认
# 依赖里摘掉（commit "Remove dependency on gVisor"），开着它反而要拉旧 gvisor。
# 本线走 tproxy 入站（HomeProxy 那套），不依赖 tun 的 gvisor stack。
# **with_naive_outbound 也去掉了**，理由见下面 GO_PKG_TAGS 上方的长注释
# （一句话：cronet-go 的静态库是 glibc 的，musl 目标上根本编不出来）。
#
# ── 注意：这里不编前端 ────────────────────────────────────────────
# sing-box 没有 Web UI，Clash API 由 HomeProxy/其他面板消费。所以不需要 node/pnpm。

include $(TOPDIR)/rules.mk

PKG_NAME:=sing-box
PKG_VERSION:=@VER@
PKG_RELEASE:=1

PKG_SOURCE:=sing-box-refind-@SHA@.tar.gz
PKG_SOURCE_URL:=https://codeload.github.com/reF1nd/sing-box/tar.gz/@SHA@?
PKG_HASH:=@HASH@

# ── 解包：codeload 的 tar.gz 顶层多一层目录 ─────────────────────────
# `https://codeload.github.com/<owner>/<repo>/tar.gz/<sha>` 出来的树是
#   sing-box-<sha>/go.mod
#   sing-box-<sha>/cmd/sing-box/...
# 而 OpenWrt 默认的 PKG_UNPACK 只是 `tar -C $(PKG_BUILD_DIR)`，不剥顶层 ——
# 结果 $(PKG_BUILD_DIR) 下变成 sing-box-<sha>/go.mod，模块根不在 PKG_BUILD_DIR，
# golang-package.mk 直接报：
#   no required module provides package github.com/sagernet/sing-box/cmd/sing-box:
#   go.mod file not found in current directory or any parent directory
# （2026-10-26 那轮整机编译就死在这，见 run 40221304087）
# → 用 --strip-components=1 把那一层剥掉，让 PKG_BUILD_DIR 就是模块根。
# PKG_UNPACK 必须用 `=`（延迟展开）：$(TAR) 由 package.mk / tools 定义。
PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)
PKG_UNPACK=$(TAR) -xzf "$(DL_DIR)/$(PKG_SOURCE)" --strip-components=1 -C $(PKG_BUILD_DIR)

PKG_LICENSE:=GPL-3.0-or-later
PKG_LICENSE_FILES:=LICENSE
PKG_MAINTAINER:=reF1nd <https://github.com/reF1nd/sing-box>
PKG_CPE_ID:=cpe:/a:sagernet:sing-box

PKG_BUILD_DEPENDS:=golang/host
PKG_BUILD_PARALLEL:=1
PKG_BUILD_FLAGS:=no-mips16

GO_PKG:=github.com/sagernet/sing-box
GO_PKG_BUILD_PKG:=$(GO_PKG)/cmd/sing-box

# 与上游 release/DEFAULT_BUILD_TAGS **唯一的差别：去掉了 with_naive_outbound**。
#
# 为什么必须去掉（2026-10-26 实测，本地 go build 复现）：
#   with_naive_outbound → protocol/naive → cronet-go/all → cronet-go/lib/linux_arm64
#   而那个包的文件头是
#       //go:build linux && !android && arm64 && !with_musl && !with_purego
#       // #cgo LDFLAGS: -L${SRCDIR} -l:libcronet.a -ldl -lpthread -lrt -lm -lresolv
#   即：随包的 libcronet.a 是 **glibc** 静态库，被 `!with_musl` 明确挡在 musl 之外；
#   而当前 go.mod 钉的 cronet-go 版本里**根本没有 musl_arm64 目录**（只有 linux_arm64），
#   所以加 with_musl 只会变成"build constraints exclude all Go files"。
#   CGO_ENABLED=0 时同样报这一句；CGO_ENABLED=1（golang-package.mk 的默认）时
#   能编过，最后链接会撞上一堆 glibc 专有符号（__isoc99_sscanf 之类）而失败。
#   官方 immortalwrt/packages 的配方也把这一项做成 CONFIG_SING_BOX_BUILD_NAIVE_OUTBOUND
#   默认关、且额外 TARGET_LDFLAGS += -lcronet（要一个独立的 libcronet 动态库）。
#   → OpenWrt 这个 musl 目标上 naive 出站编不出来，只能不要。
#   用户若在配置里选了 naive，sing-box 会明确报 "naive is not included in this build"。
#
# 其余标签与上游 release/DEFAULT_BUILD_TAGS 逐字一致。要裁剪体积就继续从
# 这里删（例如去掉 with_tailscale / with_openvpn / with_openconnect 各能省几 MB，
#  但 HomeProxy 里若配了对应协议就会在 check 阶段报"tag 未编入"）。
GO_PKG_TAGS:=with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_tailscale,with_ccm,with_ocm,with_cloudflared,with_usbip,with_openvpn,with_openconnect,badlinkname,tfogo_checklinkname0

# 写法与上游 immortalwrt/packages 逐字对齐：
#   GO_PKG_LDFLAGS    链接器开关（-checklinkname=0）
#   GO_PKG_LDFLAGS_X  所有 -X 变量，golang-package.mk:242 会给每项自动加 `-X `
# 两处分开写**不是**必需（mk 最终都拼进同一条
#   -ldflags "$(GO_PKG_LDFLAGS) $(GO_PKG_LDFLAGS_X:%=-X %)"
# 字符串），照上游写只是为了以后 diff 上游时一眼能对上。
# runtime.godebugDefault 要 Go 1.26+ 的 runtime 支持，基座是 1.27，满足。
GO_PKG_LDFLAGS:=-checklinkname=0
GO_PKG_LDFLAGS_X:= \
	$(GO_PKG)/constant.Version=@VER@-refind \
	runtime.godebugDefault=multipathtcp=0,tlssha1=1

include $(INCLUDE_DIR)/package.mk
include ../../lang/golang/golang-package.mk

define Package/sing-box-default
  TITLE:=The universal proxy platform (reF1nd build)
  SECTION:=net
  CATEGORY:=Network
  URL:=https://github.com/reF1nd/sing-box
  # kmod-inet-diag / kmod-tun 与官方 feed 配方一致：前者给 auto_redirect 之外
  # 的 socket 诊断用，后者给 tun 入站。HomeProxy 只用 tproxy，但用户可能自己
  # 加 tun 入站，缺了会在运行期才暴露。
  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +kmod-inet-diag +kmod-tun
  USERID:=sing-box=5566:sing-box=5566
endef

define Package/sing-box
  $(Package/sing-box-default)
endef

define Package/sing-box/description
  Sing-box is a universal proxy platform which supports hysteria, SOCKS,
  Shadowsocks, ShadowTLS, Tor, trojan, VLESS, VMess, WireGuard and so on.

  This package is built **from source** at
  https://github.com/reF1nd/sing-box (a superset fork of SagerNet/sing-box),
  pinned to an exact commit. It is not the prebuilt binary from
  reF1nd/sing-box-releases.
endef

define Package/sing-box/conffiles
/etc/config/sing-box
/etc/sing-box/
endef

define Package/sing-box/install
	$(INSTALL_DIR) $(1)/usr/bin/
	$(INSTALL_BIN) $(GO_PKG_BUILD_BIN_DIR)/sing-box $(1)/usr/bin/sing-box

	$(INSTALL_DIR) $(1)/etc/sing-box
	$(INSTALL_DATA) ./files/config.json $(1)/etc/sing-box/config.json

	$(INSTALL_DIR) $(1)/etc/config/
	$(INSTALL_CONF) ./files/sing-box.conf $(1)/etc/config/sing-box
	$(INSTALL_DIR) $(1)/etc/init.d/
	$(INSTALL_BIN) ./files/sing-box.init $(1)/etc/init.d/sing-box
endef

$(eval $(call BuildPackage,sing-box))
