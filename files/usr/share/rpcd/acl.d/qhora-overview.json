{
	"luci-app-qhora-overview": {
		"description": "QHora 首页硬件区块：只读 CPU / 温度 / 内存",
		"read": {
			"ubus": {
				"file": [ "read", "list" ]
			},
			"file": {
				"/proc/stat": [ "read" ],
				"/proc/meminfo": [ "read" ],
				"/sys/class/thermal": [ "list" ],
				"/sys/class/thermal/*": [ "read" ],
				"/sys/class/hwmon": [ "list" ],
				"/sys/class/hwmon/*": [ "list" ],
				"/sys/class/hwmon/*/*": [ "read" ],
				"/sys/devices/system/cpu/cpufreq": [ "list" ],
				"/sys/devices/system/cpu/cpufreq/*": [ "list" ],
				"/sys/devices/system/cpu/cpufreq/*/*": [ "read" ]
			}
		}
	}
}
