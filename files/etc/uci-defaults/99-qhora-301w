#!/bin/sh
#
# QHora-301W 首次启动执行一次，执行成功后 OpenWrt 会自动删除本脚本。
#
# 做这几件事：改主机名；把 LAN 网段改成 192.168.35.0/24；
# 把 ddns-go / msd_lite 从"装了但没开"变成"开机自启"。
# 无线默认关闭且没有密钥，需要自己到「网络 -> 无线」开起来并设置密码。
#
# 执行时机：本脚本由 /etc/init.d/boot（START=10）在启动早期跑，
# 而 network 是 START=20 —— 所以下面改的 LAN 地址在「网络起来之前」
# 就已经写进 uci，首次开机直接就是 192.168.35.1，不需要再重启一次。
# （已在实际设备上核对过两个 START 值。）

# ── 主机名 ──────────────────────────────────────────────────
uci -q batch <<EOF
set system.@system[0].hostname='QHora-301W'
commit system
EOF

# ── LAN 网段：192.168.35.0/24 ───────────────────────────────
# 默认镜像是 192.168.1.1，这里换成 192.168.35.1。
# 用 /24 的 CIDR 写法，不管出厂那份 network 里 ipaddr 写的是带前缀
# 还是另配 netmask，都能得到同样的 /24。
# DHCP 范围不用动：/etc/config/dhcp 里 lan 的 start=100 limit=150 是
# 相对网段算的，自动就是 192.168.35.100-249。
#
# 加了 network.lan 存在性判断：万一某个固件里 LAN 段不叫 lan，
# 宁可不改，也不要让 uci 凭空多出一个名叫 lan 的空接口。
if uci -q get network.lan >/dev/null 2>&1; then
	uci -q set network.lan.ipaddr='192.168.35.1/24'
	uci -q commit network
else
	logger -t qhora-init "network.lan 不存在，跳过 LAN 网段设置"
fi

# ── ddns-go ─────────────────────────────────────────────────
# 这个包出厂是 enabled='0'，而 init 脚本的 start_service() 里还有一道
# `[ "$enabled" -eq "1" ] || return 1`。所以两件事都要做：
#   1) 打开 uci 里的开关（否则服务即使被 enable 也不会起）
#   2) enable init 脚本（建立 /etc/rc.d/S99ddns-go 链接）
# 起来之后 Web 界面在 http://<路由器IP>:9876，DDNS 记录在界面里配。
if [ -f /etc/config/ddns-go ]; then
	uci -q batch <<EOF
set ddns-go.config.enabled='1'
commit ddns-go
EOF
	/etc/init.d/ddns-go enable
fi

# ── msd_lite ────────────────────────────────────────────────
# 同样是出厂 enabled='0'，需要显式打开。
# 这里只改 enabled；接收组播的网卡（uci 的 network 项）保持出厂的空值，
# 因为它取决于 IPTV 组播源在你的网络里的位置，不适合替你猜。
if [ -f /etc/config/msd_lite ]; then
	uci -q batch <<EOF
set msd_lite.@instance[0].enabled='1'
commit msd_lite
EOF
	/etc/init.d/msd_lite enable
fi

# ── dnsmasq：放行 Windows 联网检测的私有地址应答 ─────────────
# dns.msftncsi.com 的 AAAA 记录是 fd3e:4f5a:5b81::1 —— 微软**故意**用一段
# ULA 地址（fc00::/7）让 Windows 校验 IPv6 通路是否可用。而 dnsmasq 默认开着
# stop-dns-rebind：应答里只要出现私有段/环回地址，一律丢弃并在 syslog 记
# "possible DNS-rebind attack detected"。
#
# 两者撞上的结果：
#   - 每台 Windows 每 30 秒探测一次 → syslog 被这条 warning 刷屏（实测一晚 198 条）
#   - IPv6 侧探测永远拿不到结果，Windows 可能误判"无法访问 Internet"
#   - 而 A 记录 131.107.255.255 是公网，正常通过，所以"能上网但报无网络"
#
# 只对这一个域名放行（--rebind-domain-ok），rebind 保护本身保持开启 ——
# 这是安全特性，不该为了消一条日志把它整个关掉。
if uci -q show dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	if ! uci -q get dhcp.@dnsmasq[0].rebind_domain 2>/dev/null | grep -qx 'dns.msftncsi.com'; then
		uci -q add_list dhcp.@dnsmasq[0].rebind_domain='dns.msftncsi.com'
		uci -q commit dhcp
	fi
fi

# ── WireGuard ───────────────────────────────────────────────
# 协议本身没有常驻服务，kmod 由 AutoProbe 在建立 wg 接口时自动加载，
# 这里没有需要启用的东西。隧道请到「网络 -> 接口」新建 wg 接口。

exit 0
