# NSS 补丁集的来源（由 scripts/apply-nss-patches.sh 读出来发成 CI 注解）
#
# 含义：把 NSS_FORK_COMMIT 相对 NSS_BASE_COMMIT 的全部改动做成一份补丁，
#       叠到 immortalwrt 基座上。再生成方法见本目录 README.md。
#
# 基座（谁提供内核 / DTS / 驱动 / feed）
NSS_BASE_REPOSITORY="openwrt/openwrt"
NSS_BASE_COMMIT="53ec2d05a487e6011cfa096de9211d15197c501b"
# NSS 改动的来源（fork 的分叉点 + 该分支末端提交）
NSS_FORK_REPOSITORY="JuliusBairaktaris/openwrt-nss-edma"
NSS_FORK_BRANCH="nss-edma-rework"
NSS_FORK_COMMIT="8520955773518b7c7bcf35cf029e118ac60e1d3b"

# 本补丁集在 ImmortalWrt 上**验证过**的基座提交：
# 用这一版基座完整编译通过，qnap_301w 的三个镜像都出了，产物校验（NSS 专属包 +
# 功能包是否真在 rootfs 清单里）全绿。基座往前走之后如果补丁的上下文对不上，
# 把工作流输入 imm_ref 钉回这个提交即可（`git apply` 对上下文偏移是宽容的，
# 钉回来一定打得中）。
IMM_VERIFIED_COMMIT="da63f7d6ac4207e534c9b92ba3d2b555a8edce8d"
IMM_VERIFIED_DATE="2026-10-15"
