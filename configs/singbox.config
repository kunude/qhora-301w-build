#
# sing-box 纯净内核线 —— .config 覆盖层（PROXY_STACK=singbox）
#
# 本文件**不单独使用**：scripts/prepare-build.sh 在 PROXY_STACK=singbox 时把它
# 拼在 configs/common.config 与 configs/qhora_301w.config 之后（后拼接的覆盖前者）。
# 其它 PROXY_STACK 取值根本不读它。
#
# ── 这条线是什么 ────────────────────────────────────────────────
# **不装任何 LuCI 代理前端**，只有：
#     /usr/bin/sing-box            ← reF1nd/sing-box 源码编译（SINGBOX_MODE=source）
#     /etc/init.d/sing-box         ← 包自带的 procd 脚本（启动前 sing-box check）
#     /etc/config/sing-box         ← 覆盖层里改成 enabled=1
#     /etc/sing-box/config.json    ← 默认 tun + auto_route + auto_redirect
# 分流、订阅、节点全部靠手改 config.json —— 这是"不套壳"的代价，换来的是
# 没有 ucode 生成层、没有 nftables 规则层、行为完全可预测。
#
# ── 与 HomeProxy 线的取舍（选这条之前必须知道）────────────────────
#   · HomeProxy 线：nftables 把「国内 IP」在内核里直连（china_ip4 集合），
#     只有出境流量进 sing-box。NSS 硬件加速对直连流量有效。
#   · 本线：默认 tun + auto_redirect，**所有**流量都过一遍用户态。
#     代价是吞吐下降、NSS 卸载不生效；好处是不用维护任何 nft 规则。
#     要拿回性能，就在 config.json 里把 inbound 换成 tproxy、自己挂 nft 规则
#     （HomeProxy 生成的 /etc/nftables.d/ 里有现成范例可抄）。
#
# ⚠️ "关掉"的行一律写 CONFIG_X=n，不写 `# CONFIG_X is not set` ——
#    原因见 configs/homeproxy.config 头部（prepare-build.sh 按"最后一个赋值"判定）。
#

## ═══════════════════════════════════════════════════════════
## 一、关掉 passwall2 全家（与 dae / daed 线同一套）
## ═══════════════════════════════════════════════════════════
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=n

## passwall2 专属依赖。本线一个都不用。
## （最省的仍是 shadowsocks-rust-sslocal —— 不编它就不用拉 Rust 工具链。）
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n

## HomeProxy 也不装（双保险：common.config 本来没选它，万一将来选了也压住）。
## 它的 ucode 生成器 + rpcd 后端 + LuCI 视图对纯净线毫无用处，白占 ~1.5MB。
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=n

## dae / daed 与本线抢同一份流量，显式关掉并兼作反向断言。
CONFIG_PACKAGE_dae=n
CONFIG_PACKAGE_daed=n
CONFIG_PACKAGE_luci-app-dae=n
CONFIG_PACKAGE_luci-app-daed=n

## ═══════════════════════════════════════════════════════════
## 二、打开 sing-box（内核从源码编）
## ═══════════════════════════════════════════════════════════
## 这三条同时是**断言目标**：prepare-build.sh 第 3 步会确认它们在 defconfig
## 之后仍然是 y。少一条就说明包没被 feed 接管、或者被别的符号顶掉了。
##   sing-box        内核本体（SINGBOX_MODE=source 时由本仓库配方覆盖 feed）
##   kmod-tun        tun 入站的设备节点（/dev/net/tun）
##   kmod-inet-diag  sing-box 的 auto_redirect / 进程匹配要用 inet_diag
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

## 内核侧还要 nftables —— 不是给 sing-box 用的，而是 auto_redirect 会写
## nft 表（sing-box 内部用 netlink，不需要 nft 命令行工具）。
## firewall4 是镜像默认项，这里不重复写。
