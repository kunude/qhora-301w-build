#
# 通用构建配置 —— NSS 卸载栈 + 与本机型号无关的选项
#
# 本文件与 configs/qhora_301w.config 一起被 scripts/prepare-build.sh 拼接成 .config，
# 然后执行 make defconfig。后拼接的文件（设备文件）在冲突的符号上覆盖前者。
#
# 内容取自上游作者维护的 Qualcommax_NSS_Builder（devices/common/config），
# 那是这套 NSS 栈唯一被持续验证过的配置组合，尽量不要随意删改。
#

## ── 目标平台 ────────────────────────────────────────────────
CONFIG_TARGET_qualcommax=y
## 子目标（ipq807x）在 configs/qhora_301w.config 中指定。

## ── 镜像格式 ────────────────────────────────────────────────
## squashfs 是默认且唯一被官方支持的 rootfs。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
## 同时生成 initramfs 镜像（...-initramfs-uImage.itb）。
## QHora-301W 首次安装必须用它：进 U-Boot 后用 TFTP 引导 initramfs，
## 再在 initramfs 里 sysupgrade 刷入 squashfs 固件。
## 单机型构建没有上游"多机型共用镜像导致内核超限"的问题，可以放心打开。
CONFIG_TARGET_ROOTFS_INITRAMFS=y

## ── 编译器与工具链 ──────────────────────────────────────────
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y

## ── 内核构建选项 ────────────────────────────────────────────
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y

## 内核版本串里的 "user@host"（uname -a / 启动日志 [0.000000] 那行可见）。
## 必须在**这里**写死：include/kernel.mk 第 110–111 行是以 make 变量形式把
##   KBUILD_BUILD_USER="$(call qstrip,$(CONFIG_KERNEL_BUILD_USER))"
##   KBUILD_BUILD_HOST="$(call qstrip,$(CONFIG_KERNEL_BUILD_DOMAIN))"
## 传给内核的，而 make 命令行变量**优先级高于环境变量** —— 工作流里 echo 到
## $GITHUB_ENV 的那两个 KBUILD_BUILD_* 对内核构建完全无效（实测：内核串里出现的是
## GitHub runner 的随机主机名 runner@runnervmb40mh）。
## 留空的后果：回落到构建机的 whoami/hostname，每次编出来的内核镜像都不同，
## 可复现构建在内核这一层失效。这两个默认值本身就是空（除非开了 BUILDBOT）。
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github-actions"

## ── 加固选项 ────────────────────────────────────────────────
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## ── SSH 服务端 ──────────────────────────────────────────────
CONFIG_PACKAGE_dropbear=n
CONFIG_PACKAGE_openssh-moduli=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y

## ── TLS / 加密库 ────────────────────────────────────────────
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_apk-mbedtls=n
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-oqsprovider=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-bcp38=y

## ── 常用工具 ────────────────────────────────────────────────
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=n
CONFIG_PACKAGE_iperf3=y
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_wpad-openssl=y

## ── USB 存储 ────────────────────────────────────────────────
## 官方 kmods feed 跟本内核版本对不上，只能编进镜像。
## kmod-fs-ext4 是该 target 的默认包。
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

## ── TUN（Tailscale / OpenVPN 等需要）────────────────────────
CONFIG_PACKAGE_kmod-tun=y

## ── 去掉与上面重复的默认包 ──────────────────────────────────
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n

## ── ath11k 每 STA 的 debugfs ────────────────────────────────
## nss_stats 依赖它读每 peer 的固件统计（A-MSDU 聚合、OFDMA、MPDU 重传计数）。
CONFIG_ATH11K_DEBUGFS_STA=y

## ── NSS 数据面 + 连接卸载（ECM / PPPoE）─────────────────────
## kmod-qca-ppe-nss（数据面胶水层）由 kmod-qca-nss-drv 自动拉入。
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
## 有线 LAN 网桥转发的硬件卸载。
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
## IGMP/MLD 网桥 snooping，打开 ECM 组播分类器（ECM_MULTICAST_ENABLE），
## 让被 snooping 的组播在 PPE 硬件里复制而不是泛洪到 CPU。
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
## 路由型三层组播（IPTV，WAN->LAN）还需要一个用户态 mroute 守护进程来填充
## 内核 MFC，ECM 才能逐条卸载 MFC。默认不打包，需要时自己选 igmpproxy/smcroute。
# CONFIG_PACKAGE_igmpproxy is not set
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

## ── ath11k NSS Wi-Fi 卸载（wifili）──────────────────────────
## 开机先走 host 模式（nss_offload=0, frame_mode=2），
## /usr/sbin/nss-up 再把射频切到 NSS 数据面。
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y

## ── NSS qdisc / SQM ────────────────────────────────────────
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y

## ── NSS 运行期工具 ──────────────────────────────────────────
## nss-tools 提供 'nss' 开机服务、nss-up 启动逻辑、nss-status 健康报告
## （LuCI: 状态 -> NSS Offload）和 edma-dump 寄存器抓取，
## 并会通过依赖把整套 NSS 运行期包拉进来。
CONFIG_PACKAGE_nss-tools=y
CONFIG_PACKAGE_luci-app-nss=y

## ── DSCP 标记 + SQM 快车道 ──────────────────────────────────
## 配置：/etc/config/nssqos；界面：网络 -> QoS Marking (NSS)。
## 对已被 NSS 加速的流同样生效。
CONFIG_PACKAGE_nssqos=y
CONFIG_PACKAGE_luci-app-nssqos=y

## ── 诊断 ────────────────────────────────────────────────────
## 固件路径报文镜像 + 实时 NSS 统计查看器；按需加载，默认不生效。
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

## ── edma-dump 需要 /dev/mem 和 busybox 的 devmem applet ──────
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

## ── 崩溃取证 ────────────────────────────────────────────────
## 把内核 console / panic 记录留在板子的 ramoops 区域里跨重启保存，
## 下次开机归档到 /root/pstore。
CONFIG_PACKAGE_kmod-ramoops=y

## ═══════════════════════════════════════════════════════════
## 以下这些包官方 feed 里没有，由 scripts/extra-packages.sh 引入，
## 分三种来源（详见那个脚本的头部说明）：
##   ① 本仓库自带配方（引上游源码，或直接抄脚本） ddns-go / msd_lite / autocore
##   ② ImmortalWrt 的纯前端页面        luci-app-ddns-go / luci-app-msd_lite
##   ③ Openwrt-Passwall 组织的仓库      luci-app-passwall2 + 17 个依赖组件
## 外加一个 LuCI 中文总开关。
## ═══════════════════════════════════════════════════════════

## ── LuCI 中文界面 ───────────────────────────────────────────
## 这是打开 LuCI 汉化的唯一可控开关，必须写它，不能只写 luci-i18n-* 包。
## 原因：luci.mk 里生成的每个 luci-i18n-<包>-<语言> 包都带 HIDDEN:=1，
## 于是 scripts/package-metadata.pl 第 367-368 行把它写成
##     config PACKAGE_luci-i18n-xxx-zh-cn
##         bool                      <- 注意：没有标题，是个空 prompt
##         default LUCI_LANG_zh_Hans||(ALL&&m)
## 而 scripts/config/symbol.c 第 356-366 行规定：只有当 sym->visible != no 时
## 才会采用 .config 里的用户值，否则一律回落到 default。
## LUCI_LANG_zh_Hans 是 luci-base 在 Config.in 里带标题的正常 tristate，
## 一定能被 .config 赋值；它 =y 之后上面那个 default 就成立，
## 所有 luci 包的简体中文翻译会一起被打开（不止 ddns-go / msd_lite）。
##
## 位置也有讲究：LUCI_LANG_zh_Hans 由 luci-base 的 config 段生成，
## 所以 luci-base 必须被选中（它是所有 luci-app-* 的依赖，已经 =y）。
CONFIG_LUCI_LANG_zh_Hans=y

## ── 动态 DNS：ddns-go ───────────────────────────────────────
## 来源：ImmortalWrt 的 packages / luci feed（openwrt/packages 里没有这个包）。
## 出厂配置 enabled=0 且 init 脚本不会自动 enable，
## 首次启动由 files/etc/uci-defaults/99-qhora-301w 打开。
## Web 界面在 9876 端口，DDNS 记录本身要在界面里配。
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
## 由上面的 CONFIG_LUCI_LANG_zh_Hans=y 带出来（default 成立），
## 写在这里是为了把意图写清楚，同时也是符号校验的断言目标。
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

## ── IPTV 组播转 HTTP：msd_lite ──────────────────────────────
## 来源同上。默认监听 0.0.0.0:7088 / [::]:7088，
## 客户端按 http://<路由器IP>:7088/udp/<组播地址>:<端口> 取流。
## 出厂 enabled=0，同样由 uci-defaults 打开。
## 注意：接收组播的网卡要在 LuCI 里选（uci 的 network 项），
## 默认留空，取决于你的 IPTV 拓扑（组播源在 WAN 侧还是 LAN 侧）。
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y

## ── WireGuard ───────────────────────────────────────────────
## 这三样都在官方源里，不需要额外引入：
##   kmod-wireguard       主源码树 package/kernel/linux/modules/netsupport.mk
##                        AUTOLOAD 用 AutoProbe，建立 wg 接口时自动加载内核模块
##   wireguard-tools      主源码树 package/network/utils/wireguard-tools
##   luci-proto-wireguard luci feed protocols/luci-proto-wireguard
##                        （会顺带拉入 ucode、luci-lib-uqr、resolveip）
## 协议本身没有常驻服务，"启用"就是装好包；具体隧道要建一个 wg 接口。
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## ── 科学上网：passwall2 ─────────────────────────────────────
## 来源：**Openwrt-Passwall** 组织的两个仓库。注意 passwall 项目已经不在个人账号
## xiaorouji 下了（那里现在返回 404），迁到了这个组织：
##   openwrt-passwall2          界面 + 运行脚本（只有这一个包）
##   openwrt-passwall-packages  17 个依赖组件的配方（xray-core / sing-box / …）
##   openwrt-passwall           只含 v1 的 luci-app-passwall，本仓库不用
##
## 由 scripts/extra-packages.sh 浅克隆后落进 feeds/packages/net/ 与
## feeds/luci/applications/。**版本不做注入**：这些组件的配方和上游版本是同步
## 维护的（bump 版本时 PKG_VERSION / PKG_HASH / 编译标签一起改），所以每次构建
## 取一次上游 main 就是最新的，不会像 ImmortalWrt 抄 ddns-go 那样慢半拍。
## 本轮实际取到的版本会发成 `passwall2 项目版本` / `passwall 组件版本` 两条 notice 注解。
##
## ⚠️ 有 4 个组件与官方 feed 同名：microsocks / sing-box / v2ray-geodata / xray-core。
##    落位时是本仓库这份**覆盖**官方那份 —— passwall 上游 CI 也是让 passwall feed
##    排在 feeds.conf 最前面取胜，效果一致（其余 13 个官方 feed 里没有）。
##
## ⚠️ shadowsocks-rust / shadow-tls 的配方写着 PKG_BUILD_DEPENDS:=rust/host，
##    编它们要拉 Rust 工具链（prebuilt 下载 + cargo 编译，构建时间大概多 15~25 分钟）。
##
##    SS-Rust 客户端（sslocal）**必须编**，不能省：passwall2 里节点类型为 SS-Rust
##    的节点是直接 exec /usr/bin/sslocal 的（app.sh 的 ss-rust 分支 →
##    ln_run "$(first_type sslocal)" "sslocal"），缺了它运行日志会报
##    「sslocal not found, unable to start...」，透明代理/分流就起不来。
##    典型场景：从其它固件恢复了 passwall2 配置，里面 SS 节点的 type 就是 SS-Rust
##    （那台机器上有 sslocal），换到本固件后就缺了。
##    服务端（ssserver）用不上，继续关着；shadow-tls 同理（SIP003 插件，可选）。
CONFIG_PACKAGE_luci-app-passwall2=y
## 由 CONFIG_LUCI_LANG_zh_Hans=y 带出来（见上面 LuCI 中文那段的原理），
## 写在这里同时作为符号校验的断言目标。
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

## 核心程序：只留 sing-box，**不编 xray**。
## sing-box 原生支持 SS / SSR / VMess / VLESS / Trojan / Hysteria2 / WireGuard 等
## 全部协议，分流（_shunt）也是它自己用 route.rules 实现的，用不到 xray；
## 少编一个 xray-core 能省下约 20MB 镜像空间和几分钟构建时间。
## 注：上游对 aarch64 的默认值是 "All"（xray + sing-box），这里改成 SingBox。
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y

## 透明代理走哪套。这份配置用的是 firewall4（nftables），所以只开 nftables 那支。
## 这一支会 select：chinadns-ng、dnsmasq-full、dnsmasq_full_nftset、nftables、
## kmod-nft-socket、kmod-nft-tproxy、kmod-nft-nat。
## 选中 dnsmasq-full 会把镜像里默认的 dnsmasq 挤掉，但**不需要**手写
## CONFIG_PACKAGE_dnsmasq=n —— scripts/package-metadata.pl 的
## add_implicit_provides_conflicts() 会给默认变体补一条
##     depends on m || (PACKAGE_dnsmasq-full != y)
## kconfig 自己就会取消选择（见 mconf_conflicts() 生成的 "depends on !PACKAGE_x"）。
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n

## 组件开关 —— 都是上游对 aarch64 的默认值，写出来为了把意图写清楚 + 断言。
## INCLUDE_Haproxy 拉的是官方 feed 的 haproxy（多节点负载均衡用）。
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n

## 依赖组件里必须存在的那些（都被上面的选项 select 进来）。
## 写在这里的价值：让 prepare-build.sh 的符号校验替我们确认这些配方真的落位、
## 真的被 feeds 索引扫到了。少了任何一条，构建会在十几分钟内失败，
## 而不是等两个小时才发现镜像里缺组件。
##
## 注意这里**没有** xray-core：配方仍然被落位（extra-packages.sh 会遍历上游全部
## 组件），只是不选中、不编译。Basic_Core_SingBox 也保证没有任何 select 会把它拉回来。
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_v2ray-plugin=y

## ── luci-app-statistics：CPU / 内存 / 温度 / 无线的**历史图表** ──
## 别和首页那两行搞混：首页的「CPU 占用率 / 温度」是**瞬时值**，
## 由 ImmortalWrt 版 luci-base + luci-mod-status 渲染（见 extra-packages.sh ②）；
## 这里装的是 collectd 采样的**历史曲线**，入口在「状态 -> 统计」，
## 能看趋势、能留长期记录，两者互补。
## luci-app-statistics 会顺带拉入 collectd + rrdtool1 以及 cpu / memory /
## interface / load / iwinfo / rrdtool 这些采集插件；温度插件
## collectd-mod-thermal **不在**它的默认依赖里，要单独写出来。
## 采集开关在 /etc/config/luci_statistics：thermal 出厂是 enable='0'，
## 由 files/etc/uci-defaults/99-luci-statistics 在开机时打开。
## 界面：状态 -> 统计（中文翻译由 CONFIG_LUCI_LANG_zh_Hans=y 带出）。
## 体积：collectd + rrdtool1 + 插件 ≈ +3~4MB。
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-thermal=y

## ── autocore：/sbin/tempinfo、/sbin/cpuinfo ────────────────
## 这是 ImmortalWrt 首页「Temperature」那一行背后的包（从 Lean 的 lede 继承）。
## 它本身只是个纯脚本包，提供两个可执行脚本：
##   /sbin/tempinfo   → "CPU: 52.3°C, WiFi: 61.0°C"
##   /sbin/cpuinfo    → CPU 型号字符串
## 配方抄在 packages/emortal/autocore/（本仓库自带那类，见 extra-packages.sh ①）。
##
## 首页那两行（CPU 占用率 / 温度）的完整链路是**三处凑齐**：
##     10_system.js → ubus luci.getTempInfo / getCPUInfo / getCPUUsage
##                  → popen /sbin/tempinfo、/sbin/cpuinfo、`top -n1 | awk …`
##   ① 本包（autocore）  提供 /sbin/tempinfo、/sbin/cpuinfo 与授权 ACL
##   ② ImmortalWrt 版 luci-base 的 rpcd ucode 插件提供上面那三个 ubus 方法
##      （官方 openwrt/luci 没有：两边的 libs/rpcd-mod-luci/src/luci.c 逐字节相同，
##        实现只存在于 luci-base 的 root/usr/share/rpcd/ucode/luci）
##   ③ ImmortalWrt 版 luci-mod-status 的 10_system.js 负责渲染
## ② ③ 由 extra-packages.sh 的 ② 段从 immortalwrt/luci 稀疏检出，与本包成对生效：
## **少任何一环，首页就既没有温度、也没有 CPU 占用率。**
## 位置也因此是上游原生的：温度/CPU 画在「系统」块里（页面顶部），
## 内存仍由标准 20_memory.js 排在第二块 —— 不需要任何自写 JS。
##
## 装 tempinfo 是有条件的：配方里写着只对 ipq% / mediatek% / qualcommax% 目标安装，
## 我们是 qualcommax ✓；cpuinfo 则是所有架构都装。
## 依赖：只有 x86 才要 lm-sensors / ethtool，qualcommax 上没有任何额外依赖。
CONFIG_PACKAGE_autocore=y
