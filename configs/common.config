#
# 通用构建配置 —— NSS 卸载栈 + 与本机型号无关的选项
#
# 本文件与 configs/qhora_301w.config 一起被 scripts/prepare-build.sh 拼接成 .config，
# 然后执行 make defconfig。后拼接的文件（设备文件）在冲突的符号上覆盖前者。
#
# 内容取自上游作者维护的 Qualcommax_NSS_Builder（devices/common/config），
# 那是这套 NSS 栈唯一被持续验证过的配置组合，尽量不要随意删改。
#

## ── 目标平台 ────────────────────────────────────────────────
CONFIG_TARGET_qualcommax=y
## 子目标（ipq807x）在 configs/qhora_301w.config 中指定。

## ── 镜像格式 ────────────────────────────────────────────────
## squashfs 是默认且唯一被官方支持的 rootfs。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
## 同时生成 initramfs 镜像（...-initramfs-uImage.itb）。
## QHora-301W 首次安装必须用它：进 U-Boot 后用 TFTP 引导 initramfs，
## 再在 initramfs 里 sysupgrade 刷入 squashfs 固件。
## 单机型构建没有上游"多机型共用镜像导致内核超限"的问题，可以放心打开。
CONFIG_TARGET_ROOTFS_INITRAMFS=y

## ── 编译器与工具链 ──────────────────────────────────────────
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y

## ── 内核构建选项 ────────────────────────────────────────────
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y

## ── 加固选项 ────────────────────────────────────────────────
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## ── SSH 服务端 ──────────────────────────────────────────────
CONFIG_PACKAGE_dropbear=n
CONFIG_PACKAGE_openssh-moduli=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y

## ── TLS / 加密库 ────────────────────────────────────────────
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_apk-mbedtls=n
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-oqsprovider=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-bcp38=y

## ── 常用工具 ────────────────────────────────────────────────
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=n
CONFIG_PACKAGE_iperf3=y
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_wpad-openssl=y

## ── USB 存储 ────────────────────────────────────────────────
## 官方 kmods feed 跟本内核版本对不上，只能编进镜像。
## kmod-fs-ext4 是该 target 的默认包。
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

## ── TUN（Tailscale / OpenVPN 等需要）────────────────────────
CONFIG_PACKAGE_kmod-tun=y

## ── 去掉与上面重复的默认包 ──────────────────────────────────
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n

## ── ath11k 每 STA 的 debugfs ────────────────────────────────
## nss_stats 依赖它读每 peer 的固件统计（A-MSDU 聚合、OFDMA、MPDU 重传计数）。
CONFIG_ATH11K_DEBUGFS_STA=y

## ── NSS 数据面 + 连接卸载（ECM / PPPoE）─────────────────────
## kmod-qca-ppe-nss（数据面胶水层）由 kmod-qca-nss-drv 自动拉入。
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
## 有线 LAN 网桥转发的硬件卸载。
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
## IGMP/MLD 网桥 snooping，打开 ECM 组播分类器（ECM_MULTICAST_ENABLE），
## 让被 snooping 的组播在 PPE 硬件里复制而不是泛洪到 CPU。
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
## 路由型三层组播（IPTV，WAN->LAN）还需要一个用户态 mroute 守护进程来填充
## 内核 MFC，ECM 才能逐条卸载 MFC。默认不打包，需要时自己选 igmpproxy/smcroute。
# CONFIG_PACKAGE_igmpproxy is not set
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

## ── ath11k NSS Wi-Fi 卸载（wifili）──────────────────────────
## 开机先走 host 模式（nss_offload=0, frame_mode=2），
## /usr/sbin/nss-up 再把射频切到 NSS 数据面。
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y

## ── NSS qdisc / SQM ────────────────────────────────────────
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y

## ── NSS 运行期工具 ──────────────────────────────────────────
## nss-tools 提供 'nss' 开机服务、nss-up 启动逻辑、nss-status 健康报告
## （LuCI: 状态 -> NSS Offload）和 edma-dump 寄存器抓取，
## 并会通过依赖把整套 NSS 运行期包拉进来。
CONFIG_PACKAGE_nss-tools=y
CONFIG_PACKAGE_luci-app-nss=y

## ── DSCP 标记 + SQM 快车道 ──────────────────────────────────
## 配置：/etc/config/nssqos；界面：网络 -> QoS Marking (NSS)。
## 对已被 NSS 加速的流同样生效。
CONFIG_PACKAGE_nssqos=y
CONFIG_PACKAGE_luci-app-nssqos=y

## ── 诊断 ────────────────────────────────────────────────────
## 固件路径报文镜像 + 实时 NSS 统计查看器；按需加载，默认不生效。
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

## ── edma-dump 需要 /dev/mem 和 busybox 的 devmem applet ──────
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

## ── 崩溃取证 ────────────────────────────────────────────────
## 把内核 console / panic 记录留在板子的 ramoops 区域里跨重启保存，
## 下次开机归档到 /root/pstore。
CONFIG_PACKAGE_kmod-ramoops=y

## ═══════════════════════════════════════════════════════════
## 以下三项由 scripts/extra-packages.sh 引入（官方 feed 里没有）
## ═══════════════════════════════════════════════════════════

## ── 动态 DNS：ddns-go ───────────────────────────────────────
## 来源：ImmortalWrt 的 packages / luci feed（openwrt/packages 里没有这个包）。
## 出厂配置 enabled=0 且 init 脚本不会自动 enable，
## 首次启动由 files/etc/uci-defaults/99-qhora-301w 打开。
## Web 界面在 9876 端口，DDNS 记录本身要在界面里配。
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

## ── IPTV 组播转 HTTP：msd_lite ──────────────────────────────
## 来源同上。默认监听 0.0.0.0:7088 / [::]:7088，
## 客户端按 http://<路由器IP>:7088/udp/<组播地址>:<端口> 取流。
## 出厂 enabled=0，同样由 uci-defaults 打开。
## 注意：接收组播的网卡要在 LuCI 里选（uci 的 network 项），
## 默认留空，取决于你的 IPTV 拓扑（组播源在 WAN 侧还是 LAN 侧）。
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y

## ── WireGuard ───────────────────────────────────────────────
## 这三样都在官方源里，不需要额外引入：
##   kmod-wireguard       主源码树 package/kernel/linux/modules/netsupport.mk
##                        AUTOLOAD 用 AutoProbe，建立 wg 接口时自动加载内核模块
##   wireguard-tools      主源码树 package/network/utils/wireguard-tools
##   luci-proto-wireguard luci feed protocols/luci-proto-wireguard
##                        （会顺带拉入 ucode、luci-lib-uqr、resolveip）
## 协议本身没有常驻服务，"启用"就是装好包；具体隧道要建一个 wg 接口。
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
