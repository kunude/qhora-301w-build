#
# honk 代理栈 —— eBPF 透明代理（dae 那一支的新引擎）+ doona 面板
#
# 本文件**不单独使用**：scripts/prepare-build.sh 在 PROXY_STACK=honk 时把它拼在
# configs/common.config 与 configs/qhora_301w.config 之后（后拼接的覆盖前者），
# 其余 PROXY_STACK 取值根本不读本文件。
#
# ── honk 是什么 ────────────────────────────────────────────────
# daeuniverse/honk：Rust 写的 eBPF 透明代理，配置语法沿用 dae，出站组 / Clash
# 兼容 API 借自 sing-box。与 dae / daed 是**同一族**（内核态分流、不建 TPROXY
# 回环），所以内核前提几乎一样：BTF + cls_bpf + NFQUEUE + bpffs。
#
# ⚠️ 上游自述 alpha（当前核心版本 0.0.1-alpha），量产前请自己压测。
#
# ── doona 面板在哪 ────────────────────────────────────────────
# doona（Zakkaus/doona）是 honk 原生 API 的**静态 Web 界面**，不单独成包：
# kenzok8 的 luci-app-honk 把它的产物装到 /usr/share/doona，honk 的
# system.dae 里写着 `native_api { ui: '/usr/share/doona' }`，由 honk 自己在
# 127.0.0.1:9527/ui/ 提供。所以「装 honk 就有 doona」，LuCI 里那个 Honk 菜单
# 是它的入口页（Overview / Configuration / Logs / Maintenance 四个页签）。
#
# ── 包从哪来 ──────────────────────────────────────────────────
# 与 dae / daed（走基座官方 feed）不同，honk 的配方只在 kenzok8/small：
#   honk            预编译核心（kenzok8 的 CI 从 daeuniverse/honk 源码交叉
#                   编译，aarch64 资产），配 init / control.sh / 默认 config.dae
#   luci-app-honk   LuCI 页面 + rpcd 后端 + **doona 面板**
# prepare-build.sh 会把这两个包名并进 EXTRA_PACKAGES 走 small 那条通用链路，
# 并在 feeds install 之后补齐 small 里缺的构建元数据（generated-stage.mk /
# generated-doona-stage.mk / generated-provenance.json，见
# scripts/fetch-honk-stage.sh）。所以本文件只负责「选中 + 关掉别的栈」。
#
# ⚠️ "关掉"的行一律写 CONFIG_X=n，不写 `# CONFIG_X is not set` ——
#    原因见 configs/homeproxy.config 头部（prepare-build.sh 按"最后一个赋值"判定，
#    注释行会被过滤掉，于是 common.config 里的 =y 仍会被拿去断言，必然失败）。
#

## ═══════════════════════════════════════════════════════════
## 一、关掉 passwall2 全家（与 dae / daed 线同一套）
## ═══════════════════════════════════════════════════════════
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=n

## passwall2 专属依赖。honk 一个都不用（内核态分流 + 自带 DNS 段）。
## 关掉最省的仍是 shadowsocks-rust-sslocal —— 它 PKG_BUILD_DEPENDS:=rust/host，
## 不编它就不用拉 Rust 工具链（honk 核心是**预编译二进制**，不需要 Rust）。
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n

## sing-box 是 common.config 为 passwall2 / homeproxy 选的，honk 不需要。
CONFIG_PACKAGE_sing-box=n

## dae / daed 也不能同时装：三者都是「往 clsact qdisc 上挂 eBPF 程序 + 抢
## NFQUEUE / 建 dae0 设备」的同一族引擎，同时存在只会互相打架。
## honk 自己的 control.sh check_conflicts 里也点名要排除 dae / daed 进程。
CONFIG_PACKAGE_dae=n
CONFIG_PACKAGE_luci-app-dae=n
CONFIG_PACKAGE_dae-geoip=n
CONFIG_PACKAGE_dae-geosite=n
CONFIG_PACKAGE_daed=n
CONFIG_PACKAGE_luci-app-daed=n
CONFIG_PACKAGE_daed-geoip=n
CONFIG_PACKAGE_daed-geosite=n

## ═══════════════════════════════════════════════════════════
## 二、打开 honk + doona 面板
## ═══════════════════════════════════════════════════════════
## honk 本体。配方在 kenzok8/small（extra-packages 那条路自动带入，
## 这里写上同时作为符号校验的断言目标：符号丢了 = defconfig 把依赖判掉了）。
CONFIG_PACKAGE_honk=y
## LuCI 前端 + doona 静态面板（/usr/share/doona，由 honk 在 :9527/ui/ 提供）。
CONFIG_PACKAGE_luci-app-honk=y

## geo 数据：honk 默认配置里用 geosite:/geoip: 做分流，数据来自 v2ray-geodata
## 那个配方产出的两个子包（与 dae / daed 线同一份）。
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

## curl 不在 honk 的 DEPENDS 里，但 control.sh 的 initialize_preflight 里
## `command -v curl` 是硬检查（缺了直接返回 curl_missing，面板初始化做不下去）。
## common.config 已经 =y，这里重写一遍是为了让它进符号校验的断言集合。
CONFIG_PACKAGE_curl=y

## ── honk 启动自检点名的内核模块（control.sh check_kernel 逐个 modprobe）──
##   sch_ingress      → kmod-sched-core（TC 的 ingress qdisc）
##   cls_bpf          → kmod-sched-bpf（bpf 分类器 / 动作）
##   veth             → kmod-veth（netkit 不可用时 honk 回退到 veth）
##   nft_queue        → kmod-nft-queue（UDP 首包暂存，honk 独占 queue 320）
##   nfnetlink_queue  → kmod-nfnetlink-queue（由 kmod-nft-queue 依赖带出）
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y

## honk 的 init 脚本用 `ip` 建 dae0 / 改 sysctl；busybox 那份 ip 不支持
## honk 用到的全部子命令，配方 DEPENDS 里也点名 +ip-full。
CONFIG_PACKAGE_ip-full=y

## ═══════════════════════════════════════════════════════════
## 三、内核配置（honk 的硬前提，缺一条就"编得出来、跑不起来"）
## ═══════════════════════════════════════════════════════════
## honk 的上游要求（doc/zh/how-to-start.md「内核配置」一节）在 OpenWrt 上的落点：
##   BPF / BPF_SYSCALL / BPF_JIT   generic 配置里已 =y（实测）
##   NET_SCHED / NET_CLS_ACT / NET_XGRESS / NET_NS
##                                 NET_CLS_ACT 由 kmod-sched-bpf 的 KCONFIG 带出，
##                                 NET_XGRESS 在 6.12+ 由它 select
##   NF_TABLES / NFT_QUEUE / NETFILTER_NETLINK_QUEUE
##                                 由 kmod-nft-queue + kmod-nft-core 以模块形式提供
##   CGROUP_BPF                    下面显式打开（cgroup v2 已在 procd 侧挂好）
## 真正需要在这里动手的只有 BTF 那一组与 CGROUP_BPF —— 其余由包依赖带出来。
##
## 为什么 BTF 是硬前提：honk 启动时**总要**加载原始 BTF（加载器目标 BTF +
## 进程名 / 接收追踪的偏移），来源依次是 $HONK_VMLINUX_BTF、
## /sys/kernel/btf/vmlinux、/usr/lib/debug/boot/vmlinux。kenzok8 的配方里
## DEPENDS 直接写了 @KERNEL_DEBUG_INFO_BTF，所以这条符号不成立时包根本不可见。
CONFIG_KERNEL_DEBUG_INFO=y
## 默认 y，而 BTF 明确 `depends on !KERNEL_DEBUG_INFO_REDUCED`（不关就静默丢 BTF）
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
## honk 的 CO-RE 硬前提（ipq807x 默认关闭）
CONFIG_KERNEL_DEBUG_INFO_BTF=y
## fentry/fexit 兜底路径要 BPF events；BTF 那一组的标准配套
CONFIG_KERNEL_BPF_EVENTS=y
## honk 在根 cgroup 上挂 socket 身份 hook 与 TCP sock_ops 程序
## （honk_tcp_passive），没有 CGROUP_BPF 直接拒绝启动。Config-kernel.in 里
## 它 default y，但 ipq807x 的最终 .config 是否真带上不由我们假定 —— 写死。
CONFIG_KERNEL_CGROUP_BPF=y
