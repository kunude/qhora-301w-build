#
# daed 代理栈 —— 第七条线（测试线）：immortalwrt 基座 + NSS 补丁 + daed
#
# 本文件**不单独使用**：scripts/prepare-build.sh 在 PROXY_STACK=daed 时把它拼在
# configs/common.config 与 configs/qhora_301w.config 之后（后拼接的覆盖前者），
# 其余 PROXY_STACK 取值根本不读本文件。
#
# 与第六条线（dae）的唯一区别：代理核心从 dae 换成 daed。
#   dae  = 单二进制 + 配置文件（/etc/dae/config.dae），无状态、无端口
#   daed = dae-wing（Go 服务）+ 内嵌 Web 面板 + SQLite（/etc/daed/wing.db），
#          自己监听 HTTP，能管订阅 / 测节点延迟 / 看流量图
# 两者共用同一批 eBPF 内核前提（BTF / cls_bpf / act_bpf / XDP），所以内核侧
# 配置与 dae 线完全一样，一个字都不用改。
#
# ⚠️ 这条线是**测试线**：先验证 daed 能在 301W 上编出来、跑起来、面板能开，
#    再决定要不要并进出厂选择。所以这里不预置任何 /etc/config/daed 覆盖文件，
#    全部用包自带的默认值（首启由 daed.init + LuCI 初始化）。
#
# ⚠️ "关掉"的行一律写 CONFIG_X=n，不写 `# CONFIG_X is not set` ——
#    原因见 configs/homeproxy.config 头部（prepare-build.sh 按"最后一个赋值"判定，
#    注释行会被过滤掉，于是 common.config 里的 =y 仍会被拿去断言，必然失败）。
#

## ═══════════════════════════════════════════════════════════
## 一、关掉 passwall2 全家（与 dae 线同一套）
## ═══════════════════════════════════════════════════════════
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=n

## passwall2 专属依赖。daed 一个都不用（eBPF 内核态分流 + 自带 DNS 段）。
## 关掉最省的仍是 shadowsocks-rust-sslocal —— 它 PKG_BUILD_DEPENDS:=rust/host，
## 不编它就不用拉 Rust 工具链。
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n

## sing-box 是 common.config 为 passwall2 / homeproxy 选的，daed 不需要。
CONFIG_PACKAGE_sing-box=n

## 本线不装 dae 本体：daed 自带 dae 核心（dae-wing 里嵌的），两个一起装
## 会抢同一份 eBPF 挂载点（clsact qdisc 上的程序只能有一份在跑）。
## 显式写 =n 还兼作断言：产物阶段会反向确认 manifest 里没有 dae。
CONFIG_PACKAGE_dae=n
CONFIG_PACKAGE_luci-app-dae=n
CONFIG_PACKAGE_dae-geoip=n
CONFIG_PACKAGE_dae-geosite=n

## ═══════════════════════════════════════════════════════════
## 二、打开 daed
## ═══════════════════════════════════════════════════════════
##
## daed / daed-geoip / daed-geosite 在 **immortalwrt/packages 官方 feed**
## （feeds/packages/net/daed），luci-app-daed 在 immortalwrt/luci
## （feeds/luci/applications/luci-app-daed）——都是基座自带，
## extra-packages.sh 的 daed 分支一个仓库都不拉。
##
## daed 与 dae 共用三条硬性前提（缺一条就"编得出、刷得进、跑不起来"）：
##   1) 内核 BTF：/sys/kernel/btf/vmlinux（CO-RE）
##   2) tc 的 bpf 分类器/动作（kmod-sched-bpf）+ sch_ingress（kmod-sched-core）
##   3) XDP：kmod-xdp-sockets-diag 的 DEPENDS 是 @KERNEL_XDP_SOCKETS
CONFIG_PACKAGE_daed=y
## geo 数据：daed-geoip / daed-geosite 只是把 /usr/share/v2ray/*.dat 软链到
## /usr/share/daed/ 下，真正的数据在 v2ray-geoip / v2ray-geosite 两个包里。
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

## LuCI 前端：daed 面板的入口页（LUCI_DEPENDS 里写着 +daed +daed-geoip +daed-geosite）
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

## ── eBPF 相关的 kmod（daed 配方 DEPENDS 里已声明，这里显式写出来）──
## 显式写的目的是同时作为符号校验的断言目标，确认内核真按预期开了那几个符号。
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

## ═══════════════════════════════════════════════════════════
## 三、内核配置（BTF / BPF events / XDP）
## ═══════════════════════════════════════════════════════════
## 这几个是 config/Config-kernel.in 里声明过的 KERNEL_ 符号，可以直接写在
## .config 里。daed 与 dae 用的是同一套 CO-RE 前提，所以与 dae.config 完全一致。
CONFIG_KERNEL_DEBUG_INFO=y
## 默认 y，而 BTF 明确 `depends on !KERNEL_DEBUG_INFO_REDUCED`（不关就静默丢 BTF）
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
## daed 的 CO-RE 硬前提（ipq807x 默认关闭）
CONFIG_KERNEL_DEBUG_INFO_BTF=y
## daed 配方注释里点名的另一项
CONFIG_KERNEL_BPF_EVENTS=y
## kmod-xdp-sockets-diag 的 DEPENDS
CONFIG_KERNEL_XDP_SOCKETS=y
