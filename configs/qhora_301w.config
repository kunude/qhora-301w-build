#
# 机型配置 —— QNAP QHora-301W
#
# 在 scripts/prepare-build.sh 里拼接在 configs/common.config 之后，
# 冲突的符号以本文件为准。
#
# 硬件：Qualcomm IPQ8072A（4x Cortex-A53 @2.2GHz）+ 1GB RAM + eMMC，
#       2 个 10GbE（Aquantia AQR113C）+ 4 个 1GbE，三频 Wi-Fi 6。
#
# OpenWrt 中的设备标识：
#   target   : qualcommax
#   subtarget: ipq807x
#   device   : qnap_301w        (image/ipq807x.mk 中的 define Device/qnap_301w)
#   设备树    : ipq8072-301w.dts, DEVICE_DTS_CONFIG = config@hk01
#

## ── 目标 / 子目标 ───────────────────────────────────────────
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y

## ── 机型选择 ────────────────────────────────────────────────
## 现代 OpenWrt 统一用 MULTI_PROFILE + TARGET_DEVICE_<...> 的形式选机型；
## 只勾一个设备，产出的就是且只是 QHora-301W 的镜像。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w=y

## ── 内存档位（编译期写死、整镜像生效，必须与硬件匹配）──────
## QHora-301W 是 1GB RAM，选高档位；选错会按错误的 RAM 容量编译，
## 上机后表现为无线或 NSS 行为异常，且构建过程不会报任何错。
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

## 说明：ipq-wifi-qnap_301w（板级校准固件）、kmod-fs-f2fs、f2fs-tools
## 等由设备定义里的 DEVICE_PACKAGES 自动带入，这里不需要再写。
