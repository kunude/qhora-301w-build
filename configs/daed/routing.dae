routing {
    ### 固定前置，别动 ###
    # 本机网络管理器直连，否则 dae 绑 WAN 做连通性自检会被自己代理掉
    pname(NetworkManager) -> direct
    # 广播/组播/链路本地绝不进代理，否则 LAN 内的发现协议会被打断
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 内网地址直连（NAS、打印机、路由器管理页）
    dip(geoip:private) -> direct

    ### 自定义域名（必须放最前面，命中即止）###
    # 为什么排在这儿：下面的 `dip(geoip:cn)` 是按 IP 判定的，你要是想让一个
    # 解析到国内 IP 的域名走代理，规则排在它后面就永远命不中。所以自定义规则
    # 统一写在拦截/直连之前，从上往下第一条匹配的生效（越具体的写越上面）。
    # 实测对照（2026-10-25，把同一台机上的 myip.ipip.net 强指 proxy）：
    #   放在本段位置            → 走代理 ✅
    #   放在 domain(geosite:cn) 之后 → 仍走直连 ❌（geoip:cn 先按 IP 命中）
    # 上面那三条固定前置（pname / 组播 / 内网）留在前面不影响。
    #
    # 四种写法，按需选一种：
    #   domain(suffix: .your-domain.com)   该域名及其所有子域
    #   domain(full: a.your-domain.com)    只匹配这一个完整域名
    #   domain(keyword: yourbrand)         域名里含这个词（太宽，慎用）
    #   domain(regexp: ^.*\.foo\.com$)     正则
    #   dip(1.2.3.4/32, 10.0.0.0/8)        没有域名的连接只能按 IP/CIDR 写
    #
    # 想让自己的域名**走代理**（走 proxy 组）：
    # domain(suffix: .my-company.com) -> proxy
    # 想让某个域名**强制直连**（比如国内站被误判成国外）：
    # domain(suffix: .my-intranet.example) -> direct
    #
    # 一个限制：域名规则依赖嗅探，HTTP/TLS(SNI) 能抓到；纯 TCP 非 TLS 的私有
    # 协议抓不到域名，只能用 dip() 按 IP 写。QUIC 已被下面的规则统一拦掉，
    # 会在一秒内回落 TCP，不影响判定。

    ### 拦截 ###
    # 广告与追踪
    domain(geosite:category-ads-all) -> block
    # 关掉 QUIC：UDP 443 一旦被节点劣化，表现为"网页能开、视频卡成马赛克"
    # 或"有的站通 Google 不通"。禁掉后浏览器 1 秒内回落 TCP，体验反而更好。
    # 如果你的节点 UDP 很稳、想要 HTTP/3，把下一行注释掉即可。
    l4proto(udp) && dport(443) -> block

    ### 直连 ###
    # 国内 IP 与国内域名。顺序无所谓，两条都留着更保险：
    # 有些站用国外 CDN 的 IP 但属于国内域名，反之亦然。
    dip(geoip:cn) -> direct
    domain(geosite:cn) -> direct
    # 局域网常见域名后缀
    domain(suffix: .lan) -> direct
    domain(suffix: .local) -> direct
    domain(suffix: .home.arpa) -> direct

    ### 其余全部走 proxy（唯一的代理组，组内自动选最优节点）###
    # 只有这一个代理组：把订阅里的节点全丢进去，min_moving_avg 自动挑最快的。
    # 想单独给某个站指定节点时，在面板里再建组并加规则即可。
    fallback: proxy
}
