#
# 代理栈 = passwall（v1，Lua 那套界面）—— 变体覆盖层
#
# 拼接顺序：common.config → qhora_301w.config → **本文件**
# 后拼接者覆盖前者（prepare-build.sh 按「每个符号最后一次赋值」判定）。
#
# 为什么要单独一层：common.config 里写的是 **passwall2** 的符号，而 v1 与 v2
# 的符号集**不通用** ——
#   v1（luci-app-passwall）  Lua CBI + luasrc，依赖 luci-compat / lua / libuci-lua，
#                            配置项是一组扁平的 INCLUDE_XXX；界面在「服务 → PassWall」
#   v2（luci-app-passwall2） ucode/JS，多出 Basic_Core_* 与 Nftables/Iptables
#                            两个顶层开关；界面在「服务 → PassWall2」
# 两者**不能共存**：同一套 nft/iptables 规则、同一个 dnsmasq 劫持点、同一批
# /etc/config/passwall* 命名空间，同时装会互相抢（症状是"能上国内、国外全挂"）。
# 所以下面第一段先把 v2 整组按掉。
#
# ⚠️ 按掉 v2 必须**逐个写 =n**，不能只关前端包：
#   prepare-build.sh 的符号校验按「每个符号最后一次赋值的值」判定，
#   common.config 里的 =y 只要没在本文件被覆盖，就会因为 defconfig 把它丢掉
#   而判红（"配置请求的符号被丢弃"）。none.config 里是同一套写法，理由一致。
#

## ── passwall2 全家（逐个关）────────────────────────────────────
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n

## ── passwall v1 ──────────────────────────────────────────────
## 来源：Openwrt-Passwall/openwrt-passwall（仓库根下就一个 luci-app-passwall，
## 由 extra-packages.sh 浅克隆后落进 feeds/luci/applications/）。
## 依赖组件仍来自 openwrt-passwall-packages —— v1 与 v2 共用那一份。
## 中文翻译由 luci.mk 从包内 po/zh_Hans 生成，包名照例是 luci-i18n-passwall-zh-cn。
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

## 透明代理走哪套。基座是 firewall4（nftables），所以只开 nftables 那支 ——
## 与 passwall2 线同一个理由。这一支 select 进来的是：
##   ipt2socks、nftables、kmod-nft-socket、kmod-nft-tproxy、kmod-nft-nat、
##   kmod-nf-reject、kmod-nf-reject6
## iptables 那支的默认值本身就是 `default y if !PACKAGE_firewall4`，
## 这里显式写出来，是为了把"不要 iptables"变成可断言的意图。
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=n

## 组件开关。默认值取上游对 aarch64 的那一套，逐条写出来是为了
## ① 把意图写清楚，② 让 prepare-build.sh 的符号校验替我们确认这些配方
## 真的落位、真的被 feeds 索引扫到（少一条会在十几分钟内失败，而不是等
## 两个小时才发现镜像里缺组件）。
##
## ⚠️ 与 passwall2 线**故意不同**的一处：这里 **Xray=y**。
##    passwall2 线只留 sing-box（省 20MB，因为 v2 的分流由 sing-box route.rules
##    全权负责）。但 v1 的核心是**按节点选**的，社区里绝大多数 v1 配置是 Xray
##    节点；不编 xray-core 的话，从旧固件恢复过来的配置会"编得出来、刷得进去、
##    节点起不来"，而且运行日志只报一句 core not found。
##    Xray 默认就是 aarch64 的 y，这里只是把默认值落成显式配置。
##    想省空间就把下面那行改 n（sing-box 覆盖 SS/VMess/VLESS/Trojan/Hysteria2）。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
## geo 数据：common.config 里 v2ray-geoip / v2ray-geosite 已经是 =y（passwall2 线
## 需要）。这里把 v1 的开关也对齐成 y —— 否则界面上的开关关着、数据却已经装进
## 固件，看起来像"没生效"。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y

## 关掉的可选项（上游默认也大多是 n，写出来是为了显式 + 可断言）：
##   SmartDNS       上游对 aarch64 默认 **y**，这里故意关掉：它是第二个 DNS
##                  服务，装进固件后只要被误开就会和 dnsmasq + chinadns-ng 抢 53，
##                  症状是整机 DNS 全挂。需要时 opkg install smartdns 即可（纯用户态）。
##   Hysteria       走 sing-box 的 hysteria2 出站已经够用，单独装 hysteria 是重复。
##   NaiveProxy     纯 ARM 端口，体积大，需要的人自己装。
##   Shadow_TLS     配方带 Rust 依赖，且属于 SIP003 插件，可选。
##   SS-Rust_Server 服务端用不上（本机是客户端角色）。
##   Xray_Plugin    Xray 的 SIP003 插件，可选。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n

## 断言目标：Xray 那支会 select 它，缺了说明 INCLUDE_Xray 没生效。
CONFIG_PACKAGE_xray-core=y
