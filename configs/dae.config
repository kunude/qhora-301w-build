#
# dae 代理栈 —— 第六条线：immortalwrt 基座 + NSS 补丁 + dae（替代 HomeProxy）
#
# 本文件**不单独使用**：scripts/prepare-build.sh 在 PROXY_STACK=dae 时把它拼在
# configs/common.config 与 configs/qhora_301w.config 之后（后拼接的覆盖前者），
# 其余 PROXY_STACK 取值根本不读本文件 —— 已有五条线的行为完全不变。
#
# 与 homeproxy.config 的关系：换掉的东西同样只是"代理栈"这一块，
#   common.config 里的 passwall2（luci-app-passwall2 + 17 个组件）
#     ↓
#   dae + luci-app-dae（dae 直接来自 immortalwrt/packages，无需引入第三方 feed）
# 其余一切原样不动：NSS 卸载栈、ddns-go、msd_lite、WireGuard、
# luci-app-statistics、autocore、files/ 覆盖、target/subtarget/device。
#
# ⚠️ "关掉"的行一律写 CONFIG_X=n，不写 `# CONFIG_X is not set` ——
#    原因见 configs/homeproxy.config 头部（prepare-build.sh 按"最后一个赋值"判定，
#    注释行会被过滤掉，于是 common.config 里的 =y 仍会被拿去断言，必然失败）。
#

## ═══════════════════════════════════════════════════════════
## 一、关掉 passwall2 全家（与 homeproxy 线同一套）
## ═══════════════════════════════════════════════════════════
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=n

## passwall2 专属依赖。dae 一个都不用：
## 分流由内核态 eBPF 完成，DNS 由它自己的 dns 段接管，
## 不需要 chinadns-ng / geoview / tcping，也不需要任何一个协议实现进程。
## 关掉最省的是 shadowsocks-rust-sslocal —— 它 PKG_BUILD_DEPENDS:=rust/host，
## 不编它就不用拉 Rust 工具链（通常省 15~25 分钟构建时间）。
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n

## sing-box 是 common.config 为 passwall2 / homeproxy 选的。
## dae 自带全部协议实现（Go 静态编译成单个二进制），不需要它，
## 关掉可以省掉一个 10MB+ 的核心包。
CONFIG_PACKAGE_sing-box=n

## ═══════════════════════════════════════════════════════════
## 二、打开 dae
## ═══════════════════════════════════════════════════════════
##
## dae 与 daed / luci-app-dae 都在 **immortalwrt/packages 与 immortalwrt/luci
## 官方 feed 里**（feeds/packages/net/dae、feeds/luci/applications/luci-app-dae），
## 所以这条线不需要 scripts/extra-packages.sh 落位任何第三方仓库 ——
## 见该脚本的 ③ 段（PROXY_STACK=dae 分支什么都不拉）。
##
## dae 是 eBPF（CO-RE）实现：流量在内核态分流，不建 conntrack、不起 TPROXY 循环，
## 直连流量几乎零开销 —— 这是它与 sing-box / passwall2 最本质的区别。
## 代价是三条硬性前提，缺一条就起不来（而且**编得出来、刷得进去、跑不起来**）：
##
##   1) 内核 BTF：/sys/kernel/btf/vmlinux 必须存在。
##      immortalwrt 的 generic 内核配置里是 `# CONFIG_DEBUG_INFO_BTF is not set`
##      （实测 192.168.35.1 上就没有这个文件），必须显式打开。
##      它依赖 KERNEL_DEBUG_INFO=y 且 KERNEL_DEBUG_INFO_REDUCED=n，
##      并会 select DWARVES（host 侧的 pahole，tools/dwarves 已在源码树里）。
##   2) tc 的 bpf 分类器 / 动作：CONFIG_NET_CLS_BPF / CONFIG_NET_ACT_BPF，
##      由 kmod-sched-bpf 的 KCONFIG 带出来；sch_ingress 由 kmod-sched-core 带。
##      通用配置里这三项原本都是 not set（同样是实测确认过的）。
##   3) XDP：kmod-xdp-sockets-diag 的 DEPENDS 是 @KERNEL_XDP_SOCKETS，
##      不打开这个内核符号，那个包在 menuconfig 里根本不可见。
##
## 注：BTF 会让 vmlinux 多出几 MB 的 .BTF 段，本机型 KERNEL_SIZE=16384k，
## 构建期由 scripts/prepare-build.sh 的符号校验 + 产物校验两道关兜着。
CONFIG_PACKAGE_dae=y
## 国内分流用的 geo 数据。dae-geoip / dae-geosite 只是把
## /usr/share/v2ray/{geoip,geosite}.dat 软链到 /usr/share/dae/ 下，
## 真正的数据在这两个包里（它们由 v2ray-geodata 一个配方产出两个子包）。
## ⚠️ homeproxy.config 里这两个是 =n（它不用），本线必须 =y，别照抄。
CONFIG_PACKAGE_dae-geoip=y
CONFIG_PACKAGE_dae-geosite=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

## LuCI 前端：设置页（启动/停止、日志级别）、配置编辑页、日志页。
## 它 LUCI_DEPENDS 里写着 +dae +dae-geoip +dae-geosite，三个都在。
CONFIG_PACKAGE_luci-app-dae=y
## 由 CONFIG_LUCI_LANG_zh_Hans=y 带出来（原理见 common.config 的 LuCI 中文那段），
## 写在这里同时作为符号校验的断言目标。
CONFIG_PACKAGE_luci-i18n-dae-zh-cn=y

## ── eBPF 相关的 kmod（dae 配方 DEPENDS 里已声明，这里显式写出来）──
## 显式写的目的不只是"选中"：它们同时是符号校验的断言目标，
## 能替我们确认"内核真的按预期开了那几个符号"，而不是悄悄退回默认值。
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

## ═══════════════════════════════════════════════════════════
## 三、内核配置（BTF / BPF events / XDP）
## ═══════════════════════════════════════════════════════════
## 这几个是 config/Config-kernel.in 里声明过的 KERNEL_ 符号，
## 可以直接写在 .config 里（已逐个核对过声明位置，不会被 defconfig 丢弃）：
##   KERNEL_DEBUG_INFO            559 行
##   KERNEL_DEBUG_INFO_BTF        566 行
##   KERNEL_DEBUG_INFO_REDUCED    594 行
##   KERNEL_BPF_EVENTS            675 行
##   KERNEL_XDP_SOCKETS          1387 行
CONFIG_KERNEL_DEBUG_INFO=y
## 默认 y（除少数 BUILDBOT 目标），而 BTF 明确 `depends on !KERNEL_DEBUG_INFO_REDUCED`。
## 不显式关掉，KERNEL_DEBUG_INFO_BTF 会被静默丢弃。
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
## dae 的 CO-RE 硬前提。默认只对 x86_64 / armsr 等少数目标开，ipq807x 默认关闭。
CONFIG_KERNEL_DEBUG_INFO_BTF=y
## dae 配方注释里点名的另一项（"You need enable KERNEL_DEBUG_INFO_BTF and KERNEL_BPF_EVENTS"）。
CONFIG_KERNEL_BPF_EVENTS=y
## kmod-xdp-sockets-diag 的 DEPENDS 是 @KERNEL_XDP_SOCKETS。
CONFIG_KERNEL_XDP_SOCKETS=y
